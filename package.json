{
  "name": "fit",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "type-check": "turbo run type-check",
    "fit": "tsx tools/cli/src/index.ts",
    "check:env-example": "tsx scripts/check-env-example.ts",
    "check:controller-guards": "tsx scripts/check-controller-guards.ts",
    "db:generate": "pnpm --filter @fit/db db:generate",
    "db:migrate": "pnpm --filter @fit/db db:migrate",
    "db:migrate:dev": "pnpm --filter @fit/db db:migrate:dev",
    "db:studio": "pnpm --filter @fit/db db:studio",
    "db:status": "pnpm --filter @fit/db db:status",
    "db:generate-instances": "pnpm --filter @fit/db jobs:generate-instances",
    "db:expire-credit-packs": "pnpm --filter @fit/db jobs:expire-credit-packs",
    "mobile:start": "pnpm --filter @fit/mobile start",
    "mobile:build:preview": "pnpm --filter @fit/mobile build:preview",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}\"",
    "clean": "turbo run clean && rm -rf node_modules",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts}": [
      "eslint --max-warnings 0",
      "prettier --check"
    ],
    "*.{js,mjs,cjs,json,md,yml,yaml,css}": [
      "prettier --check"
    ]
  },
  "devDependencies": {
    "@fit/config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
