{
  // Extends the shared strict base, then adds what the React Native components
  // need: the automatic JSX runtime and the `nativewind/types` reference (via
  // the included `nativewind-env.d.ts`) so `className` type-checks on RN
  // primitives. Mirrors how `@fit/ui-web` type-checks its components.
  "extends": "@fit/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["node_modules", "dist", "build", ".next", ".expo", ".turbo", "coverage"]
}
