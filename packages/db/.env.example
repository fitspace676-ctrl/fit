# @fit/db environment — copy to `.env` and fill in. `.env` is gitignored.
#
# Prisma (migrate / studio / generate) reads DATABASE_URL from this file.

# Postgres connection string.
#   • Production: Railway Postgres "public" proxy URL
#     (Railway dashboard → Postgres service → Variables → DATABASE_PUBLIC_URL).
#   • Local offline dev: the docker-compose service at the repo root.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit?schema=public"

# Redis connection string (consumed by the API in later tasks).
#   • Production: Railway Redis "public" proxy URL (REDIS_PUBLIC_URL).
#   • Local offline dev: the docker-compose service at the repo root.
REDIS_URL="redis://localhost:6379"
