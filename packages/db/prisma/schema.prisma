// Prisma schema for @fit/db.
//
// T2.1 — the auth / multi-tenancy core. A `User` is a single auth identity
// (email/password + OAuth). Gym-scoped roles live on `GymMember`, the join
// between `User` and `Gym`, so one user can belong to many gyms with a
// different role in each. `RefreshToken` backs rotating session refresh.
// Domain models (workouts, billing, …) hang off these and land in later tasks.
//
// Connection strings come from the environment (see packages/db/.env.example):
//   DATABASE_URL — Postgres (Railway in prod, docker-compose for local dev)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles a user can hold. SUPER_ADMIN is the only platform-wide role (not tied
/// to a single gym); the rest gate permissions within one GymMember.
enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  TRAINER
  MEMBER
}

/// Lifecycle of a user's membership in a gym.
enum GymMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// What a person currently *is* to the gym, as the front desk would describe them.
///
/// Deliberately separate from {@link GymMemberStatus} (the account's own state —
/// invited, suspended) and from {@link SubscriptionStatus} (the billing truth).
/// Those two answer "what is this record?" and "what is being charged?"; this
/// answers "who is this person to us?", which is the question the roster is
/// actually read to settle.
///
/// Normally derived rather than stored: someone holding a live subscription is a
/// `MEMBER`, someone who never held one is a `GUEST` (a drop-in, a free trial
/// session, a walk-in who bought a drink), and someone whose subscription has
/// lapsed is `INACTIVE`. `GymMember.kindOverride` exists for the cases the rules
/// cannot know about — a lifetime member who is never billed, say.
enum MemberKind {
  MEMBER
  GUEST
  INACTIVE
}

/// A member's recorded gender on their staff-managed profile (T4.x). Kept small —
/// the gym serves a single region and staff pick from a short list; the column is
/// nullable when not recorded. Mirrors `genderSchema` in `@fit/types`.
enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Completion state of a member follow-up task (T4.x) — a to-do a staff member
/// logged against a member (call back, chase payment, …). Mirrors
/// `memberTaskStatusSchema` in `@fit/types`.
enum MemberTaskStatus {
  PENDING
  DONE
}

/// How a member's gym check-in (reception arrival) was recorded (T4.12). `QR` is
/// a scanned member code at the reception kiosk; `MANUAL` is a receptionist
/// looking the member up and checking them in by hand. Mirrors the Prisma enum
/// `checkInMethodSchema` in `@fit/types`.
enum CheckInMethod {
  QR
  MANUAL
}

/// Platform-level lifecycle of a whole gym (tenant). A `SUSPENDED` gym is gated
/// at login/refresh so its staff + members can no longer obtain a session, and
/// is toggled from the SuperAdmin console (T2.12). Distinct from
/// {@link GymMemberStatus}, which is a single user's standing within one gym.
enum GymStatus {
  ACTIVE
  SUSPENDED
}

/// Lifecycle of a trainer profile within a gym (T4.4). `ACTIVE` trainers are the
/// gym's current roster (and the ones the public trainers index surfaces);
/// `INACTIVE` is the soft-deactivated state — hidden from the roster but retained
/// so the record and any links to it survive. Toggled from the staff console,
/// mirroring {@link GymMemberStatus} for members.
enum TrainerStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a location (branch) within a gym (T4.5). `ACTIVE` locations are
/// the gym's bookable branches (and the ones the public locations listing the
/// purchase wizard browses surfaces); `INACTIVE` is the soft-deactivated state —
/// hidden but retained so the record and any links to it survive. Toggled from
/// the staff console, mirroring {@link TrainerStatus} for trainers.
enum LocationStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a retail product within a gym (T4.6). `ACTIVE` products are the
/// ones the gym currently sells (and the only state a storefront would surface);
/// `INACTIVE` is the soft-deactivated state — hidden but retained so the record
/// and any links to it survive. Toggled from the staff console, mirroring
/// {@link LocationStatus} for locations.
enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a personal-training package plan within a gym (T4.11). `ACTIVE`
/// plans are the ones the gym currently sells (the only state a storefront would
/// surface); `INACTIVE` is the soft-deactivated state — hidden but retained so
/// the record and any links to it survive. Toggled from the staff console,
/// mirroring {@link ProductStatus} for products.
enum PackagePlanStatus {
  ACTIVE
  INACTIVE
}

/// How a personal-training package plan is billed (T4.11). `MONTH`/`YEAR` are
/// recurring memberships; `ONE_TIME` is a single charge (a session pack or a day
/// pass). The admin form and the storefront card surface a per-interval suffix
/// for recurring plans and none for one-off purchases.
enum PackageBillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

/// Lifecycle of a member's purchased {@link CreditPack} (T8.5). `ACTIVE` is a pack
/// the member can still draw class credits from; `EXPIRED` is one whose `expiresAt`
/// has passed — the daily expiry job (`expire-credit-packs`) flips it, and the
/// booking deduction only ever consumes `ACTIVE` packs. A fully-drawn pack stays
/// `ACTIVE` (its `remainingCredits` is simply `0`), since the deduction filters on
/// `remainingCredits > 0` rather than the status. Deliberately distinct from
/// {@link PackagePlanStatus}, which is the *catalogue* plan's lifecycle, not a
/// purchased pack's.
enum CreditPackStatus {
  ACTIVE
  EXPIRED
}

/// Lifecycle of a recurring class template (T5.1). `ACTIVE` templates are the
/// ones the instance-generation job (T5.3) materialises occurrences from;
/// `PAUSED` keeps the definition but stops generating new instances (existing
/// instances are untouched). Toggled from the class-scheduling console (T5.2).
/// Distinct from {@link InstanceStatus}, the per-occurrence lifecycle.
enum ClassTemplateStatus {
  ACTIVE
  PAUSED
}

/// Lifecycle of a {@link ClassType} catalogue entry. `ACTIVE` types are offered
/// when scheduling; `INACTIVE` soft-retires a type (hidden from the scheduler)
/// without deleting its past occurrences.
enum ClassTypeStatus {
  ACTIVE
  INACTIVE
}

/// How a class template is priced to members (parity with the reference admin's
/// class-type pricing). `FREE` is open to any active member; `INCLUDED` is
/// covered by the subscription plans listed in `includedPlanIds`; `PAID` charges
/// `priceMinor` per session. Personal-training templates additionally carry the
/// `pt30/45/60Minor` per-duration rates.
enum ClassPricingRule {
  FREE
  INCLUDED
  PAID
}

/// Lifecycle of a single materialised class occurrence (T5.1). `SCHEDULED` is a
/// bookable future occurrence; `CANCELED` was called off (its seats released);
/// `COMPLETED` is in the past and attendance-tracked. The instance-generation
/// job only ever creates `SCHEDULED` rows; the other states are transitions
/// applied later by the scheduling / attendance flows.
enum InstanceStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

/// Lifecycle of a member's booking against a class occurrence (T5.1). `BOOKED`
/// holds a confirmed seat; `WAITLIST` is queued (ordered by `waitlistPosition`)
/// for a freed seat; `ATTENDED`/`NO_SHOW` are post-class attendance outcomes;
/// `CANCELED` released the seat. The partial unique index on
/// (classInstanceId, memberId) excludes `CANCELED`, so a member holds at most
/// one live booking per occurrence yet can re-book after cancelling.
enum BookingStatus {
  BOOKED
  WAITLIST
  ATTENDED
  NO_SHOW
  CANCELED
}

/// Moderation state of a member {@link Review} (T5.12). A review is `VISIBLE` the
/// moment it is posted; a manager can soft-moderate an abusive one to `HIDDEN`
/// (never editing its content). Only `VISIBLE` reviews count toward a trainer's
/// public aggregate rating, so hiding one recomputes (and lowers) that average.
enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// The OS of a registered push-notification device (T6.10). Mirrors the wire
/// `DevicePlatformValue` (`ios` / `android`) in `@fit/types`; the API maps the
/// lowercase wire value to this enum on the way in.
enum DevicePlatform {
  IOS
  ANDROID
}

/// Category of an in-app inbox notification (T6.10 / Phase 8). Drives the icon
/// and grouping the member portal renders for each {@link Notification}.
/// Uppercase both sides — the wire `notificationCategorySchema` in `@fit/types`
/// mirrors these values exactly, so no boundary mapping is needed (unlike the
/// lowercase `DevicePlatform`).
enum NotificationCategory {
  BOOKING
  BILLING
  SYSTEM
}

/// A delivery channel the notification dispatch pipeline can fan a message out
/// to (Phase 8, T8.1). `IN_APP` persists a {@link Notification} inbox row (the
/// portal bell, live today); `EMAIL` and `PUSH` are the transactional-email
/// (T8.2) and Expo-push (T8.3) channels that hang off the same dispatch seam.
/// Also the axis a member's {@link NotificationPreference} opt-outs are keyed on,
/// so a member can mute one channel of a category while keeping the others.
enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// Lifecycle of a storefront {@link Order} (T7.1). `PENDING` is the freshly
/// created, not-yet-paid order the purchase wizard opens; `PAID` is the terminal
/// "payment captured" state the success page confirms; `CANCELLED` is an
/// abandoned / failed attempt; `REFUNDED` is a previously `PAID` order whose
/// payment has been reversed in full from the admin order management console
/// (T7.9). Mirrors the lowercase wire `orderStatusSchema` (`pending` / `paid` /
/// `cancelled` / `refunded`) in `@fit/types`; the API maps between the two on the
/// boundary, the same way {@link DevicePlatform} mirrors its wire enum.
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

/// How a storefront {@link Order} is fulfilled (T7.10). `PICKUP` is collected by
/// the buyer at the gym's {@link Location} branch (`locationId`); `DELIVERY` is
/// sent to the buyer's `deliveryAddress` by the gym's own in-house courier. The
/// checkout requires the matching detail for the chosen mode. Mirrors the wire
/// `fulfillmentSchema` (`PICKUP` / `DELIVERY`) in `@fit/types` — uppercase both
/// sides, so no boundary mapping is needed (unlike the lowercase wire enums).
enum Fulfillment {
  PICKUP
  DELIVERY
}

/// Lifecycle of a {@link Payment} attempt against an order (T7.1). `PENDING` is a
/// freshly created charge awaiting capture; `CAPTURED` is settled money (the
/// transition that flips its order to `PAID`); `FAILED` is a declined / errored
/// attempt; `REFUNDED` is a previously captured charge reversed. The MVP only
/// ever creates `CAPTURED` rows via the payment stub (see `@fit/types` orders);
/// the other states exist for the real provider integration (T8.8).
enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

/// How a sale was settled (T7.3 / T7.5) — the staff-facing settlement channel the
/// POS operator chose. `CASH` is tendered at the desk, `CARD` a terminal / online
/// card charge, `MEMBER_ACCOUNT` a charge to the member's house account. This is
/// deliberately separate from a {@link Payment} `provider` (the gateway key, e.g.
/// `"pos"` / `"stub"`): a `CARD` sale may flow through any provider, and `CASH` /
/// `MEMBER_ACCOUNT` never touch one. It is the dimension the end-of-day cash
/// reconciliation (T7.5) groups the day's takings by. Mirrors the `paymentMethod`
/// wire enum in `@fit/types` (lower-snake there, UPPER here as Prisma enums are).
enum PaymentMethod {
  CASH
  CARD
  MEMBER_ACCOUNT
}

/// Lifecycle of a recurring membership {@link SubscriptionPlan} within a gym
/// (T8.1). `ACTIVE` plans are the ones the gym currently offers (the only state a
/// storefront / member portal would surface); `INACTIVE` is the soft-deactivated
/// state — hidden but retained so the record and any {@link Subscription} linked to
/// it survive. Toggled from the staff console, mirroring {@link PackagePlanStatus}
/// for the one-off PT package plans.
enum SubscriptionPlanStatus {
  ACTIVE
  INACTIVE
}

/// Renewal cadence of a recurring membership {@link SubscriptionPlan} (T8.1).
/// `MONTH`/`YEAR` are the periods a {@link Subscription}'s `currentPeriodEnd`
/// advances by on each successful charge. Deliberately distinct from
/// {@link PackageBillingInterval}, which additionally carries `ONE_TIME` — a one-off
/// charge has no place on a *recurring* subscription, so the two enums are kept
/// separate rather than sharing one with a member that is invalid here.
enum SubscriptionInterval {
  MONTH
  YEAR
}

/// Lifecycle of a member's {@link Subscription} to a recurring plan (T8.1, state
/// machine T8.3). `TRIAL` is a free introductory period on a plan with `trialDays > 0`
/// (T5.6): the member is entitled and holds the live slot but has not been charged
/// yet — the first renewal charge at trial end auto-converts it to `ACTIVE` (or
/// `PAST_DUE` if that charge fails), and a cancellation during the trial charges
/// nothing. `ACTIVE` is a current, paid-up subscription; `PAST_DUE` is one
/// whose latest renewal charge failed and is in its grace window (still entitled,
/// pending a retry); `FROZEN` is a deliberately paused membership (a member- or
/// staff-requested hold — common for gyms) that still occupies the member's single
/// live slot but grants no access until resumed; `CANCELED` was ended by the member
/// or staff (immediately, or once the `cancelAtPeriodEnd` flag let the paid period
/// run out); `EXPIRED` lapsed at the end of its period without renewing. The legal
/// transitions between these states — and the guards that reject illegal ones — are
/// the T8.3 state machine (`subscription-state-machine.ts`, re-exported from
/// `@fit/db`); the recurring-billing job (a later T8 task) drives the
/// TRIAL/PAST_DUE/EXPIRED transitions by applying those events.
enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  FROZEN
  CANCELED
  EXPIRED
}

/// Settlement state of an {@link Invoice} (T5.9). An invoice is minted the moment a
/// subscription charge is taken, so the common case is `PAID` (the enrolment /
/// renewal / POS charge settled). `PENDING` is a charge awaiting confirmation, `FAILED`
/// a charge that was declined, and `REFUNDED` an invoice whose payment was later
/// returned. The values mirror the member-facing `MeInvoice` wire status in `@fit/types`
/// so `GET /me/subscription` surfaces them without translation.
enum InvoiceStatus {
  PAID
  PENDING
  FAILED
  REFUNDED
}

/// What an {@link Invoice} was raised *for* — the billed category, surfaced as a badge
/// on the admin invoice board and selectable when staff raise one by hand. Distinct
/// from *how* the invoice arose (which `subscriptionId` / `orderId` already record):
/// a manually issued membership invoice and an automatic renewal are both
/// `MEMBERSHIP`. `OTHER` is the fallback for anything the enum doesn't name.
enum InvoiceType {
  MEMBERSHIP
  PERSONAL_TRAINING
  CLASS
  PRODUCT
  SERVICE
  OTHER
}

/// What kind of service a {@link Service} is. A `PERSONAL_TRAINING` service is bound
/// to a staff member who has a trainer profile and takes its name from them; a
/// `CUSTOM` service (a massage, a body-composition test) is named by staff.
enum ServiceType {
  PERSONAL_TRAINING
  CUSTOM
}

/// A service is archived, never deleted: sales and (stage 2) sessions keep their history.
enum ServiceStatus {
  ACTIVE
  ARCHIVED
}

/// A {@link ServiceSession}'s lifecycle: an OPEN slot any member may book, BOOKED
/// once a member holds it (an invoice is raised at that moment), COMPLETED after it
/// ran, CANCELLED by staff (the row stays for history).
enum ServiceSessionStatus {
  OPEN
  BOOKED
  COMPLETED
  CANCELLED
}

/// A physical gym / tenant. The top-level entity most other records hang off.
/// `ownerId` references the owning User (set during provisioning, T2.11); kept
/// as a plain scalar to avoid a second User↔Gym relation alongside GymMember.
model Gym {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  ownerId         String?
  /// The user who provisioned the gym (T2.11). Equals `ownerId` for owner
  /// self-signup, but distinct when a SUPER_ADMIN creates a gym on an owner's
  /// behalf. Nullable for rows that predate the column (seed/legacy).
  createdByUserId String?
  status          GymStatus @default(ACTIVE)
  /// Gym settings (T4.8): brand (logo + colours), locale (language, currency,
  /// timezone), default business hours, and notification sender. Stored as a
  /// single JSON blob validated by `gymSettingsStoredSchema` in `@fit/types`;
  /// the gym's display name stays on `name` (the single source of truth) and is
  /// surfaced as `brand.name`. Null until the owner first saves settings.
  settings        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members                 GymMember[]
  trainers                Trainer[]
  locations               Location[]
  locationStaff           LocationStaff[]
  products                Product[]
  productStock            ProductStock[]
  services                Service[]
  serviceSessions         ServiceSession[]
  productCategories       ProductCategory[]
  packagePlans            PackagePlan[]
  staffInvites            StaffInvite[]
  classTemplates          ClassTemplate[]
  classTypes              ClassType[]
  classInstances          ClassInstance[]
  ptSessions              PtSession[]
  bookings                Booking[]
  reviews                 Review[]
  orders                  Order[]
  payments                Payment[]
  refunds                 Refund[]
  carts                   Cart[]
  subscriptionPlans       SubscriptionPlan[]
  subscriptions           Subscription[]
  creditPacks             CreditPack[]
  memberGoals             MemberGoal[]
  memberNotes             MemberNote[]
  memberTasks             MemberTask[]
  checkIns                CheckIn[]
  invoices                Invoice[]
  invoiceSequences        InvoiceSequence[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  leads                   Lead[]
  opportunities           Opportunity[]
  crmActivities           CrmActivity[]
  crmTasks                CrmTask[]
  automationRules         AutomationRule[]
  automationRuns          AutomationRun[]
  campaigns               Campaign[]
  promoCodes              PromoCode[]
  audienceSegments        AudienceSegment[]
  messageTemplates        MessageTemplate[]
  loyaltyProgram          LoyaltyProgram?
  loyaltyLedger           LoyaltyLedgerEntry[]
  loyaltyRewards          LoyaltyReward[]
  loyaltyRedemptions      LoyaltyRedemption[]
  dashboardWidgets        DashboardWidget[]
  agentChatSessions       AgentChatSession[]
  staffNotes              StaffNote[]
  staffTasks              StaffTask[]
  timeOffRequests         TimeOffRequest[]
  shiftSlots              ShiftSlot[]

  @@index([ownerId])
  @@map("gyms")
}

/// An application user. Holds the auth identity (password hash + OAuth subject
/// ids). Gym-scoped roles live on GymMember, not here, so a user can belong to
/// N gyms with a different role in each.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// Optional contact phone, captured/edited from the staff console member
  /// management (T4.3). A user attribute (alongside name/email) rather than a
  /// per-gym one, so it travels with the person across the gyms they belong to.
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  googleId        String?   @unique
  appleId         String?   @unique
  /// Platform-wide SUPER_ADMIN flag. SUPER_ADMIN is *not* a gym-scoped role, so
  /// it lives on the user rather than as a GymMember row: a flagged user's
  /// session resolves to `role = SUPER_ADMIN` with no gym (`gymId = null`).
  /// Bootstrapped via `fit admin grant` (and the dev seed); never set by signup.
  isSuperAdmin    Boolean   @default(false)
  /// Monotonic session-invalidation counter. Stamped into every access token's
  /// `tokenVersion` claim at issuance; bumping it (e.g. on a forced global
  /// logout / credential change) lets all outstanding sessions be invalidated
  /// at the next refresh without tracking each access token individually.
  /// @counter
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             GymMember[]
  refreshTokens           RefreshToken[]
  pushTokens              PushToken[]
  carts                   Cart[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  assignedLeads           Lead[]                   @relation("LeadAssignedTo")
  assignedOpportunities   Opportunity[]            @relation("OpportunityAssignedTo")
  crmActivities           CrmActivity[]
  automationRules         AutomationRule[]         @relation("AutomationRuleCreatedBy")
  campaigns               Campaign[]               @relation("CampaignCreatedBy")
  agentChatSessions       AgentChatSession[]

  @@map("users")
}

/// A registered device for Expo push delivery (T6.10). One row per
/// (user, device): the member app registers its Expo push `token` on login and
/// re-registers when the token rotates (app upgrade), keyed by a stable
/// `deviceId` so a rotation updates in place rather than accumulating rows. Not
/// gym-scoped — a push token belongs to the *person*, independent of which gyms
/// they are a member of — so it hangs off User (cascade-deleted with the user)
/// rather than GymMember, and the registration endpoints resolve the owner from
/// the session. Logout (and an unregister) deletes the row.
model PushToken {
  id        String         @id @default(cuid())
  userId    String
  /// Stable per-install device id minted on the client and persisted there; the
  /// `(userId, deviceId)` upsert key.
  deviceId  String
  /// The Expo push token (`ExponentPushToken[…]`) delivery targets.
  token     String
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("push_tokens")
}

/// A member's in-app inbox notification (T6.10 / Phase 8). One row per delivered
/// in-app message — a booking confirmation, a billing event, or a system notice.
/// Gym-scoped (`gymId`) and owned by the recipient `User`, so a member sees only
/// their own gym's notifications; cascade-deleted with either. Like `CheckIn` it
/// carries an explicit `gymId` rather than joining `GymMember`, and (like
/// `PushToken`) keys the recipient by `userId` — so `NotificationDispatchService`
/// can address any (gym, user) recipient without a membership lookup. Deliberately
/// NOT in the tenant extension's auto-scope set: the service passes `gymId`
/// explicitly (reads filter on it, the dispatcher stamps it), which also lets it
/// run outside a request's tenant scope for future reminder/billing jobs
/// (T8.6/T8.7). `readAt` is null until the member opens the item; append-only
/// otherwise.
model Notification {
  id        String               @id @default(cuid())
  gymId     String
  userId    String
  category  NotificationCategory
  title     String
  body      String
  /// Optional in-app deep-link the portal routes to when the item is tapped
  /// (e.g. `/bookings`). Null for a plain informational notice.
  href      String?
  /// Optional idempotency key for dedupe (T8.1). When a producer supplies one,
  /// `NotificationService.send` skips a second delivery with the same
  /// `(userId, dedupeKey)` rather than notifying twice — e.g. a booking-reminder
  /// job that reruns, or a retried billing webhook, must not double-notify. The
  /// partial unique on `(userId, dedupeKey)` makes the guarantee race-safe (two
  /// concurrent sends collide on the insert); null for one-off notices that need
  /// no dedupe, and Postgres treats distinct nulls as non-conflicting so those
  /// coexist freely.
  dedupeKey String?
  /// When the member first opened the item; null while unread.
  readAt    DateTime?
  createdAt DateTime             @default(now())

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency guard for dedupe — non-null keys are unique per recipient; the
  // many null keys of ordinary notices are exempt (Postgres nulls are distinct).
  @@unique([userId, dedupeKey])
  // Backs the inbox list (newest-first) and the unread-count query, both keyed
  // by (gym, user).
  @@index([gymId, userId, createdAt])
  @@index([gymId, userId, readAt])
  @@map("notifications")
}

/// A member's per-category, per-channel notification opt-out (Phase 8, T8.1).
/// The dispatch pipeline is **opt-out**: the absence of a row means the
/// `(category, channel)` pair is enabled, so a member who never touches their
/// settings receives everything. A row with `enabled = false` mutes exactly one
/// `(category, channel)` for that member in that gym — muting BILLING email while
/// keeping BILLING in-app, say. Preferences are per-gym (a member of two gyms can
/// opt out in one only), so — like the {@link Notification} rows they gate — the
/// row carries an explicit `gymId` and `NotificationService` resolves them by
/// `(userId, gymId, category)`. Cascade-deleted with either the user or the gym.
model NotificationPreference {
  id        String               @id @default(cuid())
  gymId     String
  userId    String
  category  NotificationCategory
  channel   NotificationChannel
  /// Whether the member receives this `(category, channel)`. A row exists only
  /// once the member has expressed a choice; `false` is a mute. Defaults to
  /// `true` so an explicitly-created "on" row reads naturally.
  enabled   Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One preference row per (member, gym, category, channel); the resolver loads
  // a member's rows for a gym+category to subtract muted channels from a send.
  @@unique([gymId, userId, category, channel])
  @@index([gymId, userId])
  @@map("notification_preferences")
}

/// Join table between User and Gym carrying the user's role and status within
/// that gym. The composite unique on (userId, gymId) enforces one membership
/// per user per gym while still allowing N gyms per user.
model GymMember {
  id       String          @id @default(cuid())
  userId   String
  gymId    String
  role     Role            @default(MEMBER)
  status   GymMemberStatus @default(ACTIVE)
  joinedAt DateTime        @default(now())

  /// Staff override for the derived {@link MemberKind}. `null` — the default, and
  /// what almost every row keeps — means "trust the subscription". Set only when a
  /// person's standing genuinely does not follow from their billing, and it then
  /// wins over the derivation until staff clear it again.
  kindOverride MemberKind?

  // Soft-delete "trash" (T-members-trash). When set, the membership was moved to
  // trash: it is hidden from the roster, tab counts, plan mix, check-in, and the
  // dashboard's live counts, but the row (and its history) survives so staff can
  // restore it. A daily unscoped purge cron hard-deletes rows whose `deletedAt` is
  // older than the 30-day retention window (cascading the member-owned children;
  // `Order`/`Invoice` are `SetNull`, so financial history is preserved). `null`
  // means a live member — the normal state.
  deletedAt DateTime?

  // Staff-managed profile extras (T4.x). Held on the gym membership (not the
  // cross-gym `User`) so each gym keeps its own record of a person; all nullable
  // and optional. `tags` are colour-keyed labels the roster + detail render.
  dateOfBirth           DateTime?
  gender                Gender?
  address               String?
  emergencyContactName  String?
  emergencyContactPhone String?
  medicalNotes          String?
  tags                  String[]  @default([])

  /// National identity number, captured by the public self-signup wizard (where
  /// it is required) and editable from the staff console. Nullable at the column
  /// level because every membership that predates self-signup — and every staff
  /// row created through the directory or an invite — has none; the "required"
  /// rule belongs to the signup contract, not to the table.
  personalId String?

  /// The day the membership is meant to BEGIN, as the member or the front desk
  /// chose it — a recorded fact about the enrolment, shown on the member profile.
  ///
  /// Deliberately inert. NOTHING reads this column to make a decision: billing,
  /// renewal, dunning and check-in eligibility all continue to go to
  /// `Subscription.currentPeriodStart` and the member's `status`, exactly as they
  /// did before it existed. So editing it corrects the record and moves no money —
  /// which is the whole point, since a column that quietly shifted a billing
  /// anchor would turn every backfilled or mistyped date into a financial event.
  ///
  /// It is not that the two values are always set apart, though. A staff create
  /// that enrols someone on a plan states one date and it lands in both places:
  /// here as the recorded fact, and on the new `Subscription` as its first period
  /// start — because the desk said "starting then" about the enrolment and the
  /// plan in the same breath. That is one input written twice at the moment of
  /// creation, not this column driving the other afterwards; they are free to
  /// diverge from then on, and only the subscription's own field is consulted.
  ///
  /// Nullable, and null for almost every existing row: the gym has to switch the
  /// `startDate` intake toggle on before anyone is asked for one. "Starts today"
  /// is not spelled here either — that is `joinedAt`, which every membership has.
  /// Stored at UTC midnight like `dateOfBirth`, because it is a calendar day in
  /// the gym's own zone rather than an instant.
  startDate DateTime?

  // Directory-staff identity (T-staff-directory). A staff member added straight
  // to the directory is backed by a login-less `User` (no password, never
  // invited); their split name lives here so the roster's First/Last columns are
  // real (the `User` only carries a single `name`). `email`/`phone` stay on the
  // `User`. Null/empty for plain members and invited staff, whose name comes
  // from `User`.
  firstName String?
  lastName  String?

  /// @deprecated Superseded by {@link LocationStaff} in Stage 6 of multi-branch.
  /// **Read it if you must, but never treat it as the answer.**
  ///
  /// It was the staff work-assignment list: the gym `Location`s a receptionist or
  /// coach is rostered to work at, held as loose ids with no foreign key and
  /// filtered against live locations on read — "the same lightweight approach as
  /// `tags`", which is exactly what it should never have been. Three costs, all
  /// paid before Stage 6 removed the cause:
  ///
  ///  - **No referential integrity.** Deleting a branch left its id in every staff
  ///    row, silently, forever; a `String[]` gets none of the `SetNull` protection
  ///    the real branch columns get. Worse, nothing stopped an id naming a branch
  ///    of ANOTHER GYM — the same unpoliced-scalar class Stage 3 had to repair on
  ///    `CheckIn.locationId`.
  ///  - **No reverse query.** "Who works at branch X" is `has` over an unindexed
  ///    array: a sequential scan of every membership in the gym, members included.
  ///    That is why the roadmap's exemption register lists `GET /dashboard/staff`
  ///    as gym-wide "unblocked by Stage 6" — the read was not slow, it was absent.
  ///  - **No `Location` back-relation**, so a branch could not list its own people
  ///    and no `include` could resolve the names in one round trip.
  ///
  /// **Retained, not dropped, on the same expand/contract terms Stages 0–5 used —
  /// and for a sharper reason than any of them.** Those stages kept a column
  /// NULLABLE until the write paths agreed; this one keeps a column that
  /// `staff.service.ts` still SELECTs (`STAFF_SELECT`), writes on create and
  /// patches on update. Dropping it in the same migration that adds
  /// `location_staff` would make the deploy fail in the gap between the migration
  /// running and the new API image serving: every staff list would 500 on a column
  /// that no longer exists. The migration COPIES into the join table and changes
  /// nothing here, so old and new code both work throughout.
  ///
  /// While both exist, **`LocationStaff` is authoritative and this is a shadow.**
  /// They can drift the moment the API writes one without the other; nothing
  /// enforces agreement, because a trigger would be the only way to and this
  /// schema has none. The follow-up migration that drops this column lands with
  /// the `staff.service.ts` change that stops reading it — the contract half of
  /// Stage 6, which is a different workstream from the schema half.
  assignedLocationIds String[] @default([])

  /// The member's **home branch**: the {@link Location} they signed up at and
  /// normally train at. Exactly one, because a membership belongs somewhere — it is
  /// where this person is *on the books*, not everywhere they might swipe in.
  ///
  /// Without it, "how many members does the Saburtalo branch have" is not a hard
  /// query, it is an unanswerable one — and so is everything built on top of it:
  /// per-branch retention and churn, MRR and ARPM, members-at-risk,
  /// membership-movement, the expiring-memberships and roster reports, the
  /// dashboard's member and subscription cards. Every one of those counts members
  /// or their subscriptions, which is why every one of them is listed gym-wide in
  /// the roadmap's exemption register, unblocked by this column and nothing else.
  ///
  /// **Not `assignedLocationIds` / {@link LocationStaff}, above.** Those are the
  /// *staff work-assignment* set: the branches a receptionist or coach is rostered
  /// to work at — MANY-valued. This is single-valued. Two genuinely different
  /// concepts that both name locations on one model, so the confusion is worth
  /// naming here rather than discovering later: writing one when you meant the
  /// other raises nothing and reads as a quietly wrong number.
  ///
  /// **Stage 6 gave this column a second, equally load-bearing meaning on a STAFF
  /// row, and did not add a column for it.** For an employee this is their BASE
  /// branch — the one they are principally attached to — while
  /// {@link LocationStaff} lists everywhere they can be rostered. A `isPrimary`
  /// flag on the join table was the obvious alternative and was rejected: it would
  /// be a SECOND single-branch answer about the same person on the same person's
  /// data, free to disagree with this one, and every reader would have to know
  /// which of the two it meant. One person, one base branch, one column — the same
  /// column a member uses, because "which single branch is this human attached to"
  /// is one question whether they pay or are paid.
  ///
  /// That is also what keeps the attribution rule's PARTITION property intact.
  /// `LocationStaff` is many-to-many and therefore cannot partition: summing a
  /// per-branch head-count off it double-counts everyone who works at two sites.
  /// **A head-count of people reads this column. A question of availability — "can
  /// this branch be staffed on Tuesday", "which coaches can I book here" — reads
  /// the join table.** They are not interchangeable and a figure that mixes them
  /// reconciles against nothing.
  ///
  /// Nullable, and deliberately only for now. The
  /// `20260830130000_gym_member_home_branch` migration backfills every existing row
  /// onto its gym's default branch (see {@link Location.isDefault}), so a live row
  /// should never be null; the column is tightened to NOT NULL in a follow-up, once
  /// every member-create path — console form, self-signup, invite, import — requires
  /// a branch and no new nulls can appear. That is the same expand/contract the
  /// default-branch migration used, for the same reason: a NOT NULL added before the
  /// write paths agree is a deploy that fails at 3am, not a stronger schema.
  ///
  /// `SetNull` on delete, never cascade: closing a branch must not delete the people
  /// who trained there. They fall back to unattributed and wait to be re-homed —
  /// a member with no branch is a gap in a report, a deleted member is a lost customer.
  locationId String?

  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym                     Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  /// The member's home branch — see {@link GymMember.locationId}.
  location                Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings                Booking[]
  reviews                 Review[]
  /// Orders this person BOUGHT. Named because {@link Order} now points at
  /// `GymMember` twice — once for the buyer, once for the staff member who rang
  /// the sale — and Prisma cannot tell two relations between the same pair apart
  /// on its own.
  orders                  Order[]              @relation("OrderBuyer")
  /// Orders this staff member SOLD, for the sales-by-staff report. Empty for a
  /// plain member, and for every sale that predates the attribution.
  sales                   Order[]              @relation("OrderSeller")
  /// Services this staff member delivers (the Services catalogue).
  services                Service[]            @relation("ServiceStaff")
  serviceSessionsAsStaff  ServiceSession[]     @relation("ServiceSessionStaff")
  serviceSessionsAsMember ServiceSession[]     @relation("ServiceSessionMember")
  /// Refunds this staff member processed.
  refundsProcessed        Refund[]
  subscriptions           Subscription[]
  creditPacks             CreditPack[]
  goals                   MemberGoal[]
  checkIns                CheckIn[]
  invoices                Invoice[]
  notes                   MemberNote[]
  tasks                   MemberTask[]
  opportunities           Opportunity[]
  loyaltyLedger           LoyaltyLedgerEntry[]
  loyaltyRedemptions      LoyaltyRedemption[]
  promoRedemptions        PromoRedemption[]
  staffNotes              StaffNote[]
  staffTasks              StaffTask[]
  timeOffRequests         TimeOffRequest[]
  shiftSlots              ShiftSlot[]
  /// Every branch this staff member is rostered to work at — see
  /// {@link LocationStaff}. Empty for a plain member, who works nowhere. NOT a
  /// head-count source: it is many-to-many and does not partition the payroll.
  locationAssignments     LocationStaff[]
  /// The coach profile this staff member teaches under, when they hold (or once
  /// held) the `TRAINER` role. One-to-one — see {@link Trainer.staffId}.
  trainerProfile          Trainer?

  @@unique([userId, gymId])
  // The admin roster lists a gym's MEMBER-role memberships filtered by `status`,
  // sorted by `joinedAt`, and paginated, plus per-status tab counts (T9.9). At
  // ~10k members these composites let Postgres serve the filter+sort+page and the
  // status groupBy straight from an index instead of scanning every gym row and
  // sorting in memory. Both are `gymId`-prefixed, so they also cover the plain
  // tenant-scoped `gymId` lookups the old single-column index served.
  @@index([gymId, role, status])
  @@index([gymId, role, joinedAt])
  // The trash view lists soft-deleted members and the purge cron scans them by
  // `deletedAt`, both gym-scoped — this composite serves both without a table scan.
  @@index([gymId, deletedAt])
  // The roster and every member KPI narrowed to one branch: "members at branch X
  // with status Y". `gymId` leads because the tenant Prisma extension injects it
  // into every `where` — a `locationId`-first index is a shape no query here can
  // issue. It does NOT replace `(gymId, role, status)`: that one answers the
  // unfiltered roster and the per-status tab counts, whose second column is `role`,
  // so neither index is a prefix of the other and both earn their keep.
  @@index([gymId, locationId, status])
  @@map("gym_members")
}

/// A member's personal training goal (e.g. "Workouts / week", current vs target),
/// shown on the member portal's trainer screen. Tenant-scoped by `gymId`; owned by
/// the member, edited via `PUT /me/goals`. `position` preserves display order.
model MemberGoal {
  id        String   @id @default(cuid())
  gymId     String
  memberId  String
  label     String
  current   Float    @default(0)
  target    Float
  unit      String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym    Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId])
  @@map("member_goals")
}

/// A free-text staff note on a member (T4.x), shown on the member detail's
/// Notes & Tasks tab, newest first. Tenant-scoped by `gymId`; owned by the member
/// (deleted with them). `authorName` is snapshotted at write time so a note keeps
/// its attribution even if the staff user later changes; `authorId` links back to
/// the writing `User` when known.
model MemberNote {
  id         String   @id @default(cuid())
  gymId      String
  memberId   String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  gym    Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId, createdAt])
  @@map("member_notes")
}

/// A follow-up task logged against a member (T4.x) — call back, chase payment,
/// etc. — shown on the Notes & Tasks tab. Tenant-scoped by `gymId`; owned by the
/// member. `dueDate` / `assignee` are optional; `status` toggles PENDING↔DONE.
model MemberTask {
  id        String           @id @default(cuid())
  gymId     String
  memberId  String
  title     String
  dueDate   DateTime?
  assignee  String?
  status    MemberTaskStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gym    Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@index([memberId, status])
  @@map("member_tasks")
}

/// A member's reception check-in — one live arrival at the gym (T4.12). Recorded
/// from the staff console's Reception screen either by scanning the member's QR
/// (`method = QR`) or a manual receptionist lookup (`method = MANUAL`).
/// Tenant-scoped by `gymId`; `gymMemberId` is the arriving member. The
/// `(gymId, checkedInAt)` index backs the "today's arrivals" feed and the
/// reception stats (checked-in / peak); `(gymMemberId)` backs a member's own
/// visit history; `(gymId, locationId, checkedInAt)` backs both of those narrowed
/// to one branch. Append-only: a check-in is never edited, so there is no
/// `updatedAt`.
model CheckIn {
  id          String        @id @default(cuid())
  gymId       String
  gymMemberId String
  method      CheckInMethod @default(MANUAL)
  checkedInAt DateTime      @default(now())
  /// The branch the member physically WALKED INTO — the door they came through for
  /// this one arrival. Emphatically not {@link GymMember.locationId}, their home
  /// branch: a visit is an event at a place, a home branch is a property of a
  /// person, and the two legitimately differ every time somebody drops in at the
  /// other site. Occupancy, footfall and peak-hour figures are all about the place,
  /// so they read this column and never the member's.
  ///
  /// A real {@link Location} relation since Stage 3 of multi-branch. Before that it
  /// was a bare scalar with no foreign key, no back-relation and no index — nothing
  /// in `apps/api` ever wrote it, so every production row was NULL and the seed's
  /// round-robin was the only thing that had ever populated it. The migration that
  /// promoted it backfilled those NULLs onto each gym's default branch (see
  /// {@link Location.isDefault}) and, because the missing foreign key meant the
  /// column could hold ids no location answers to, first repaired any orphaned or
  /// cross-tenant id by nulling it into that same backfill.
  ///
  /// Still nullable, on the same expand/contract terms as {@link GymMember.locationId}:
  /// it is tightened to NOT NULL only once every check-in write path (reception QR,
  /// manual lookup, and whatever turnstile integration follows) requires a branch.
  ///
  /// `SetNull` on delete, never cascade: closing a branch keeps its footfall
  /// history. The visits still happened, and the year-on-year comparison that
  /// justifies the closure is made of exactly these rows — deleting them with the
  /// branch would erase the evidence for the decision.
  locationId  String?

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member   GymMember @relation(fields: [gymMemberId], references: [id], onDelete: Cascade)
  /// The branch this arrival happened at — see {@link CheckIn.locationId}.
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // The all-branches reception feed and stats: "today's arrivals for this gym".
  // Kept, NOT replaced by the composite below — `(gymId, checkedInAt)` is not a
  // prefix of `(gymId, locationId, checkedInAt)`, so with no branch selected the
  // wider index cannot serve the range on `checkedInAt` without first scanning
  // every branch's slice. "All locations" is the console's default, so this is the
  // hotter of the two.
  @@index([gymId, checkedInAt])
  @@index([gymMemberId])
  // The same feed and stats narrowed to one branch. `gymId` leads because the
  // tenant Prisma extension injects it into every `where` — a `locationId`-first
  // index is a shape no query here can issue — and `checkedInAt` trails so the
  // branch's arrivals come back already in time order for the peak-hour buckets.
  @@index([gymId, locationId, checkedInAt])
  @@map("check_ins")
}

/// A trainer profile a gym curates from the staff console (T4.4). A gym-scoped
/// content record — name, headline, bio, photo, specialties — the gym manages
/// for its public trainers index (T3.6). It is a different *kind* of record from
/// a `TRAINER`-role {@link GymMember} (an auth identity / roster entry), but the
/// two describe one person and are now linked one-to-one through {@link staffId}:
/// adding staff with the `TRAINER` role creates the coach profile, and adding a
/// coach creates the (login-less) staff record, so the Staff and Trainers screens
/// are two views of the same roster. One gym can have many trainers; `gymId` is
/// the isolating tenant key the scoped Prisma client constrains every query to.
/// `photoUrl` is the public URL of the headshot uploaded to R2 (see the storage
/// signed-upload service), or `null` when the trainer has no photo (the card
/// renders an initials placeholder).
model Trainer {
  id           String        @id @default(cuid())
  gymId        String
  name         String
  headline     String        @default("")
  bio          String        @default("")
  photoUrl     String?
  specialties  String[]      @default([])
  /// The trainer's weekly recurring availability (T5.11): a JSON map keyed by
  /// lowercase weekday (`mon`…`sun`) to `{ available, windows: [{ start, close }] }`,
  /// where `windows` is an ordered, non-overlapping list of `HH:MM` time ranges the
  /// trainer can teach/coach that day (split shifts allowed). Managed from the staff
  /// console via the dedicated `/admin/trainers/:id/availability` endpoint and
  /// validated by `weeklyAvailabilitySchema` in `@fit/types`. Defaults to `{}`, which
  /// the schema fills to a fully-unavailable seven-day week until staff set hours.
  availability Json          @default("{}")
  status       TrainerStatus @default(ACTIVE)
  /// Denormalised aggregate of the trainer's `VISIBLE` reviews (T5.12), kept in
  /// step by {@link Review} writes: `rating` is the average star rating (0 when
  /// the trainer has no visible reviews) and `reviewCount` the number of them. The
  /// reviews service recomputes both inside the transaction that posts or hides a
  /// review, so trainer cards / the detail page can render the live rating without
  /// a COUNT/AVG join — the same denormalisation `ClassInstance.bookedCount` uses.
  rating       Float         @default(0)
  /// @counter
  reviewCount  Int           @default(0)
  /// The gym-staff membership this coach *is*. Unique, so the link is strictly
  /// one-to-one: one person is one roster entry and one coach profile. `null` only
  /// for a profile whose staff record has been removed — `SetNull` rather than
  /// `Cascade` on purpose, because class templates, occurrences, PT sessions and
  /// reviews all point at this row, and deleting someone from the staff directory
  /// must never take the gym's teaching history with it. The staff service
  /// deactivates the orphaned profile instead.
  staffId      String?       @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff          GymMember?      @relation(fields: [staffId], references: [id], onDelete: SetNull)
  classTemplates ClassTemplate[]
  classInstances ClassInstance[]
  ptSessions     PtSession[]
  reviews        Review[]

  /// **Stage 6 of multi-branch deliberately gave this model NO `locationId`, and
  /// the roadmap's own line item for it is the thing being argued down.**
  ///
  /// A `Trainer` is a PROFILE OF A PERSON, one-to-one with a staff
  /// {@link GymMember} through {@link staffId}. That person already carries two
  /// branch facts: `GymMember.locationId`, their base branch, and
  /// {@link LocationStaff}, everywhere they are rostered. A third column here
  /// would be a third answer to the same question, on a row nobody would think to
  /// update when the roster changed, and the first time it disagreed there would
  /// be no way to say which was right. That is the `assignedLocationIds` mistake
  /// again in a new place: a location-shaped field with nothing keeping it true.
  ///
  /// So "coaches at branch X" is a relation hop —
  /// `{ staff: { is: { locationAssignments: { some: { locationId } } } } }` — and
  /// the cost is named rather than hidden: two joins and no composite index to
  /// serve them. That is affordable HERE and would not have been on `Payment`,
  /// which is why Stage 5 denormalised and this does not: a gym has tens of
  /// coaches, not tens of thousands of takings, and nothing loops this query.
  /// Postgres drives it off `location_staff(gymId, locationId)`, probes
  /// `gym_members` by primary key and `trainers` by the `staffId` unique.
  ///
  /// One residual class, stated because it is silent: a profile whose staff record
  /// was removed has `staffId = null` (`SetNull`, so teaching history survives the
  /// person leaving the directory) and therefore reaches no branch at all. It
  /// falls out of every branch filter. That is correct — such a profile is an
  /// orphan the staff service deactivates — but it means a branch-filtered trainer
  /// roster can be SHORTER than the gym-wide one by more than the branch split
  /// explains.
  ///
  /// The index below is the compensation. `(gymId)` was a bare tenant index and a
  /// strict PREFIX of this one, so this supersedes it outright rather than adding
  /// to it — the Stage 0 `class_templates_locationId_idx` shape, not the Stage 3
  /// "both earn their keep" one. Every roster read is
  /// `where { gymId, status } orderBy name` (`admin-trainers.service.ts`,
  /// `trainers.service.ts`), so the composite serves the filter AND returns the
  /// page already sorted; and under a branch filter this table is the side being
  /// probed, so a tighter driving index matters more now than it did before the
  /// hop existed.
  @@index([gymId, status, name])
  @@map("trainers")
}

/// A physical location (branch) a gym curates from the staff console (T4.5). A
/// gym-scoped content record — name, address, phone, photo, amenities, and weekly
/// opening hours — the gym manages for its public locations listing (the purchase
/// wizard's first step, T3.8). One gym can have many locations; `gymId` is the
/// isolating tenant key the scoped Prisma client constrains every query to.
/// `photoUrl` is the public URL of a photo uploaded to R2 (see the storage
/// signed-upload service), or `null` when the branch has no photo. `amenities` is
/// a flat list of short labels (rendered as chips); `hours` is a JSON map keyed by
/// lowercase weekday (`mon`…`sun`) to `{ closed, open, close }`, the editable
/// source the public denormalised `hours` display string is projected from.
model Location {
  id        String         @id @default(cuid())
  gymId     String
  name      String
  address   String         @default("")
  phone     String?
  photoUrl  String?
  amenities String[]       @default([])
  hours     Json           @default("{}")
  status    LocationStatus @default(ACTIVE)
  /// The gym's *default branch*: the one every previously unattributed row was
  /// backfilled to, and the one a create form pre-selects while the console's
  /// location switcher sits on "All locations". Elected per gym by the migration
  /// that added this column (oldest `ACTIVE` branch, falling back to the oldest
  /// branch of any status; a gym with no branch at all had a `"Main"` one created
  /// for it), so exactly one row per gym carries it.
  ///
  /// That "exactly one per gym" invariant is a PARTIAL unique index —
  /// `locations_gymId_default_key ON "locations"("gymId") WHERE "isDefault"` — and
  /// lives ONLY in the migration SQL, because Prisma's schema language cannot
  /// express a partial index. Its absence here is deliberate, not an oversight:
  /// a plain `@@unique([gymId, isDefault])` would be the wrong constraint (it
  /// would also forbid a gym having two *non*-default branches).
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  gym             Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classTemplates  ClassTemplate[]
  classInstances  ClassInstance[]
  orders          Order[]
  leads           Lead[]
  /// Members whose HOME branch this is — see {@link GymMember.locationId}. Not the
  /// staff rostered to work here: that is `GymMember.assignedLocationIds`, a loose
  /// id array with no relation, so it has no back-reference to appear in.
  gymMembers      GymMember[]
  /// Arrivals recorded at this branch — see {@link CheckIn.locationId}. A different
  /// population from {@link gymMembers}: that is who calls this branch home, this is
  /// who actually came through the door, and a drop-in appears here without
  /// appearing there.
  checkIns        CheckIn[]
  /// What this branch has on its own shelves — see {@link ProductStock}. Branches
  /// are separate operating units, so this is the authoritative on-hand count; the
  /// gym-wide `Product.stock` is the roll-up of these rows, not their source.
  productStock    ProductStock[]
  /// Every stock movement recorded at this branch — see {@link StockMovement.locationId}.
  stockMovements  StockMovement[]
  /// The money this branch took, and the reversals against it — see
  /// {@link Payment.locationId} and {@link Refund.locationId}. Denormalised copies
  /// of `order.locationId`, so these are the same population as
  /// `orders.payment` / `orders.refunds` filtered to this branch, reachable
  /// without the join.
  payments        Payment[]
  refunds         Refund[]
  /// Invoices raised against members who called this branch home at issue time —
  /// see {@link Invoice.locationId}. A DIFFERENT population from {@link payments}:
  /// that one follows the till, this one follows the person, and the two only
  /// coincide when a member buys at their own branch.
  invoices        Invoice[]
  /// The staff ROSTERED to work here — see {@link LocationStaff}. The relation
  /// `GymMember.assignedLocationIds` never had, which is why "who works at branch
  /// X" was unanswerable before Stage 6. Overlapping, not partitioning: a coach
  /// who covers both sites appears under both, so counting rows here counts
  /// assignments, not people. For a head-count of people attached to this branch,
  /// use {@link gymMembers} (their base branch) instead.
  staff           LocationStaff[]
  /// 1:1 coaching booked to run at this branch — see {@link PtSession.locationId}.
  ptSessions      PtSession[]
  /// Service slots scheduled to run at this branch — see
  /// {@link ServiceSession.locationId}.
  serviceSessions ServiceSession[]
  /// Shifts rostered at this branch — see {@link ShiftSlot.locationId}. Before
  /// Stage 6 this was a free-text branch NAME on the shift, which looked like a
  /// branch and was not one.
  shiftSlots      ShiftSlot[]

  @@index([gymId])
  @@map("locations")
}

/// Which branches a staff member works at — the many-to-many roster Stage 6 of
/// multi-branch introduced to replace `GymMember.assignedLocationIds`, the loose
/// `String[]` that had no foreign key, no reverse query and no back-relation.
///
/// ## Why a join table and not a column
///
/// A person can work at several branches; a shift, a PT session and a service
/// booking each happen at exactly one place. Those are DIFFERENT SHAPES and Stage 6
/// deliberately did not collapse them into one mechanism just because a coach
/// appears in all four. Work assignment is a capability — "Nino can be rostered at
/// Saburtalo" — and capabilities are many-valued. Everything that actually HAPPENS
/// takes a single nullable FK on its own row: {@link ShiftSlot.locationId},
/// {@link PtSession.locationId}, {@link ServiceSession.locationId}. Modelling a
/// scheduled event through its coach's assignment set would make "where is this
/// session" ambiguous exactly when the coach covers two sites, which is the only
/// case worth asking about.
///
/// ## What it deliberately does NOT carry
///
/// **No `role`.** A per-branch role — manager here, receptionist there — is a real
/// arrangement in real gyms, and it is still the wrong column. `Role` in this
/// codebase is the AUTHORIZATION axis: `packages/types/src/permissions.ts` gates on
/// `GymMember.role`, and the tenant state carries exactly one. A second role column
/// the permission system never reads would look like access control and grant
/// nothing — the same class of trap as a free-text `location` that looks like a
/// branch. Whether the branch filter becomes a permission boundary at all is Stage
/// 8's open question; until it is answered, this table says where someone works and
/// not what they may do there.
///
/// **No `isPrimary`.** The base branch is `GymMember.locationId` — see the long note
/// on that column. A flag here would be a second single-branch answer about the same
/// person, free to disagree with the first, needing its own partial unique index to
/// stay singular. One question, one column.
///
/// So the row is the pair plus `createdAt`, which records when someone was rostered
/// onto a branch. No `updatedAt`: there is nothing to update. Moving an assignment
/// is a delete and a create, because the pair IS the fact — the same stance `tags`
/// took, this time with a foreign key behind it.
///
/// ## Deletes
///
/// `Cascade` on BOTH sides, which is the opposite of every other branch relation in
/// this schema and is right for the same reason {@link ProductStock} cascades: a row
/// here is nothing but the pair. `SetNull` would leave "somebody is assigned
/// somewhere", which is not a fact worth keeping — unlike an un-homed member, an
/// un-placed order or a check-in that has lost its door, all of which still record
/// that something happened. Closing a branch un-rosters its people from it and
/// leaves their base branch, their shifts' history and their employment untouched.
model LocationStaff {
  id         String   @id @default(cuid())
  gymId      String
  /// The staff {@link GymMember}. Only non-`MEMBER` roles belong here — a customer
  /// works nowhere — but that is a convention the API enforces, not a constraint
  /// the column can express.
  staffId    String
  locationId String
  createdAt  DateTime @default(now())

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff    GymMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  location Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// The pair, once. Also the `where`-unique an assignment editor upserts on, and
  /// the integrity `assignedLocationIds` could never have: a duplicate id in that
  /// array was silently legal and doubled the person in any count derived from it.
  @@unique([staffId, locationId])
  /// **"Who works at branch X" — the reverse query that did not exist.** Against
  /// the array it was a `has` over an unindexed `String[]`, i.e. a scan of every
  /// membership in the gym, members included. `gymId` leads because the tenant
  /// Prisma extension injects it into every `where`.
  @@index([gymId, locationId])
  /// No `@@index([gymId, staffId])`, deliberately. The unique above already LEADS
  /// on `staffId`, so "which branches does this person work at" is served by it and
  /// `gymId` is a heap filter over the handful of rows one person can have. A
  /// second index would cost a write on every roster change and win nothing —
  /// worth stating, because the reflex on this schema is that `gymId` leads
  /// everything, and that reflex is about COMPOSITES the extension's `gymId` would
  /// otherwise sit in front of, not about a two-column unique whose other column is
  /// already the selective one.
  @@map("location_staff")
}

/// A retail product a gym curates and sells from the staff console (T4.6). A
/// gym-scoped content record — name, description, base price, an ordered image
/// gallery, and a set of purchasable variants — the gym manages for its store.
/// One gym can have many products; `gymId` is the isolating tenant key the scoped
/// Prisma client constrains every query to. `priceAmount` is the base price in the
/// currency's MINOR units (e.g. cents/tetri) so no float rounding crosses the wire,
/// with `currency` an ISO-4217 code; a variant may override it. `images` is a flat,
/// ordered list of public R2 URLs (the first is the primary/thumbnail), each
/// uploaded via the storage signed-upload service. `variants` is a JSON array of
/// `{ name, sku, priceAmount, stock }` objects — the editable source for the
/// product's purchasable options, validated by `productVariantsSchema`.
/// A shelf the gym files its retail {@link Product}s under — "Protein", "Drinks".
///
/// A gym-scoped, staff-curated list rather than free text on the product, so a
/// rename lands everywhere at once and the same shelf can't exist twice under two
/// spellings (`@@unique([gymId, name])` — the failure mode free text invites).
///
/// Deleting a category does NOT delete its products: the relation is `SetNull`, so
/// they simply fall back to uncategorised. Categories are an organisational
/// overlay, never the owner of the catalogue.
model ProductCategory {
  id        String   @id @default(cuid())
  gymId     String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([gymId, name])
  @@index([gymId])
  @@map("product_categories")
}

model Product {
  id                String        @id @default(cuid())
  gymId             String
  name              String
  description       String        @default("")
  priceAmount       Int           @default(0)
  costAmount        Int?
  currency          String        @default("USD")
  images            String[]      @default([])
  variants          Json          @default("[]")
  status            ProductStatus @default(ACTIVE)
  /// GYM-WIDE on-hand count for the **base** position — the product sold as-is,
  /// with no variant chosen (the `"<productId>:base"` reference the cart already
  /// uses). `null` means this product's stock is not tracked at all, which is what
  /// every newly created product starts as; a gym that never counts its towels is
  /// not nagged about them. Products that DO carry variants keep their counts per
  /// variant inside `variants`, and this stays null — the two are alternatives,
  /// never summed.
  ///
  /// **Since Stage 4 of multi-branch this column is a DERIVED ROLL-UP, not the
  /// source of truth.** The authoritative figure is per branch, in
  /// {@link ProductStock}; this is `SUM(ProductStock.stock)` over the product's
  /// branch rows, kept in step inside the same transaction as every branch write.
  /// It is retained rather than dropped because every existing reader asks a
  /// gym-wide question and still deserves a gym-wide answer: the member shop's
  /// "in stock?", the cart's pre-checkout stock check, the low-stock ops alert and
  /// the mobile catalogue are all about the gym, not a till. Those that should
  /// become per-branch (POS, the inventory pages) move to {@link ProductStock}
  /// one at a time instead of breaking at once.
  ///
  /// The drift risk is real and mitigated by exactly one rule: **a branch write and
  /// this roll-up move by the same signed delta, atomically, in one transaction**
  /// (see the `@counter` marker and docs/adr/atomic-counters.md). Recomputing the
  /// sum instead would be a read-then-write and would lose races; an `increment`
  /// of the same delta cannot drift under concurrency — only under a write path
  /// that forgets to do it. Reconciliation query, for when one does:
  /// `SELECT p.id FROM products p LEFT JOIN product_stock s ON s."productId" = p.id`
  /// `GROUP BY p.id, p.stock HAVING p.stock IS DISTINCT FROM SUM(s.stock);`
  /// @counter
  stock             Int?
  /// Per-product reorder cushion, and the MIDDLE rung of a three-level fallback
  /// since Stage 4: `ProductStock.lowStockThreshold` (this line, at this branch)
  /// → this column (this line, everywhere) → the shared gym default. A gym only
  /// sets either level for the few lines whose turnover differs from the rest.
  lowStockThreshold Int?
  /// Optional shelf — `null` is "uncategorised", the state every product starts in
  /// and the state it returns to if its category is deleted.
  categoryId        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  gym             Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  category        ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  movements       StockMovement[]
  /// The authoritative per-branch counts this product's gym-wide `stock` and
  /// `variants[].stock` are rolled up from — see {@link ProductStock}.
  stockByLocation ProductStock[]

  @@index([gymId])
  @@index([categoryId])
  @@map("products")
}

/// What one {@link Product} has on hand at one {@link Location} — the row Stage 4
/// of multi-branch makes the source of truth for inventory.
///
/// The gym owner's decision is that branches are separate operating units and each
/// holds its own stock, so "how many do I have?" has no gym-wide answer any more;
/// it has one answer per branch, and the gym-wide figure on `Product` is their sum.
///
/// ## Addressing
///
/// A stock POSITION is `(productId, variantIndex)` — the vocabulary the cart's
/// `encodeVariantRef` (`"<productId>:base"` / `"<productId>:<index>"`) and
/// {@link StockMovement.variantIndex} already speak. Stage 4 adds a branch to that
/// key and changes nothing else about it. One row here holds EVERY position of one
/// product at one branch:
///
/// - `stock` is the base position, with exactly {@link Product.stock}'s semantics
///   one level down: `null` = this branch does not count the base position, either
///   because the product sells by variant or because the gym does not count it.
/// - `variants` is a flat array of integer counts, positionally aligned with
///   {@link Product.variants} — `[12, 20, 8, 3]` for a tee's S/M/L/XL. Deliberately
///   NOT a copy of the `productVariantSchema` objects: name, SKU and price are
///   catalogue facts that are identical at every branch, and duplicating them per
///   branch would invite them to diverge. An index past the array's end reads as
///   `0` — "nothing counted here yet" — which is how a newly added variant behaves
///   at a branch that has not received any.
///
/// The base-XOR-variants invariant carries over unchanged: a product with variants
/// keeps `stock` null in every branch row, and the two are never summed.
///
/// ## What this shape makes hard, stated plainly
///
/// Variant counts stay invisible to SQL. "Every position below its threshold" is
/// still not one indexed query — the low-stock page loads candidate rows and
/// evaluates the JSON in application code, exactly as it does today. Stage 4 does
/// not fix that; it declines to fix it in the same change that moves the writes.
///
/// And the positional array now exists once PER BRANCH. `ProductStock.variants[i]`
/// must stay aligned with `Product.variants[i]`, and that is now an N-row invariant
/// with no database constraint behind it: editing a product's variant list has to
/// fan out to every branch row in one transaction, where before it touched one
/// column. A row-per-position table would have avoided this — it was rejected
/// because the base position cannot be expressed in it. A nullable `variantIndex`
/// inside a compound unique is unaddressable by Prisma's generated
/// `WhereUniqueInput` (so `upsert`, the till's natural write, is unavailable) and
/// Postgres treats its NULLs as distinct, so the constraint would not even hold;
/// the alternative, a `-1` sentinel for "base", would put two spellings of the same
/// concept in one domain, since {@link StockMovement.variantIndex} means base by
/// `null`. Migrating to rows later stays open — the position key does not change.
///
/// ## Absence
///
/// A missing row is not an error and not a zero anybody counted: it means no stock
/// has been recorded for this product at this branch, and it reads as `0` on hand.
/// The Stage 4 migration therefore writes rows only at each gym's default branch —
/// see its comments for why the pre-split figure cannot be divided, and for the
/// manual stock-take that has to follow the deploy.
///
/// `gymId` is denormalised from the product so the tenant Prisma extension can
/// scope this model the way it scopes every other. **It must be added to
/// `TENANT_SCOPED_MODELS` in `apps/api/src/common/prisma/prisma-tenant.extension.ts`
/// when the API half lands** — an unlisted model carrying `gymId` is precisely the
/// cross-tenant leak shape the roadmap already had to fix once.
model ProductStock {
  id                String   @id @default(cuid())
  gymId             String
  productId         String
  locationId        String
  /// On-hand count of the base position at this branch; `null` when this branch
  /// does not count it. See the model doc — same meaning as {@link Product.stock},
  /// one level down.
  /// @counter
  stock             Int?
  /// Per-position counts at this branch, positionally aligned with
  /// {@link Product.variants}: a flat JSON array of non-negative integers. Counts
  /// only — never the catalogue fields. See the model doc.
  variants          Json     @default("[]")
  /// This branch's reorder cushion for this line — the FIRST rung of the fallback
  /// chain, ahead of {@link Product.lowStockThreshold} and the shared gym default.
  /// A flagship that turns over four times faster than the satellite needs its own
  /// number, and that is the whole reason this is not only a product-level field.
  lowStockThreshold Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  gym      Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// `Cascade`, unlike every other branch relation in this schema, because a stock
  /// row is meaningless without the branch it counts — there is no "unattributed
  /// on-hand count". Nothing hard-deletes a `Location` today (the console retires a
  /// branch to `INACTIVE`), so this is currently reachable only by deleting a whole
  /// gym. If branch deletion is ever built, note that the cascade would leave
  /// {@link Product.stock} over-counting by the closed branch's units, so that path
  /// must zero the rows out (writing the movements) before deleting — the
  /// {@link StockMovement} ledger survives via `SetNull` and keeps the evidence.
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  /// The position key: one row per product per branch. Also the `where`-unique the
  /// till upserts on when it sells a line at a branch that has no row yet.
  @@unique([productId, locationId])
  /// Backs "everything on this branch's shelves" — the inventory page and the
  /// low-stock scan. `gymId` leads because the tenant extension always injects it.
  @@index([gymId, locationId])
  @@map("product_stock")
}

/// A sellable, staff-delivered service (design: docs/superpowers/specs/2026-08-25-services-design.md).
/// `staffId` is the {@link GymMember} who delivers it — any non-MEMBER role; a
/// `PERSONAL_TRAINING` service additionally requires that member to have a
/// `trainerProfile`, enforced by the API. `priceMinor` is one session's price in
/// `currency` MINOR units. `schedule` is set only on a `CUSTOM` service — the
/// classes-admin recurrence vocabulary `{ freq, weekdays, startDate, startTime, until? }`
/// — and is expanded into sessions in stage 2.
model Service {
  id              String        @id @default(cuid())
  gymId           String
  type            ServiceType
  name            String
  staffId         String
  priceMinor      Int
  currency        String
  durationMinutes Int           @default(60)
  description     String        @default("")
  schedule        Json?
  /// Public URL of the service's cover image in R2 (`{gymId}/services/…`), or null
  /// when it has none. Referenced by the media sweep.
  coverUrl        String?
  status          ServiceStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  gym        Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  /// `Restrict`: a staff member with services cannot be hard-deleted — reassign first.
  staff      GymMember        @relation("ServiceStaff", fields: [staffId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  sessions   ServiceSession[]

  /// **Stage 6 of multi-branch gave this model NO `locationId` either, and here
  /// the reason is not duplication but SHAPE.**
  ///
  /// A `Service` is a catalogue entry — "60-minute PT with Nino, 120 GEL" — and a
  /// coach who works at both sites offers it at both. A single FK would force the
  /// catalogue row to one branch and make the other branch unable to sell a thing
  /// it demonstrably sells. A join table would be a THIRD many-to-many meaning
  /// something already recorded: a service is deliverable exactly where its
  /// {@link staff} is rostered, so a separate list would be a copy of
  /// {@link LocationStaff} that an operator has to remember to update twice and
  /// will not.
  ///
  /// So "services bookable at branch X" is derived:
  /// `{ staff: { is: { locationAssignments: { some: { locationId } } } } }`. The
  /// derivation is served by indexes that already exist —
  /// `location_staff(gymId, locationId)` finds the branch's people, and
  /// `services(gymId, staffId)` below is exactly the shape the resulting probe
  /// needs. That is a positive argument for deriving rather than storing: the
  /// filter costs one index this table already had.
  ///
  /// The derivation has one hole, and the Stage 6 migration is what closes it:
  /// `staffId` is `NOT NULL`, so every service reaches a person, but a person with
  /// no `LocationStaff` rows reaches no branch and their services vanish from
  /// every branch. Most staff had an EMPTY `assignedLocationIds` array before
  /// Stage 6, which is why the migration synthesises a default-branch assignment
  /// for every active employee rather than carrying across only what the array
  /// held.
  ///
  /// A `locationId` here meaning BRANCH-EXCLUSIVE — "this service is only sold at
  /// the flagship", `null` for everywhere — is a different and legitimate field,
  /// and it is Stage 7's, alongside plans, packages, products and campaigns. It is
  /// not this stage's, and it is not the same column: exclusivity is a restriction
  /// an operator asserts, availability is a fact derived from the roster.
  ///
  /// Backs the admin roster: a tenant's services by status and type.
  @@index([gymId, status, type])
  @@index([gymId, staffId])
  @@map("services")
}

/// One bookable run of a {@link Service}: a slot staff open on the PT calendar
/// (`OPEN`), which a member books from the portal (`BOOKED`, `memberId` set and a
/// PENDING invoice raised for the service price). `staffId` is snapshotted from
/// the service at creation so reassigning the service never moves a scheduled
/// session. `endsAt = startsAt + service.durationMinutes` at creation.
model ServiceSession {
  id         String               @id @default(cuid())
  gymId      String
  serviceId  String
  staffId    String
  /// null = an open slot any member may book.
  memberId   String?
  startsAt   DateTime
  endsAt     DateTime
  status     ServiceSessionStatus @default(OPEN)
  /// The invoice raised when the session was booked, or null while it is open.
  invoiceId  String?
  /// **The branch this slot RUNS AT.** A single FK, because a booking happens at
  /// exactly one place — the shape argument at the top of {@link LocationStaff}.
  /// {@link Service} carries no branch and must not: a service is offered wherever
  /// its staff works, whereas this row is one appointment at one door, and the two
  /// are only the same question for a coach who works at one site.
  ///
  /// **Not in Stage 6's headline list, and added anyway.** The roadmap named
  /// `Trainer`, `Service` and `PtSession`; the honest reading of "a service booking
  /// happens at exactly one place" points at this model rather than the catalogue,
  /// and the PT calendar renders `PtSession` and `ServiceSession` side by side. Give
  /// one a branch and not the other and a branch-filtered calendar is assembled from
  /// two populations — the same defect the exemption register records against the
  /// trainer-performance report, which adds a filterable column to an unfilterable
  /// one and orders the table by the sum.
  ///
  /// Frozen at creation for the same reason {@link staffId} is: that field is
  /// snapshotted from the service "so reassigning the service never moves a
  /// scheduled session", and a branch that followed the coach's live roster would
  /// move a booked appointment out from under the member who booked it. **A past
  /// event does not move because a person later did** — the rule Stage 5 wrote onto
  /// `Invoice.locationId`, applied forward.
  ///
  /// Nullable on the same expand/contract terms as Stages 0–5: tightening waits on
  /// the write paths. `SetNull` on delete — a session that happened still happened.
  locationId String?
  notes      String               @default("")
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  gym      Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  service  Service    @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  staff    GymMember  @relation("ServiceSessionStaff", fields: [staffId], references: [id], onDelete: Restrict)
  member   GymMember? @relation("ServiceSessionMember", fields: [memberId], references: [id], onDelete: SetNull)
  invoice  Invoice?   @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// The branch this slot runs at — see {@link ServiceSession.locationId}.
  location Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([gymId, startsAt])
  @@index([gymId, staffId, startsAt])
  @@index([gymId, memberId, startsAt])
  @@index([serviceId])
  @@index([invoiceId])
  /// One branch's calendar, in time order. ADDS to `(gymId, startsAt)` rather than
  /// replacing it, for the reason Stage 3 kept `check_ins_gymId_checkedInAt_idx`:
  /// `locationId` sits between the two columns the all-branches calendar uses, so
  /// neither index is a prefix of the other, and "All locations" is the console's
  /// default state and therefore the hotter path.
  @@index([gymId, locationId, startsAt])
  @@map("service_sessions")
}

/// Why a {@link StockMovement} happened. `RECEIVE` is a delivery landing on the
/// shelf, `WRITE_OFF` is loss/damage/expiry leaving it, and `RECOUNT` is a
/// physical count overriding whatever the system believed (the only reason whose
/// delta is derived from a target rather than chosen). `ADJUSTMENT` is the
/// catch-all manual correction. `SALE` and `REFUND_RESTOCK` are written by the
/// checkout and the refund path, never by hand — they carry an `orderId`.
enum StockMovementReason {
  RECEIVE
  ADJUSTMENT
  RECOUNT
  WRITE_OFF
  SALE
  REFUND_RESTOCK
}

/// One append-only entry in a product's stock ledger. Every change to an on-hand
/// count writes exactly one of these in the same transaction as the count itself,
/// so "why is this 3?" is answerable — the current number is a running total, not
/// a value someone typed with no history.
///
/// A movement addresses one stock position: `variantIndex` is the variant's slot
/// in the product's `variants` array, or `null` for the base position (the
/// product sold with no variant). Positions are addressed by index because
/// variants have no row id of their own; `variantLabel` snapshots the name at the
/// time so a later rename or reorder cannot make history unreadable.
///
/// `delta` is the signed change and `resultingStock` the count after it. Storing
/// both means the ledger reconstructs the timeline without replaying every prior
/// row, and a mismatch between them across consecutive rows is itself a signal
/// that something wrote stock outside this path.
model StockMovement {
  id             String              @id @default(cuid())
  gymId          String
  productId      String
  /// The branch whose shelves this movement changed — the {@link ProductStock} row
  /// it lands on. Added in Stage 4 of multi-branch: without it, a sale, a delivery
  /// and a write-off are all recorded as having happened to "the gym", and the
  /// ledger cannot explain any individual branch's count.
  ///
  /// Nullable on the same expand/contract terms as Stages 0, 2 and 3: tightening to
  /// NOT NULL waits until every stock write path requires a branch. `SetNull` on
  /// delete, so retiring a branch can make it null again — such a movement really
  /// happened, it just no longer names a place.
  locationId     String?
  /// Variant slot this moved, or `null` for the base position.
  variantIndex   Int?
  /// The variant's name when the movement happened; `""` for the base position.
  variantLabel   String              @default("")
  /// Signed change — negative for a sale or write-off, positive for a delivery.
  delta          Int
  /// On-hand count after the change, so history reads without replaying it.
  ///
  /// Since Stage 4 this is the count AT `locationId`, not a gym-wide total. That is
  /// a one-time seam, not an ongoing ambiguity: rows written BEFORE Stage 4 hold
  /// the gym-wide figure of the day, and the Stage 4 migration deliberately did not
  /// rewrite them — it could only have done so by falsifying either the number or
  /// the branch. Reading an old row's `resultingStock` as this branch's count is
  /// wrong for a gym that had more than one branch before Stage 4; reading the
  /// `delta` and the branch is right in every case.
  resultingStock Int
  reason         StockMovementReason
  /// Optional free-text note (supplier, damage description, count sheet ref).
  note           String              @default("")
  /// Staff user who caused it, or `null` for a member-driven checkout.
  actorId        String?
  /// The order behind a `SALE` / `REFUND_RESTOCK`, else `null`. A real relation
  /// since Stage 4 — it spent its whole life as a bare scalar with no foreign key,
  /// which is how nothing could join a stock movement back to the branch its order
  /// was sold at, and how ids pointing at long-deleted orders survived unnoticed.
  orderId        String?
  createdAt      DateTime            @default(now())

  product  Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// `SetNull`, never `Cascade`: the units physically moved, and voiding or purging
  /// an order must not erase the inventory history that explains today's count.
  order    Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([gymId, createdAt])
  @@index([productId, createdAt])
  /// The branch-filtered twin of `(gymId, createdAt)`. Added rather than replacing
  /// it, for the same reason Stage 3 kept `check_ins_gymId_checkedInAt_idx`:
  /// `locationId` sits between the two columns an all-branches ledger scan uses, so
  /// it is not a prefix, and "All locations" is the console's default state.
  @@index([gymId, locationId, createdAt])
  @@map("stock_movements")
}

/// A personal-training package plan a gym curates from the staff console (T4.11).
/// A gym-scoped catalogue record — the purchasable PT offerings (e.g. "10
/// sessions", "Monthly unlimited") the gym sells, deliberately distinct from a
/// retail {@link Product}. One gym can have many plans; `gymId` is the isolating
/// tenant key the scoped Prisma client constrains every query to.
///
/// `priceAmount` is the price in the currency's MINOR units (cents/tetri), with
/// `currency` an ISO-4217 code. `billingInterval` is the billing cadence
/// (`MONTH`/`YEAR` recurring, `ONE_TIME` one-off). `sessionCount` is the number of
/// PT sessions the plan grants, or `null` for unlimited access. `features` is a
/// flat, ordered list of short perk labels rendered as bullets. `popular` flags
/// the one plan that gets the brand emphasis / "Most popular" badge.
///
/// A finite-`sessionCount` plan doubles as a *credit pack / class pass* catalogue
/// entry (T8.5): purchasing it mints a {@link CreditPack} of `sessionCount` credits
/// the member spends booking classes. `creditValidityDays` is how long such a pack
/// stays usable after purchase — the purchased pack's `expiresAt` is set to
/// `now + creditValidityDays` — or `null` for a pack that never expires.
model PackagePlan {
  id                 String                 @id @default(cuid())
  gymId              String
  name               String
  description        String                 @default("")
  priceAmount        Int                    @default(0)
  currency           String                 @default("USD")
  billingInterval    PackageBillingInterval @default(MONTH)
  sessionCount       Int?
  creditValidityDays Int?
  features           String[]               @default([])
  popular            Boolean                @default(false)
  status             PackagePlanStatus      @default(ACTIVE)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  orders      Order[]
  creditPacks CreditPack[]

  @@index([gymId])
  @@map("package_plans")
}

/// A member's purchased credit pack / class pass (T8.5) — a finite balance of class
/// credits minted when the member buys a finite-`sessionCount` {@link PackagePlan}.
/// `gymId` is the isolating tenant key the scoped Prisma client constrains every
/// query to; `memberId` references the gym-scoped {@link GymMember} who owns it
/// (cascade — a pack has no meaning without its member). `planId` references the
/// catalogue {@link PackagePlan} and `orderId` the {@link Order} the purchase raised,
/// both nullable + `SetNull` so the pack — an entitlement record — survives the plan
/// or order being deleted, mirroring {@link Order}'s own `packageId`.
///
/// `name` snapshots the plan's name at purchase so the member dashboard can label
/// the pack even after the plan is renamed or removed. `totalCredits` is the credits
/// granted and `remainingCredits` the live balance (`remainingCredits >= 0` is a DB
/// check constraint added in the migration, since Prisma can't express one); booking
/// a class decrements it and an in-policy cancellation refunds it. `expiresAt` is
/// when the pack lapses (null = never); the daily expiry job flips a lapsed pack to
/// `EXPIRED`. Booking consumes packs FIFO by earliest `expiresAt` — the
/// `(gymId, expiresAt)` index backs that scan — and only while `status = ACTIVE` and
/// `remainingCredits > 0`.
model CreditPack {
  id               String           @id @default(cuid())
  gymId            String
  memberId         String
  planId           String?
  orderId          String?          @unique
  name             String
  totalCredits     Int
  /// @counter
  remainingCredits Int
  expiresAt        DateTime?
  status           CreditPackStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  gym      Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member   GymMember    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  plan     PackagePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  order    Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@index([gymId])
  @@index([memberId])
  @@index([gymId, memberId, status])
  @@index([gymId, expiresAt])
  @@map("credit_packs")
}

/// A recurring class definition a gym curates from the scheduling console (T5.2).
/// The template is the *rule*, not the occurrences: `rrule` is an RFC-5545 RRULE
/// string (e.g. `FREQ=WEEKLY;BYDAY=MO,WE,FR`) the instance-generation job (T5.3)
/// expands into concrete {@link ClassInstance} rows between `validFrom` and an
/// optional `validUntil` (null = open-ended). `capacity` is the default seat
/// count per occurrence (an instance may override it via `capacityOverride`);
/// `durationMinutes` fixes each occurrence's length, so an instance's `endsAt`
/// is `startsAt + durationMinutes`. `trainerId`/`locationId` are the default
/// trainer/branch — nullable, and set to null if the referenced trainer/location
/// is removed, so the template survives; `room` is free-text sub-location within
/// the branch. `color` is the calendar display colour. One gym can have many
/// templates; `gymId` is the isolating tenant key the scoped Prisma client
/// constrains every query to. The 500-char ceiling on `rrule` is enforced at the
/// DB level (see the migration's `rrule_max_len` check constraint), not in this
/// schema — Prisma cannot express a check constraint.
model ClassTemplate {
  id              String              @id @default(cuid())
  gymId           String
  title           String
  description     String              @default("")
  category        String              @default("")
  trainerId       String?
  locationId      String?
  room            String?
  capacity        Int
  durationMinutes Int
  /// The wall-clock time each occurrence starts, `"HH:MM"` on a 24-hour clock,
  /// read in the gym's own timezone (T5.14). Before this column the start time
  /// was smuggled in as `validFrom`'s time-of-day — which meant the console,
  /// whose form only collects a date, created every class at 00:00 UTC.
  /// `validFrom` now answers only "from which date is this template live".
  startTime       String              @default("09:00")
  rrule           String
  color           String              @default("#2563eb")
  /// Public URL of the class's cover image in R2 (`{gymId}/classes/…`), or null
  /// when the class has none. Referenced by the media sweep — an object no
  /// template points at is cleanup's to delete.
  imageUrl        String?
  status          ClassTemplateStatus @default(ACTIVE)
  pricingRule     ClassPricingRule    @default(FREE)
  priceMinor      Int?
  includedPlanIds String[]            @default([])
  minAttendance   Int?
  pt30Minor       Int?
  pt45Minor       Int?
  pt60Minor       Int?
  validFrom       DateTime
  validUntil      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer   Trainer?        @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instances ClassInstance[]

  @@index([gymId])
  @@index([trainerId])
  /// `(gymId, locationId)`, not a bare `(locationId)`: the tenant Prisma extension
  /// ALWAYS injects `gymId` into every `where`, so no query this codebase can issue
  /// ever filters on `locationId` alone — a locationId-only index is the wrong
  /// shape and Postgres would not use it for the branch filter.
  @@index([gymId, locationId])
  @@map("class_templates")
}

/// A gym's catalogue entry for a *kind* of class — "Boxing", "Yoga Flow" — with
/// no schedule of its own. It carries the reusable defaults a scheduled occurrence
/// inherits: `durationMinutes`, `capacity`, optional `minAttendance`, calendar
/// `color`, and the `pricingRule` (+ `priceMinor`/`includedPlanIds` for PAID /
/// INCLUDED). Staff curate types on the Class Types tab; the schedule then places
/// single {@link ClassInstance} occurrences of a type at a chosen time. `status`
/// soft-retires a type (INACTIVE) without deleting it, so its past occurrences and
/// their bookings survive. `gymId` is the isolating tenant key.
model ClassType {
  id              String           @id @default(cuid())
  gymId           String
  name            String
  description     String           @default("")
  durationMinutes Int
  capacity        Int
  minAttendance   Int?
  color           String           @default("#2563eb")
  pricingRule     ClassPricingRule @default(FREE)
  priceMinor      Int?
  includedPlanIds String[]         @default([])
  status          ClassTypeStatus  @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  gym        Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  instances  ClassInstance[]
  ptSessions PtSession[]

  @@index([gymId])
  @@map("class_types")
}

/// A single materialised occurrence of a {@link ClassTemplate} (T5.1). The
/// instance-generation job (T5.3) expands a template's `rrule` into these rows,
/// one per occurrence in the valid window. `startsAt`/`endsAt` are the resolved
/// instants; `capacityOverride` (nullable) overrides the template's `capacity`
/// for this occurrence only; `bookedCount` is a denormalised counter the booking
/// flow (T5.4) bumps atomically alongside each {@link Booking} write — never
/// derived via COUNT(*) at query time — so a card can render remaining spots
/// without a join. `detachedAt` marks an occurrence that was edited away from its
/// template (T5.8) so a later regeneration leaves it untouched. `gymId` is
/// duplicated from the template for direct tenant-scoped, time-ranged calendar
/// queries served by the `(gymId, startsAt)` index.
model ClassInstance {
  id               String         @id @default(cuid())
  gymId            String
  /// Either `templateId` (a recurring template generated this) or `classTypeId`
  /// (a single occurrence scheduled directly from a type) identifies what this
  /// class is — exactly one is set. Both are nullable so the row survives its
  /// source being removed.
  templateId       String?
  classTypeId      String?
  /// Trainer / branch / room for this occurrence. When generated from a template
  /// these mirror the template's defaults; when scheduled from a type they are the
  /// choices made at scheduling time.
  trainerId        String?
  locationId       String?
  room             String?
  startsAt         DateTime
  endsAt           DateTime
  capacityOverride Int?
  /// @counter
  bookedCount      Int            @default(0)
  status           InstanceStatus @default(SCHEDULED)
  detachedAt       DateTime?
  createdAt        DateTime       @default(now())

  gym       Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  template  ClassTemplate? @relation(fields: [templateId], references: [id], onDelete: Cascade)
  classType ClassType?     @relation(fields: [classTypeId], references: [id], onDelete: SetNull)
  trainer   Trainer?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  location  Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  bookings  Booking[]
  reviews   Review[]

  @@index([gymId, startsAt])
  @@index([templateId])
  @@index([classTypeId])
  /// Backs the branch-filtered schedule: a tenant's occurrences at one location
  /// over a date window, with the `startsAt` range index-served. `gymId` leads
  /// because the tenant extension always injects it.
  @@index([gymId, locationId, startsAt])
  @@map("class_instances")
}

/// A block on a trainer's PT calendar (PT hub). Distinct from a
/// {@link ClassInstance}: a PT session is just a trainer + a workout type at a
/// time — no member and no template. The workout type is the gym's
/// {@link ClassType} (its `name` / `color` render on the calendar card); it is
/// optional so a type can be deleted without erasing the session's history
/// (`onDelete: SetNull`). `endsAt` is `startsAt + durationMinutes` resolved at
/// creation. `status` reuses the class {@link InstanceStatus} lifecycle
/// (SCHEDULED → COMPLETED, or CANCELED). `gymId` is the isolating tenant key the
/// scoped Prisma client constrains every query to.
model PtSession {
  id          String         @id @default(cuid())
  gymId       String
  trainerId   String
  classTypeId String?
  /// **The branch this session RUNS AT.** A single FK, not the coach's assignment
  /// set: a session is one hour at one door, and reaching it through
  /// {@link LocationStaff} would leave "where is this" ambiguous for exactly the
  /// coaches who cover two sites — the only ones worth asking about.
  ///
  /// Before Stage 6 this model reached a branch through NOTHING. `gymId` and
  /// `trainerId` were the whole of it, and `Trainer` had no location either, so
  /// the roadmap's exemption register lists three surfaces as gym-wide "unblocked
  /// by Stage 6" for this one reason: the `ptSessionsOverTime` series on the
  /// dashboard's Classes tab, the pt-sessions report, and the trainer-performance
  /// report, whose ranking ADDS a filterable class column to an unfilterable PT
  /// one and would otherwise order the table from two populations.
  ///
  /// This is a figure about a PLACE — a room was occupied for an hour — so it gets
  /// a column of its own rather than an attribution hop, the same outcome
  /// {@link CheckIn.locationId} reached in Stage 3 and for the same reason. It is
  /// NOT resolved through the trainer's base branch: a coach based at the flagship
  /// who covers a Tuesday at the satellite delivered that hour at the satellite,
  /// and attributing it to where they are on the books is how utilisation figures
  /// stop reconciling with occupancy.
  ///
  /// Nullable on the same expand/contract terms as Stages 0–5. `SetNull` on
  /// delete: closing a branch must not erase the coaching it hosted.
  locationId  String?
  startsAt    DateTime
  endsAt      DateTime
  status      InstanceStatus @default(SCHEDULED)
  notes       String         @default("")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer   Trainer    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  classType ClassType? @relation(fields: [classTypeId], references: [id], onDelete: SetNull)
  /// The branch this session runs at — see {@link PtSession.locationId}.
  location  Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([gymId, trainerId, startsAt])
  /// Kept, not replaced. `(classTypeId)` is a bare single column and therefore the
  /// wrong shape for any QUERY this codebase can issue — the tenant extension always
  /// injects `gymId` — but it does not exist for a query: `classType` is
  /// `onDelete: SetNull`, and without it retiring a workout type sequentially scans
  /// every PT session in the database to find the referencing rows. It serves the
  /// constraint, so the roadmap's "a bare index is the wrong shape" rule does not
  /// reach it.
  @@index([classTypeId])
  /// One branch's PT calendar, in time order — and the index the three gym-wide
  /// exemptions above were waiting on. `gymId` leads because the tenant extension
  /// injects it; `startsAt` trails so a branch's sessions come back already ordered
  /// for the calendar and the utilisation buckets. It ADDS to
  /// `(gymId, trainerId, startsAt)` rather than replacing it: that one answers a
  /// single coach's diary, its second column is `trainerId`, and neither composite
  /// is a prefix of the other.
  @@index([gymId, locationId, startsAt])
  @@map("pt_sessions")
}

/// A member's reservation against a {@link ClassInstance} (T5.1). `status` tracks
/// the lifecycle (booked → attended/no-show, waitlisted → booked when a seat
/// frees, or canceled); `waitlistPosition` orders the queue while `WAITLIST`.
/// `idempotencyKey` is unique so a retried booking request can't create a second
/// row. A member holds at most one non-canceled booking per occurrence: the
/// partial unique index `(classInstanceId, memberId) WHERE status != 'CANCELED'`
/// — added in the migration SQL, as Prisma can't express a partial index —
/// enforces it while still allowing a re-book after cancelling. `memberId`
/// references the gym-scoped {@link GymMember}, matching this row's `gymId`. The
/// booking *logic* (and the atomic `bookedCount` bump on insert) lands in T5.4;
/// this is schema only.
model Booking {
  id               String        @id @default(cuid())
  gymId            String
  classInstanceId  String
  memberId         String
  status           BookingStatus @default(BOOKED)
  /// @counter
  waitlistPosition Int?
  /// The {@link CreditPack} a class credit was drawn from to hold this seat (T8.5),
  /// or `null` when the seat was covered by an entitling subscription (no credit
  /// spent) or predates credit packs. Recorded so an in-policy cancellation can
  /// refund the credit to the exact pack it came from; `SetNull` so the booking
  /// survives the pack being deleted. Only a confirmed (`BOOKED`) seat ever charges
  /// a credit — a waitlist entry holds no seat.
  creditPackId     String?
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())

  gym           Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  member        GymMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  creditPack    CreditPack?   @relation(fields: [creditPackId], references: [id], onDelete: SetNull)

  @@index([classInstanceId, status])
  @@index([gymId])
  @@index([memberId])
  @@index([creditPackId])
  @@map("bookings")
}

/// A member's star rating (1–5) + optional written review of a class occurrence
/// and the trainer who led it (T5.12). A review may only be posted by a member
/// who *attended* the occurrence — the service asserts an `ATTENDED`
/// {@link Booking} for the same `(memberId, classInstanceId)` before accepting —
/// and at most once per occurrence: the unique `(memberId, classInstanceId)`
/// makes a second submission a `409`. `trainerId` is denormalised from the
/// occurrence's template at write time so a trainer's reviews can be listed
/// without walking instance→template, and is `SetNull` (the review survives the
/// trainer / occurrence being deleted, like the audit trail). `status` is the
/// soft-moderation flag a manager flips to `HIDDEN`; only `VISIBLE` rows feed the
/// trainer's aggregate `rating`. `gymId` is the isolating tenant key the scoped
/// Prisma client constrains every query to.
model Review {
  id              String       @id @default(cuid())
  gymId           String
  memberId        String
  trainerId       String?
  classInstanceId String?
  rating          Int
  comment         String?
  status          ReviewStatus @default(VISIBLE)
  createdAt       DateTime     @default(now())

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        GymMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer       Trainer?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  classInstance ClassInstance? @relation(fields: [classInstanceId], references: [id], onDelete: SetNull)

  @@unique([memberId, classInstanceId])
  @@index([gymId])
  @@index([trainerId, status])
  @@map("reviews")
}

/// Rotating refresh-token record for session management. Tokens are persisted
/// hashed (never plaintext); `familyId` groups a rotation lineage so a reused
/// (already-rotated) token can be detected and the whole family revoked.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  deviceFingerprint String?
  familyId          String
  revokedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A pending invitation for someone to join a gym's staff (T4.7). Created from the
/// staff console (`POST /staff/invite`), it carries the address invited, the
/// {@link Role} they will hold once they accept, and a single-use `token` the
/// emailed accept link (`GET /auth/accept-invite`) resolves. `expiresAt` bounds
/// the link's life (7 days); `usedAt` is stamped when the invite is redeemed —
/// after which it can never be redeemed again (single-use). A revoked invite is
/// simply deleted. `email` is stored normalised (lower-case) so an invite matches
/// the address regardless of the casing it was typed in. Distinct from a
/// {@link GymMember}, which is the membership the redemption actually creates.
model StaffInvite {
  id        String    @id @default(cuid())
  gymId     String
  email     String
  role      Role
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("staff_invites")
}

/// A storefront purchase (T7.1) — the order the public purchase wizard's final
/// step (T3.10) creates and the success page reads back. `gymId` is the isolating
/// tenant key the scoped Prisma client constrains every query to. An order is
/// raised for the package chosen in the wizard: `packageId` references the
/// {@link PackagePlan} and `locationId` the {@link Location} branch (both nullable
/// and `SetNull` so the order — an accounting record — survives the catalogue
/// entry being deleted). The buyer is either a signed-in {@link GymMember}
/// (`memberId`, `SetNull` so the order outlives the membership) or a guest, whose
/// contact details land in `customerName` / `customerEmail` (email normalised
/// lower-case, matching auth) — exactly one identifies who the order is for.
/// `total` is the order total in the currency's MINOR units (cents/tetri) so no
/// float rounding crosses the wire, with `currency` an ISO-4217 code; it is a
/// denormalised sum of the {@link OrderItem} lines, kept in step at write time so
/// the confirmation renders without re-aggregating. `status` tracks the lifecycle
/// (see {@link OrderStatus}); payment is captured via the related {@link Payment}.
model Order {
  id              String      @id @default(cuid())
  gymId           String
  packageId       String?
  locationId      String?
  memberId        String?
  /// Guest buyer's name (step 3 of the wizard); null for a signed-in member.
  customerName    String?
  /// Guest buyer's email, normalised lower-case so guest checkout and a later
  /// sign-in resolve to the same identity; null for a signed-in member.
  customerEmail   String?
  total           Int         @default(0)
  currency        String      @default("USD")
  status          OrderStatus @default(PENDING)
  /// How the order is fulfilled (T7.10): `PICKUP` from the `location` branch, or
  /// `DELIVERY` to `deliveryAddress` by the gym's in-house courier. Defaults to
  /// `PICKUP` so orders predating the choice (POS sales, the package wizard) read
  /// as collected-at-desk.
  fulfillment     Fulfillment @default(PICKUP)
  /// The free-text destination for a `DELIVERY` order; null for a `PICKUP` (which
  /// names a `locationId` instead). Captured at checkout and shown to staff so the
  /// in-house courier knows where to take the order.
  deliveryAddress String?
  /// The staff member who rang this sale, as a gym-scoped {@link GymMember} rather
  /// than a cross-gym `User` — "sales by staff member" is a question about this
  /// gym's roster, and one person may hold staff roles at several gyms.
  ///
  /// Null is the normal state for a sale nobody rang: the member-facing purchase
  /// wizard and the online shop are self-serve, so attributing them to a staff
  /// member would invent a seller. It is also null for every POS sale recorded
  /// before this column existed, which is why the report has to treat "unknown"
  /// as its own bucket rather than as a zero.
  soldById        String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  gym            Gym                @relation(fields: [gymId], references: [id], onDelete: Cascade)
  package        PackagePlan?       @relation(fields: [packageId], references: [id], onDelete: SetNull)
  location       Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  member         GymMember?         @relation("OrderBuyer", fields: [memberId], references: [id], onDelete: SetNull)
  /// `SetNull`, not `Cascade`: a staff member leaving the gym must never delete
  /// the sales they rang, the same way `member` keeps the order when a membership
  /// is purged.
  soldBy         GymMember?         @relation("OrderSeller", fields: [soldById], references: [id], onDelete: SetNull)
  items          OrderItem[]
  payment        Payment?
  refunds        Refund[]
  statusEvents   OrderStatusEvent[]
  creditPack     CreditPack?
  invoices       Invoice[]
  /// The stock this order moved — `SALE` rows at checkout, `REFUND_RESTOCK` rows
  /// when it is refunded. Was a relation-less `StockMovement.orderId` scalar until
  /// Stage 4 of multi-branch.
  stockMovements StockMovement[]

  @@index([gymId])
  @@index([memberId])
  @@index([packageId])
  /// Backs the admin order roster (T7.9): a tenant's orders scanned newest-first,
  /// optionally narrowed by status, with the `createdAt` ordering index-served.
  @@index([gymId, createdAt])
  /// Backs the sales-by-staff report: a tenant's sales for a date window grouped
  /// by seller, served from the index instead of scanning every order in the gym.
  @@index([gymId, soldById, createdAt])
  /// The branch-filtered twins of `(gymId, createdAt)` and the status roster.
  /// Adding `locationId` to the existing indexes would not do — a branch filter
  /// on `(gymId, createdAt)` degrades to an index scan plus a heap filter — so
  /// these are composite replacements, not extensions.
  @@index([gymId, locationId, createdAt])
  @@index([gymId, locationId, status])
  @@map("orders")
}

/// One priced line on an {@link Order} (T7.1) — the purchased package, plus any
/// discount / fee adjustments the API itemises. `label` is the human-readable
/// description and `amount` the line value in the order currency's MINOR units
/// (negative for a discount) so the success page can render a breakdown that sums
/// to the order's `total` without re-deriving it. Lines cascade-delete with their
/// order; this row carries no `gymId` of its own — it is reached only through the
/// already tenant-scoped order.
model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  label            String
  amount           Int
  /// Composite wire reference of the purchased variant — `"<productId>:<variantIndex|base>"`,
  /// the same shape {@link CartItem} uses (variants have no row id of their own; they
  /// live in {@link Product} `variants` JSON). Recorded at sale time so an admin refund
  /// (T7.9) can restock the exact sold positions. Null for a non-product line — a
  /// promo / discount adjustment, or a POS line whose source variant wasn't captured.
  productVariantId String?
  /// Units sold on this line, so a restock returns the right quantity. Defaults to 1
  /// for the package / adjustment lines that predate per-line quantities.
  qty              Int      @default(1)
  /// The service sold on this POS line (Services catalogue). Null for a product /
  /// plan / adjustment line. `SetNull` so an archived-then-purged service never
  /// deletes a sale.
  serviceId        String?
  createdAt        DateTime @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([serviceId])
  @@map("order_items")
}

/// An audit row for one {@link Order} status transition (T7.9). Written inside the
/// same transaction as the status change it records, so the order's lifecycle is
/// reconstructable from an append-only log rather than guessed from the current
/// `status`. `GET /orders/:id` projects these as the detail page's status timeline,
/// which is therefore generated (never directly editable). `actor` names the staff
/// user who caused the transition, null for a system / customer-driven change (e.g.
/// the online checkout opening a `PENDING` order). Carries no `gymId` of its own —
/// reached only through the already tenant-scoped order — and cascade-deletes with it.
model OrderStatusEvent {
  id      String      @id @default(cuid())
  orderId String
  status  OrderStatus
  /// When the transition happened — named `at` to match the wire `statusTimeline`.
  at      DateTime    @default(now())
  /// Staff user id who caused the transition; null for a system/customer change.
  actor   String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

/// A refund issued against an {@link Order}'s {@link Payment} from the admin order
/// management console (T7.9). Append-only: a payment may accrue several partial
/// refunds, each one row, and the running sum is mirrored on `Payment.refundedAmount`
/// so the next refund can be validated (`amount <= payment.amount - refundedAmount`,
/// else `422 EXCEEDS_PAID_AMOUNT`) without re-summing. `amount` is in the order
/// currency's MINOR units; `reason` is the operator's note; `restockItems` records
/// whether the refund returned the sold variants to stock (cleared when the goods
/// were damaged). `gymId` is duplicated from the order for direct tenant-scoped
/// reporting, mirroring {@link Payment}. Cascade-deletes with its order or gym.
model Refund {
  id            String   @id @default(cuid())
  gymId         String
  orderId       String
  paymentId     String
  /// The branch this reversal belongs to — denormalised from `order.locationId`
  /// at write time, exactly as {@link Payment.locationId} is, and for the same
  /// reason: a relation filter through `order` cannot use an index and the
  /// refunds report runs it in a loop.
  ///
  /// It is deliberately the ORDER's branch and not "wherever the refund was
  /// processed". A refund reverses a specific taking; if the reversal were
  /// attributed to the desk that keyed it, a customer refunded at the other site
  /// would leave the original branch showing revenue it no longer holds and the
  /// other showing a negative it never earned. Netting takings against refunds is
  /// the whole point of the figure, so both halves must land in the same bucket.
  /// This also means the pair still PARTITIONS the gym — the property the
  /// attribution rule rests on.
  ///
  /// Frozen at write time, like its payment: a past reversal does not move
  /// because a record about it later does.
  locationId    String?
  amount        Int
  reason        String
  restockItems  Boolean  @default(true)
  /// The staff member who issued this refund.
  ///
  /// It belongs on the refund, not on the order. A payment may accrue several
  /// partial refunds, and the order-level `REFUNDED` status event is written only
  /// once the capture is fully reversed — so its `actor` can name at most one
  /// operator per order, and names none at all until the last partial lands. The
  /// refunds-detail report needs the operator per line, which is here.
  ///
  /// Null for refunds issued before this column existed, and for any future
  /// system-initiated reversal with no operator behind it.
  processedById String?
  createdAt     DateTime @default(now())

  gym         Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment     Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  /// `SetNull` for the same reason as `Order.soldBy`: losing the staff row must
  /// not erase the refund it explains.
  processedBy GymMember? @relation(fields: [processedById], references: [id], onDelete: SetNull)
  /// `SetNull`, never `Cascade`: closing a branch must not delete the reversals it
  /// issued — least of all while leaving the payments they offset behind, which
  /// would inflate that branch's historical takings.
  location    Location?  @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([gymId])
  @@index([orderId])
  @@index([paymentId])
  /// Backs the refunds-detail report: a tenant's refunds for a date window, read
  /// newest-first, without scanning every refund the gym has ever issued.
  @@index([gymId, createdAt])
  /// The branch-filtered twin of `(gymId, createdAt)`, added by Stage 5. Adds
  /// rather than replaces — see {@link Payment} for the prefix argument.
  @@index([gymId, locationId, createdAt])
  @@map("refunds")
}

/// A payment attempt against an {@link Order} (T7.1). One payment per order (the
/// unique `orderId` makes it a one-to-one), capturing the money for the purchase.
/// `amount` is in the currency's MINOR units (cents/tetri) with `currency` an
/// ISO-4217 code, mirroring the order's total at capture time. `provider` is the
/// payment provider key — `"stub"` for the MVP, whose stubbed flow returns a
/// redirect the wizard treats as "captured" (see `@fit/types` orders); the real
/// provider integration (T8.8) sets a concrete key and a `providerRef` (the
/// external charge / transaction id used for reconciliation and refunds).
/// `status` tracks the charge lifecycle (see {@link PaymentStatus}). `gymId` is
/// duplicated from the order for direct tenant-scoped revenue queries.
model Payment {
  id             String        @id @default(cuid())
  gymId          String
  orderId        String        @unique
  /// The branch this taking belongs to — the drawer the money went into.
  ///
  /// A DENORMALISED copy of `order.locationId`, stamped from the order at write
  /// time. It is not new information: the money already reached a branch through
  /// `orderAtLocation` in `apps/api/src/common/location-filter.util.ts`, and this
  /// column is the same attribution — the PLACE half of the rule that file's
  /// header states — moved onto the row so it can be indexed. A relation filter
  /// (`payment.order.is.locationId`) plans as a join plus a heap filter and can
  /// never use `orders(gymId, locationId, createdAt)`; the revenue aggregates
  /// issue exactly that filter in a loop.
  ///
  /// **Copying the attribution onto the row also FREEZES it, and that is the
  /// intent.** The relation filter is live: it re-reads `orders.locationId` on
  /// every query. Today the two agree exactly — nothing in `apps/api` ever updates
  /// an order's branch after checkout, and both columns are `SetNull`, so a
  /// retired branch nulls them together. The divergence is prospective: if an
  /// order is ever re-attributed, the money already taken for it will no longer
  /// silently move with it. That is the correct outcome. **A past event does not
  /// move because a record about it later does** — this payment was taken at a
  /// till, at a place, on a date, and the takings belong to the branch that earned
  /// them. (`Invoice.locationId` is where this stops being hypothetical: a member
  /// CAN be transferred, and their old invoices deliberately stay put.)
  ///
  /// Null is not a routine state — the Stage 5 migration backfills every row from
  /// its order — but it is reachable two ways: the order was already unattributed
  /// (a branch retired before the backfill ran), or this branch is retired later.
  /// Such a payment falls out of every per-branch figure while staying in the
  /// gym-wide roll-up, which is the same residual class the reports'
  /// `NO_LOCATION_LABEL` bucket exists to catch.
  locationId     String?
  amount         Int
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  /// How the sale was settled — the staff-facing channel the end-of-day cash
  /// reconciliation (T7.5) groups by. Defaults to `CARD` so the online purchase
  /// wizard's stub charge (T3.10) lands as a card sale without passing it; the POS
  /// (T7.3) sets it explicitly to the operator's choice.
  method         PaymentMethod @default(CARD)
  /// Payment provider key — `"stub"` for the MVP, a concrete provider once T8.8
  /// lands the real integration.
  provider       String        @default("stub")
  /// External charge / transaction id from the provider, for reconciliation and
  /// refunds; null for the stub (no upstream record).
  providerRef    String?
  /// Running total already refunded against this capture (T7.9), in the currency's
  /// MINOR units. Starts at `0`; each admin refund claims its amount with a bounded
  /// `increment` and flips `status` to `REFUNDED` once the column reaches `amount`
  /// (a full refund). The bound rides inside the claiming statement rather than in a
  /// preceding read, so two concurrent refunds cannot both spend the same remaining
  /// net — see `docs/adr/atomic-counters.md`.
  /// @counter
  refundedAmount Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// `SetNull`, never `Cascade`: closing a branch must not delete the money it
  /// took. Same stance as every other `location` relation in this schema.
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  refunds  Refund[]

  @@index([gymId])
  /// Backs the end-of-day reconciliation (T7.5): a tenant's captured payments
  /// scanned by `createdAt` window, then grouped by `method`.
  @@index([gymId, createdAt])
  /// The branch-filtered twin of `(gymId, createdAt)`, added by Stage 5.
  ///
  /// It ADDS rather than replaces, for the reason Stage 3 gave on `check_ins`:
  /// `locationId` sits BETWEEN the two columns an all-branches query uses, so
  /// `(gymId, createdAt)` is not a prefix of this composite and an unfiltered
  /// reconciliation would have to walk every branch's slice to satisfy the time
  /// range. "All locations" is the console's default state and therefore the
  /// hotter of the two paths.
  @@index([gymId, locationId, createdAt])
  @@map("payments")
}

/// A shopping cart for the member-facing online shop (T7.7). A cart is keyed by
/// exactly one identity: `userId` for a signed-in member, or `sessionId` (an
/// anonymous `fit_cart_sid` cookie) for a guest — never both at once. On login
/// the anon cart is merged into the user's cart and deleted, so a person ends up
/// with a single cart per gym. `gymId` scopes the cart to one tenant's shop. The
/// two partial uniques `(gymId, userId)` / `(gymId, sessionId)` enforce one cart
/// per identity per gym (Postgres treats NULLs as distinct, so the unused key is
/// unconstrained). Cascade-deletes with its gym or owning user.
model Cart {
  id        String   @id @default(cuid())
  gymId     String
  /// Owning member's user id; null for an anonymous (cookie-keyed) cart.
  userId    String?
  /// Anonymous session id from the `fit_cart_sid` cookie; null once the cart is
  /// owned by a signed-in user.
  sessionId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym   Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@unique([gymId, userId])
  @@unique([gymId, sessionId])
  @@index([gymId])
  @@map("carts")
}

/// One line of a {@link Cart} (T7.7). `productVariantId` is the composite wire
/// reference `"<productId>:<variantIndex|base>"` — variants have no persistent id
/// of their own (they live as a JSON array on {@link Product}), so a line is
/// addressed by its product plus the chosen variant's array position (or `base`
/// for a product sold as-is). `qty` is the unit count. `unitPrice` is the
/// per-unit price (currency MINOR units) captured when the line was last added /
/// updated — the buyer's last-agreed price, against which checkout detects a
/// price drift (`409 PRICE_CHANGED`); the live cart view always re-prices from the
/// current product, so this is never shown, only compared. The `(cartId,
/// productVariantId)` unique makes a repeat add bump `qty` rather than duplicate
/// the line. Cascade-deletes with its cart.
model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  productVariantId String
  qty              Int
  unitPrice        Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
  @@index([cartId])
  @@map("cart_items")
}

/// Append-only record of privileged platform actions, written by the SuperAdmin
/// console (T2.12). The first use is owner impersonation: every impersonation
/// must leave exactly one row naming the actor (the SUPER_ADMIN) and the target
/// gym + impersonated user, so support access is always accountable after the
/// fact. Deliberately denormalised scalar ids (no FKs) so an audit entry
/// survives the deletion of whatever it references — the trail must outlive the
/// records it describes. `metadata` carries action-specific context as JSON.
model AuditLog {
  id        String   @id @default(cuid())
  /// Action key, e.g. `gym.impersonate` or `gym.status.update`.
  action    String
  /// The user who performed the action (the SUPER_ADMIN operator).
  actorId   String
  /// The gym the action targeted, when applicable.
  gymId     String?
  /// The user the action targeted (e.g. the impersonated owner), when applicable.
  targetId  String?
  /// Action-specific context (previous/next status, issued-token TTL, …).
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([gymId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// A recurring membership plan a gym curates from the staff console (T8.1). A
/// gym-scoped catalogue record — the renewable memberships (e.g. "Monthly",
/// "Annual unlimited") the gym sells, deliberately distinct from a one-off
/// {@link PackagePlan} (a finite PT session pack) and a retail {@link Product}.
/// One gym can have many plans; `gymId` is the isolating tenant key the scoped
/// Prisma client constrains every query to.
///
/// `priceAmount` is the per-interval price in the currency's MINOR units
/// (cents/tetri), with `currency` an ISO-4217 code. `interval` is the renewal
/// cadence (see {@link SubscriptionInterval}). `features` is a flat, ordered list of
/// short perk labels rendered as bullets; `popular` flags the one plan that gets the
/// brand emphasis / "Most popular" badge — both mirroring {@link PackagePlan}. A
/// {@link Subscription} snapshots this plan's price/interval at enrolment, so editing
/// or deactivating the plan never retroactively re-prices an existing subscriber.
model SubscriptionPlan {
  id                  String                 @id @default(cuid())
  gymId               String
  name                String
  description         String                 @default("")
  priceAmount         Int                    @default(0)
  currency            String                 @default("USD")
  interval            SubscriptionInterval   @default(MONTH)
  features            String[]               @default([])
  popular             Boolean                @default(false)
  status              SubscriptionPlanStatus @default(ACTIVE)
  /// Freeze policy (T8.4): the maximum number of days a member may freeze (pause)
  /// a subscription on this plan within a single billing period. The freeze flow
  /// rejects a request that would push the period's cumulative frozen days over
  /// this cap (`422 EXCEEDS_FREEZE_ALLOWANCE`). `0` disables freezing entirely.
  freezeDaysPerPeriod Int                    @default(30)
  /// Class-credit allowance the plan grants each billing period (T5.2). A finite
  /// value caps how many classes a subscriber may book per period (the plan's
  /// "N classes / period"); `0` means *unlimited* — the plan entitles the member
  /// to every class with no per-period cap, which is the recurring-membership
  /// default. A catalogue attribute surfaced on the billing-plans board and the
  /// member-facing plan card; enforcement of the cap is future billing work.
  includedCredits     Int                    @default(0)
  /// Free-trial length in whole days (T5.6). A value `> 0` means a member enrolling
  /// on this plan starts in `TRIAL` (see {@link SubscriptionStatus}) for that many
  /// days before the first charge; `0` (the default) disables the trial — enrolment
  /// charges/activates immediately as before. Snapshotted price/currency/interval on
  /// the {@link Subscription} apply once the trial converts, so a later plan edit
  /// never re-prices a mid-trial member.
  trialDays           Int                    @default(0)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]

  @@index([gymId])
  @@map("subscription_plans")
}

/// A member's enrolment in a recurring {@link SubscriptionPlan} (T8.1) — the
/// renewable membership the billing job charges each period. `gymId` is the
/// isolating tenant key the scoped Prisma client constrains every query to.
/// `memberId` references the gym-scoped {@link GymMember} who holds the subscription
/// (cascade — a subscription has no meaning without its member). `planId` references
/// the {@link SubscriptionPlan} and is `SetNull` so the subscription — a billing
/// record — survives the catalogue plan being deleted, mirroring {@link Order}'s
/// `packageId`.
///
/// `priceAmount` / `currency` / `interval` are snapshotted from the plan at enrolment
/// (the buyer's agreed terms), so a later plan edit never re-prices an active
/// subscriber. `currentPeriodStart` / `currentPeriodEnd` bound the paid period; the
/// billing job advances them by `interval` on each successful renewal and reads
/// `currentPeriodEnd` to find what is due to charge. `cancelAtPeriodEnd` marks a
/// member-requested cancellation that lets the paid period run out before flipping
/// `status` to `CANCELED`; `canceledAt` stamps when a cancellation was actioned.
/// `provider` / `providerRef` mirror {@link Payment}: `"stub"` for the MVP, a concrete
/// gateway + external subscription id once the real integration (T8.8) lands.
/// `status` tracks the lifecycle (see {@link SubscriptionStatus}).
///
/// A member holds at most one live (`ACTIVE` / `PAST_DUE` / `FROZEN`) subscription
/// per gym: the partial unique `(gymId, memberId) WHERE status IN
/// ('ACTIVE','PAST_DUE','FROZEN')` — added in the migration SQL, as Prisma can't
/// express a partial index — enforces it while still allowing a fresh subscription
/// after a previous one is canceled/expired. `FROZEN` is in the live set (T8.3): a
/// paused membership still occupies the slot, so a member can't enrol a second time
/// while frozen — they must resume or cancel first. The live set mirrors
/// `LIVE_SUBSCRIPTION_STATUSES` in the state machine.
model Subscription {
  id                 String               @id @default(cuid())
  gymId              String
  planId             String?
  memberId           String
  status             SubscriptionStatus   @default(ACTIVE)
  priceAmount        Int                  @default(0)
  currency           String               @default("USD")
  interval           SubscriptionInterval @default(MONTH)
  currentPeriodStart DateTime             @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean              @default(false)
  canceledAt         DateTime?
  /// Freeze/pause flow (T8.4). When the subscription is `FROZEN`, `frozenAt` is
  /// when the hold began and `frozenUntil` its scheduled auto-resume date; both are
  /// null at every other time. On resume (early via unfreeze, or auto at
  /// `frozenUntil`) the lost access is compensated by pushing `currentPeriodEnd`
  /// out by the days actually spent frozen. `freezeDaysUsed` accumulates the days
  /// committed to freezes in the current period and is checked against the plan's
  /// `freezeDaysPerPeriod` allowance; it resets when the period renews.
  frozenAt           DateTime?
  frozenUntil        DateTime?
  /// @counter
  freezeDaysUsed     Int                  @default(0)
  /// Dunning retry ladder (T5.5). The number of *scheduled retry charges* that
  /// have failed in the current past-due episode, driving the +2/+5/+7-day retry
  /// cadence: while `PAST_DUE`, the next retry lands `retryOffsetDays[paymentRetries]`
  /// days after the elapsed `currentPeriodEnd`, and once the ladder is exhausted the
  /// subscription expires. The initial (period-end) charge failure that flips a
  /// subscription `ACTIVE → PAST_DUE` is retry 0; it increments on each further
  /// failed retry and resets to 0 whenever a charge succeeds and the period renews.
  /// @counter
  paymentRetries     Int                  @default(0)
  /// Payment provider key — `"stub"` for the MVP, a concrete provider once T8.8
  /// lands the real recurring-billing integration.
  provider           String               @default("stub")
  /// External subscription id from the provider, for reconciliation and renewals;
  /// null for the stub (no upstream record).
  providerRef        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  gym      Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)
  member   GymMember         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([gymId])
  @@index([memberId])
  @@index([planId])
  /// Backs the recurring-billing job + admin roster: a tenant's subscriptions
  /// scanned by `status`, and by `currentPeriodEnd` to find what is due to charge.
  @@index([gymId, status])
  @@index([gymId, currentPeriodEnd])
  @@map("subscriptions")
}

/// A billing document minted when a subscription charge is taken (T5.9): on member
/// enrolment's first paid period, on each successful recurring renewal, and — once
/// that path lands — on a POS-linked subscription charge. It is the row
/// `GET /me/subscription` reads to render the member's billing history (previously a
/// hardcoded empty list).
///
/// `number` is the human-facing invoice reference, **sequential per gym per fiscal
/// year** (`"2026-0001"`, `"2026-0002"`, …) and unique within the gym via
/// `@@unique([gymId, number])`; `year` / `seq` are its structured parts (the
/// zero-padded `seq` within `year`). The per-`(gymId, year)` counter lives in
/// {@link InvoiceSequence} and is bumped atomically so two invoices minted for the
/// same gym in the same year can never collide or skip.
///
/// `subscriptionId` / `orderId` are the sources this invoice was raised for — a
/// recurring subscription and/or the POS order that charged it — both `SetNull` so the
/// invoice (a financial record) survives its subscription or order being deleted, and
/// both optional so a future non-subscription invoice fits the same table. `memberId`
/// is the billed member, denormalised so the member's history query
/// (`GET /me/subscription`) is a single indexed lookup without joining through the
/// subscription. `amount` is in the currency's MINOR units (cents/tetri), snapshotted
/// from the charge. `status` is the settlement state (see {@link InvoiceStatus}) —
/// `PAID` for the stub-settled MVP charges. `pdfUrl` is null until the PDF-generation
/// task (a later T8 task) renders and stores the document. `gymId` is the isolating
/// tenant key the scoped Prisma client constrains every query to.
model Invoice {
  id             String        @id @default(cuid())
  gymId          String
  subscriptionId String?
  orderId        String?
  memberId       String?
  /// The branch this invoice belongs to — denormalised from the billed
  /// **member's** home branch (`GymMember.locationId`) at issue time.
  ///
  /// **Through the member, never the order.** `orderId` is nullable and
  /// subscription billing — the recurring majority — leaves it null, so an
  /// order-based rule would attribute the one-off minority and silently drop the
  /// rest, making `outstanding` mean something different row by row. That is the
  /// PERSON half of the attribution rule in
  /// `apps/api/src/common/location-filter.util.ts`, and this column is the same
  /// rule `memberAtLocation` already applies on every read, stamped onto the row
  /// so it can be index-served instead of joined.
  ///
  /// **Here the freeze is a genuine behaviour change, and it is intended.**
  /// `GymMember.locationId` is editable — a branch move rides with the profile
  /// write (`members.service.ts`) — so the member hop is LIVE: transferring a
  /// member today silently moves their entire billing history to the new branch,
  /// retrospectively rewriting both branches' figures for months already closed.
  /// This column stops that. An invoice was issued to a member as they stood
  /// then; **a past event does not move because a person later did.** A
  /// transferred member's history stays with the branch that earned it, and only
  /// invoices issued after the move land at the new one. Recorded here as a
  /// deliberate consequence of Stage 5 rather than discovered later as a bug.
  ///
  /// Two ways a row is null. It goes null when the branch is retired
  /// (`SetNull`, below). And the Stage 5 backfill leaves it null where it had
  /// nothing to read: an invoice whose member was hard-deleted (`memberId` is
  /// `SetNull` so the financial record survives the purge), or whose member was
  /// itself unattributed. Both are exactly the rows `memberAtLocation` already
  /// drops from a branch filter while the gym-wide roll-up keeps them — the
  /// residual class its doc comment names, not a new gap.
  locationId     String?
  number         String
  year           Int
  seq            Int
  amount         Int           @default(0)
  currency       String        @default("USD")
  status         InvoiceStatus @default(PAID)
  /// The billed category (see {@link InvoiceType}). Chosen by staff on a hand-raised
  /// invoice and stamped at the source by the automatic issuers. Existing rows were
  /// backfilled from the relation that produced them.
  type           InvoiceType   @default(OTHER)
  /// Human-readable line describing what was billed (e.g. "Premium — monthly renewal"),
  /// snapshotted at issue time so a later plan rename never rewrites past invoices.
  description    String        @default("")
  /// When payment is expected. Only ever set on a `PENDING` invoice — a `PAID` one
  /// records money already taken, so it has no due date.
  dueDate        DateTime?
  /// Signed URL / key of the rendered PDF, populated by the later PDF-generation task;
  /// null until then.
  pdfUrl         String?
  /// When the invoice was raised (the charge instant). Distinct from `createdAt` so a
  /// backfilled / imported invoice can carry its true issue date.
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gym             Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  subscription    Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  member          GymMember?       @relation(fields: [memberId], references: [id], onDelete: SetNull)
  /// `SetNull`, never `Cascade`: an invoice is a financial record and outlives
  /// every relation on this row — its subscription, its order, its member and now
  /// its branch. Closing a branch must not shred its ledger.
  location        Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  serviceSessions ServiceSession[]

  /// The invoice reference is unique within its gym; the per-gym+year counter that
  /// generates it guarantees sequentiality.
  @@unique([gymId, number])
  @@index([gymId])
  @@index([subscriptionId])
  @@index([orderId])
  /// Backs the member billing-history read (`GET /me/subscription`): a member's
  /// invoices scanned newest-first.
  @@index([memberId])
  @@index([gymId, createdAt])
  /// The branch-filtered twin of `(gymId, createdAt)`, added by Stage 5. Backs the
  /// invoice roster and the `outstanding` roll-up narrowed to one branch, which
  /// until now planned as a join through `gym_members`. Adds rather than replaces
  /// — see {@link Payment} for the prefix argument.
  @@index([gymId, locationId, createdAt])
  @@map("invoices")
}

/// The per-gym, per-fiscal-year invoice-number counter backing {@link Invoice.number}
/// (T5.9). One row per `(gymId, year)`; `lastNumber` is the highest `seq` handed out
/// so far in that gym-year. A number is allocated by atomically inserting the row
/// (`lastNumber = 1`) or incrementing it (`lastNumber = lastNumber + 1`) in a single
/// `INSERT … ON CONFLICT DO UPDATE … RETURNING` statement, so concurrent charges for
/// the same gym-year serialise on the row and always receive distinct, gap-free
/// sequence numbers. Kept separate from {@link Invoice} so the hot counter update
/// contends on one narrow row rather than the invoice table, and resets naturally each
/// fiscal year (a new `year` starts a fresh row at `0001`).
model InvoiceSequence {
  gymId      String
  year       Int
  /// @counter
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@id([gymId, year])
  @@map("invoice_sequences")
}

/// Which platform marketing form a {@link PlatformLead} came from — the free-trial
/// signup or the book-a-demo request. Drives the copy of the team notification and
/// lets the pipeline of the two be reported on separately.
enum PlatformLeadType {
  TRIAL
  DEMO
}

/// An inbound sales lead captured from the platform marketing site's trial/demo
/// forms (T8.2). Deliberately **platform-level** — it belongs to no gym (a lead is
/// a prospect who does not yet have a tenant), so it carries no `gymId` and lives
/// outside the tenant-scoped model set. Persisted first so a lead is never lost
/// even when transactional email is unconfigured; the team notification email is a
/// best-effort side effect on top of the stored row.
model PlatformLead {
  id        String           @id @default(cuid())
  type      PlatformLeadType
  name      String
  email     String
  /// Gym / studio name (trial form) — absent on a demo request.
  business  String?
  /// Contact phone (demo form) — optional.
  phone     String?
  /// Free-text "what would you like to see?" (demo form) — optional.
  message   String?
  createdAt DateTime         @default(now())

  /// Newest-first lead review, optionally filtered by which form it came from.
  @@index([createdAt])
  @@index([type, createdAt])
  @@map("platform_leads")
}

// ---------------------------------------------------------------------------
// CRM (T12.2) — gym-scoped sales pipeline: leads, opportunities, activities,
// tasks. Ported from the gym-admin prototype's /crm module; every model below
// carries a `gymId` and is listed in the API's TENANT_SCOPED_MODELS so the
// scoped Prisma client isolates it automatically.
// ---------------------------------------------------------------------------

/// Lifecycle of a sales lead (T12.2): a prospect moves NEW → CONTACTED → TRIAL
/// and closes as CONVERTED (became a member — `wonReason` explains the win) or
/// LOST (`lostReason` explains the drop). Mirrors `leadStatusSchema` in
/// `@fit/types`.
enum LeadStatus {
  NEW
  CONTACTED
  TRIAL
  CONVERTED
  LOST
}

/// Where a lead came from (T12.2). A short fixed list the CRM filters and
/// reports on. Mirrors `leadSourceSchema` in `@fit/types`.
enum LeadSource {
  WALK_IN
  INSTAGRAM
  REFERRAL
  WEBSITE
}

/// Stage of an upsell opportunity on an existing member (T12.2): open stages
/// INTERESTED → PROPOSAL_SENT → DECISION_PENDING, closing as WON (`wonReason`)
/// or LOST (`lostReason`). Mirrors `opportunityStatusSchema` in `@fit/types`.
enum OpportunityStatus {
  INTERESTED
  PROPOSAL_SENT
  DECISION_PENDING
  WON
  LOST
}

/// What is being sold in an opportunity (T12.2). Mirrors
/// `opportunityTypeSchema` in `@fit/types`.
enum OpportunityType {
  MEMBERSHIP_UPGRADE
  PT_SESSIONS
  SERVICE_PACKAGE
  OTHER
}

/// Kind of CRM touchpoint logged against a lead or opportunity (T12.2).
/// `TASK_COMPLETED` rows are written automatically when a `CrmTask` is marked
/// done, so the timeline shows completed to-dos inline with calls/emails.
/// Mirrors `crmActivityTypeSchema` in `@fit/types`.
enum CrmActivityType {
  CALL
  EMAIL
  WHATSAPP
  MEETING
  NOTE
  TASK_COMPLETED
}

/// A sales lead — a prospect who is not yet a member (T12.2). Tenant-scoped by
/// `gymId`. `assignedTo` is the staff `User` who owns the follow-up (kept on
/// user delete via SetNull so the lead survives staff churn); `location` is the
/// branch the prospect is interested in. `expectedValue` is the deal size in
/// the currency's MINOR units (cents/tetri, matching `Product.priceAmount`);
/// `probability` is a 0–100 percentage — together they feed the pipeline /
/// revenue-forecast aggregations (expected = value × probability / 100 grouped
/// by `expectedCloseDate` month). `wonReason` / `lostReason` are captured when
/// the lead closes CONVERTED / LOST.
model Lead {
  id                String     @id @default(cuid())
  gymId             String
  firstName         String
  lastName          String
  phone             String     @default("")
  email             String     @default("")
  source            LeadSource
  interest          String     @default("")
  assignedToId      String?
  status            LeadStatus @default(NEW)
  locationId        String?
  followUpDate      DateTime?
  notes             String     @default("")
  expectedValue     Int        @default(0)
  expectedCloseDate DateTime?
  probability       Int        @default(0)
  lostReason        String?
  wonReason         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  gym        Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("LeadAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  location   Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  tasks      CrmTask[]

  // The leads board filters by status and lists newest-first; both are
  // gymId-prefixed so they also cover plain tenant-scoped lookups.
  @@index([gymId, status])
  @@index([gymId, createdAt])
  // The branch-filtered board: one location's pipeline, still grouped by status.
  @@index([gymId, locationId, status])
  @@map("leads")
}

/// An upsell opportunity on an existing member (T12.2) — a PT-sessions pitch, a
/// membership upgrade, etc. Tenant-scoped by `gymId`; `member` is the
/// GymMember being sold to (an opportunity dies with the membership).
/// `value` is the deal size in MINOR units and `probability` a 0–100
/// percentage (see {@link Lead} for how the aggregations use them).
/// `wonReason` / `lostReason` are captured by the explicit won/lost
/// transitions.
model Opportunity {
  id                String            @id @default(cuid())
  gymId             String
  memberId          String
  type              OpportunityType
  description       String            @default("")
  value             Int               @default(0)
  probability       Int               @default(0)
  status            OpportunityStatus @default(INTERESTED)
  assignedToId      String?
  expectedCloseDate DateTime?
  notes             String            @default("")
  lostReason        String?
  wonReason         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  gym        Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member     GymMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  assignedTo User?         @relation("OpportunityAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities CrmActivity[]
  tasks      CrmTask[]

  // The kanban groups by status; the forecast groups open deals by close month.
  @@index([gymId, status])
  @@index([gymId, expectedCloseDate])
  @@index([memberId])
  @@map("opportunities")
}

/// A CRM touchpoint (call, email, meeting, note…) logged against a lead or an
/// opportunity (T12.2) — exactly one of `leadId` / `opportunityId` is set,
/// enforced by the API's validation. Tenant-scoped by `gymId`; cascade-deleted
/// with its parent. `staffName` is snapshotted at write time (like
/// `MemberNote.authorName`) so the timeline keeps its attribution even if the
/// staff user is later deleted; `staffUserId` links back when known.
/// Append-only — an activity is never edited, so there is no `updatedAt`;
/// `occurredAt` is when the touchpoint happened (defaults to now, backdatable).
model CrmActivity {
  id            String          @id @default(cuid())
  gymId         String
  leadId        String?
  opportunityId String?
  type          CrmActivityType
  staffUserId   String?
  staffName     String
  notes         String          @default("")
  occurredAt    DateTime        @default(now())
  createdAt     DateTime        @default(now())

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  staff       User?        @relation(fields: [staffUserId], references: [id], onDelete: SetNull)

  // The dashboard's recent-activities feed reads newest-first per gym; the
  // per-record timelines read by parent.
  @@index([gymId, occurredAt])
  @@index([leadId])
  @@index([opportunityId])
  @@map("crm_activities")
}

/// A follow-up to-do on a lead or an opportunity (T12.2) — exactly one of
/// `leadId` / `opportunityId` is set, enforced by the API's validation.
/// Tenant-scoped by `gymId`; cascade-deleted with its parent. Marking a task
/// `completed` also logs a `TASK_COMPLETED` {@link CrmActivity} on the same
/// parent so the timeline reflects it.
model CrmTask {
  id            String    @id @default(cuid())
  gymId         String
  leadId        String?
  opportunityId String?
  title         String
  completed     Boolean   @default(false)
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  gym         Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([gymId, completed])
  @@index([leadId])
  @@index([opportunityId])
  @@map("crm_tasks")
}

// ---------------------------------------------------------------------------
// Automation (T12.5) — gym-scoped "when X happens, do Y" rules. Ported from the
// gym-admin prototype's /automation module. Every model below carries a `gymId`
// and is listed in the API's TENANT_SCOPED_MODELS so the CRUD reads/writes
// isolate automatically; the executor (event hooks + the time-based scanner)
// runs cross-tenant off the unscoped client with an explicit `gymId`.
// ---------------------------------------------------------------------------

/// The event a rule reacts to (T12.5). The value strings are the exact wire
/// contract the admin builder and the executor share, grouped by category in
/// `@fit/types` (`AUTOMATION_TRIGGER_CATALOG`): Members, CRM/Leads, Classes,
/// Payments, POS, Staff. Mirrors `automationTriggerTypeSchema`. Lowercase
/// snake_case (not the usual UPPER_CASE) so the enum member name *is* the wire
/// value — no mapping between DB, code and JSON.
enum AutomationTriggerType {
  // Members
  member_joined
  membership_expiring
  membership_expired
  membership_renewed
  membership_frozen
  membership_cancelled
  birthday
  no_checkin
  checkin_milestone
  plan_upgraded
  plan_downgraded
  // CRM / Leads
  lead_created
  lead_stage_changed
  lead_won
  lead_lost
  lead_no_activity
  // Classes
  class_booked
  class_cancelled_member
  class_full
  attendance_marked
  pt_session_booked
  pt_session_cancelled
  // Payments
  payment_received
  payment_failed
  invoice_overdue
  refund_issued
  // POS
  purchase_completed
  product_stock_low
  // Staff
  task_assigned
  task_completed
  timeoff_approved
}

/// What a rule does when it fires (T12.5). Mirrors `automationActionTypeSchema`;
/// lowercase-snake for the same wire-parity reason as {@link AutomationTriggerType}.
enum AutomationActionType {
  email
  sms
  push_notification
  create_task
}

/// Outcome of one {@link AutomationRun} (T12.5). A run is `QUEUED` when a match
/// is recorded, then flips to `SUCCESS` once the (currently stubbed) action is
/// dispatched, `FAILED` if dispatch threw, or `SKIPPED` when the rule matched
/// but the guard chose not to act. Mirrors `automationRunStatusSchema`.
enum AutomationRunStatus {
  QUEUED
  SUCCESS
  FAILED
  SKIPPED
}

/// A gym's automation rule (T12.5): "when `triggerType` happens, do
/// `actionType`". Tenant-scoped by `gymId`. `triggerConfig` is a small JSON bag
/// — today just `{ days?: number }` for the count/day-window triggers
/// (`membership_expiring`, `no_checkin`, `checkin_milestone`,
/// `lead_no_activity`); `actionConfig` holds the message `{ subject?, body }`.
/// `timingOffset` is one of the fixed advance/delay options
/// (`7_days_before`…`3_days_after`, or `day_of`) — stored as text because those
/// labels lead with a digit and so can't be Prisma enum identifiers; validated
/// by `automationTimingOffsetSchema`. `isTemplate` rows are the reusable
/// starting points the builder clones and never fire on their own; `createdBy`
/// is the staff user who authored it (kept on user-delete via SetNull).
model AutomationRule {
  id            String                @id @default(cuid())
  gymId         String
  name          String
  triggerType   AutomationTriggerType
  triggerConfig Json                  @default("{}")
  timingOffset  String                @default("day_of")
  actionType    AutomationActionType
  actionConfig  Json                  @default("{}")
  active        Boolean               @default(true)
  isTemplate    Boolean               @default(false)
  createdById   String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("AutomationRuleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  runs      AutomationRun[]

  // The rules list reads newest-first per gym; the executor loads a gym's
  // active rules for one trigger; the templates gallery filters by isTemplate.
  @@index([gymId, createdAt])
  @@index([gymId, active, triggerType])
  @@index([gymId, isTemplate])
  @@map("automation_rules")
}

/// One firing (or attempted firing) of an {@link AutomationRule} (T12.5) — the
/// executor's append-only log. Tenant-scoped by `gymId`; cascade-deleted with
/// its rule. `triggerType` is snapshotted so the log reads standalone even if
/// the rule is later retargeted; `entityId` / `entityType` point at what caused
/// it (a member id + `"member"`, a subscription id + `"subscription"`, …);
/// `detail` is a short human line describing the (stubbed) action taken.
model AutomationRun {
  id          String                @id @default(cuid())
  gymId       String
  ruleId      String
  triggerType AutomationTriggerType
  status      AutomationRunStatus   @default(QUEUED)
  entityId    String?
  entityType  String?
  detail      String                @default("")
  ranAt       DateTime              @default(now())

  gym  Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  // The activity log reads newest-first per gym or per rule; the scanner
  // dedupes same-day reruns by (ruleId, entityId, ranAt).
  @@index([gymId, ranAt])
  @@index([ruleId, ranAt])
  @@index([ruleId, entityId, ranAt])
  @@map("automation_runs")
}

// ---------------------------------------------------------------------------
// Marketing (T12.7) — gym-scoped campaigns, promo codes, audience segments, and
// message templates. Ported from the gym-admin prototype's /marketing module.
// Every model below carries a `gymId` and is listed in the API's
// TENANT_SCOPED_MODELS so the CRUD reads/writes isolate automatically.
// ---------------------------------------------------------------------------

/// The delivery channel a campaign or template targets (T12.7). Lowercase
/// snake-case so the enum member name *is* the wire value the admin app and API
/// share — no mapping between DB, code, and JSON. Mirrors `marketingChannelSchema`.
enum MarketingChannel {
  email
  sms
  push
}

/// A campaign's lifecycle state (T12.7). `draft` is the editable starting point;
/// `scheduled` awaits its `scheduledAt`; `sent` is a completed one-shot blast;
/// `active` / `paused` cover recurring/ongoing campaigns. Mirrors
/// `campaignStatusSchema`.
enum CampaignStatus {
  draft
  scheduled
  sent
  paused
  active
}

/// When a campaign delivers (T12.7) — `now` fires on send, `scheduled` waits for
/// `Campaign.scheduledAt`. Mirrors `campaignScheduleTypeSchema`.
enum CampaignScheduleType {
  now
  scheduled
}

/// How a promo code discounts a purchase (T12.7). `percentage` is a whole-percent
/// off (`discountValue` 1–100); `fixed` is an absolute amount off in the
/// currency's MINOR units (cents/tetri, matching `Product.priceAmount`). Mirrors
/// `promoDiscountTypeSchema`.
enum PromoDiscountType {
  percentage
  fixed
}

/// Whether a promo code is currently honoured (T12.7). `inactive` codes never
/// validate; an `active` code can still be rejected at redeem time for expiry or
/// an exhausted usage limit. Mirrors `promoStatusSchema`.
enum PromoStatus {
  active
  inactive
}

/// What a promo code may be spent on. A code is written for a purpose — "20% off
/// supplements", "a free month" — and honouring it against everything the gym
/// sells is how a drinks voucher ends up discounting an annual membership.
///
/// `all` is the deliberate opt-in to that breadth. The other three name the
/// catalogue a purchase came from: retail {@link Product}s, PT
/// {@link PackagePlan}s, and recurring {@link SubscriptionPlan}s. Mirrors
/// `promoScopeSchema`.
enum PromoScope {
  all
  products
  packages
  subscriptions
}

/// A gym's marketing campaign (T12.7): a one-shot or recurring message blast to a
/// resolved audience. Tenant-scoped by `gymId`. The audience is either a saved
/// {@link AudienceSegment} (`audienceSegmentId`) or an ad-hoc `inlineCriteria`
/// JSON bag (same shape as a segment's `criteria`); `audienceSize` snapshots the
/// resolved match count at schedule/send time and `sentCount` the number actually
/// delivered by the (stubbed) dispatch. `subject` is the optional email subject;
/// `body` the message template text. `createdBy` is the staff user who authored it
/// (kept on user-delete via SetNull).
model Campaign {
  id                String               @id @default(cuid())
  gymId             String
  name              String
  channel           MarketingChannel
  audienceSegmentId String?
  inlineCriteria    Json?
  subject           String?
  body              String               @default("")
  scheduleType      CampaignScheduleType @default(now)
  scheduledAt       DateTime?
  status            CampaignStatus       @default(draft)
  audienceSize      Int                  @default(0)
  sentCount         Int                  @default(0)
  sentAt            DateTime?
  createdById       String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  gym       Gym              @relation(fields: [gymId], references: [id], onDelete: Cascade)
  segment   AudienceSegment? @relation(fields: [audienceSegmentId], references: [id], onDelete: SetNull)
  createdBy User?            @relation("CampaignCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // The campaigns list reads newest-first per gym; the status tabs filter by it.
  @@index([gymId, createdAt])
  @@index([gymId, status])
  @@index([audienceSegmentId])
  @@map("campaigns")
}

/// A gym's discount code (T12.7), redeemable from POS/checkout. Tenant-scoped by
/// `gymId`; `code` is unique per gym (case preserved, matched case-insensitively
/// by the validate/redeem endpoints). `discountValue` is a whole percent (for
/// `percentage`) or a MINOR-unit amount (for `fixed`); `minPurchase` is the
/// optional MINOR-unit floor a cart must reach. `usageLimit` caps total
/// redemptions (null = unlimited) and `usedCount` tracks them; `expiryDate` is
/// the optional last day it validates. `status` is the manual on/off toggle.
model PromoCode {
  id            String            @id @default(cuid())
  gymId         String
  code          String
  description   String            @default("")
  discountType  PromoDiscountType
  discountValue Int
  minPurchase   Int?
  usageLimit    Int?
  /// @counter
  usedCount     Int               @default(0)
  /// What this code may be spent on; `all` honours it across the catalogue.
  appliesTo     PromoScope        @default(all)
  /// When the code starts working. `null` means "already running" — the state
  /// every existing code is in, and the one a code created for immediate use
  /// wants. Set it to schedule a campaign ahead of time.
  startsAt      DateTime?
  /// Last day the code validates; `null` never expires.
  expiryDate    DateTime?
  /// When true a member may redeem this code only once, ever — the "one per
  /// customer" offer. Enforced against {@link PromoRedemption}, not `usedCount`,
  /// which counts redemptions across everyone.
  oncePerMember Boolean           @default(false)
  status        PromoStatus       @default(active)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  gym         Gym               @relation(fields: [gymId], references: [id], onDelete: Cascade)
  redemptions PromoRedemption[]

  // One code per gym; the list reads newest-first and filters by status.
  @@unique([gymId, code])
  @@index([gymId, createdAt])
  @@index([gymId, status])
  @@map("promo_codes")
}

/// One actual use of a {@link PromoCode} — written in the same transaction as the
/// sale it discounted.
///
/// `usedCount` on the code is a running total and cannot answer "has *this*
/// member used it?", which is exactly what a one-per-customer offer turns on. The
/// ledger can, and it doubles as the record of what a campaign actually cost:
/// `discountAmount` is the money given away, in MINOR units.
///
/// `memberId` is null for a walk-in with no member record. Such a redemption is
/// still recorded — the gym gave the discount either way — but it cannot be held
/// against a person, so a `oncePerMember` code cannot be enforced for anonymous
/// buyers; the till has to identify them first.
model PromoRedemption {
  id             String   @id @default(cuid())
  gymId          String
  promoCodeId    String
  /// The member who redeemed, or `null` for an anonymous walk-in sale.
  memberId       String?
  /// The order this discounted, when the redemption came from a sale.
  orderId        String?
  /// Money discounted, in the currency's MINOR units.
  discountAmount Int
  createdAt      DateTime @default(now())

  promoCode PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  member    GymMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  // The one-per-customer guard: at most one redemption of a code per member. A
  // partial index would be tidier, but Prisma has no syntax for one, so the
  // constraint is enforced here and anonymous rows (null memberId) are exempt —
  // Postgres treats nulls as distinct in a unique index.
  @@unique([promoCodeId, memberId])
  @@index([gymId, createdAt])
  @@index([promoCodeId])
  @@map("promo_redemptions")
}

/// A saved audience filter (T12.7) — a reusable set of `criteria` (membership
/// plan, status, join-date window, last-visit recency, lifetime spend, class
/// attendance) that resolves to a list of matching {@link GymMember}s. Tenant-
/// scoped by `gymId`. `criteria` is a JSON bag validated by
/// `audienceCriteriaSchema`; the segment-preview endpoint resolves it to a live
/// match count + sample. Referenced by campaigns targeting the segment.
model AudienceSegment {
  id        String   @id @default(cuid())
  gymId     String
  name      String
  criteria  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym       Gym        @relation(fields: [gymId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([gymId, createdAt])
  @@map("audience_segments")
}

/// A reusable message template (T12.7) — a named, categorised subject/body the
/// campaign composer can drop in. Tenant-scoped by `gymId`. `channel` is the
/// medium it's written for; `subject` the optional email subject; `body` the
/// template text (supports `{{first_name}}`-style merge tokens); `category` a
/// free-text grouping label.
model MessageTemplate {
  id        String           @id @default(cuid())
  gymId     String
  name      String
  channel   MarketingChannel
  subject   String?
  body      String           @default("")
  category  String           @default("")
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId, createdAt])
  @@map("message_templates")
}

// ---------------------------------------------------------------------------
// Loyalty / points (T12.10)
// ---------------------------------------------------------------------------

/// Why a loyalty ledger entry was written (T12.10). `check_in` and `purchase`
/// are the automatic earn hooks, `signup` the join bonus, `manual` a staff
/// adjustment, and `redemption` the debit a reward redemption records. Mirrors
/// `loyaltyReasonSchema`.
enum LoyaltyReason {
  check_in
  purchase
  manual
  redemption
  signup
}

/// The category a loyalty reward belongs to (T12.10) — powers the "Redemptions
/// by reward type" report. Mirrors `loyaltyRewardTypeSchema`.
enum LoyaltyRewardType {
  pt_session
  day_pass
  guest_pass
  merchandise
  drink
  discount
  other
}

/// A redemption's fulfilment state (T12.10). `fulfilled` is the default (points
/// already debited, reward granted); `pending` awaits a staff hand-off;
/// `cancelled` has refunded the points via a compensating ledger entry. Mirrors
/// `loyaltyRedemptionStatusSchema`.
enum LoyaltyRedemptionStatus {
  pending
  fulfilled
  cancelled
}

/// One gym's loyalty program configuration (T12.10) — a single row per gym
/// (`gymId` unique). `enabled` gates every earn hook; the three integer rules
/// drive accrual (`pointsPerCheckIn` per arrival, `pointsPerCurrencyUnit` per
/// one MAJOR currency unit spent on a paid order, `signupBonus` once on join).
/// `config` holds forward-compatible extras (e.g. tier thresholds) as JSON.
model LoyaltyProgram {
  id                    String   @id @default(cuid())
  gymId                 String   @unique
  enabled               Boolean  @default(false)
  pointsPerCheckIn      Int      @default(0)
  pointsPerCurrencyUnit Int      @default(0)
  signupBonus           Int      @default(0)
  config                Json     @default("{}")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@map("loyalty_programs")
}

/// An append-only points ledger entry (T12.10). Every accrual and debit writes
/// one row; a member's balance is the `SUM(delta)` over their entries, and
/// `balanceAfter` snapshots that running total at write time for display.
/// `refId` links the entry back to its source (check-in / order / redemption id).
model LoyaltyLedgerEntry {
  id           String        @id @default(cuid())
  gymId        String
  memberId     String
  delta        Int
  reason       LoyaltyReason
  refId        String?
  balanceAfter Int
  note         String?
  createdAt    DateTime      @default(now())

  gym    Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member GymMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  // Reports read issued-vs-redeemed per gym over time; the member ledger reads
  // one member's history newest-first; the by-reason filter serves aggregations.
  @@index([gymId, createdAt])
  @@index([gymId, memberId, createdAt])
  @@index([gymId, reason])
  @@map("loyalty_ledger_entries")
}

/// A redeemable reward in a gym's catalogue (T12.10). `pointsCost` is the debit
/// a redemption applies; `stock` is an optional remaining-count (null = unlimited)
/// decremented on redeem; `active` hides retired rewards from the redeem picker.
model LoyaltyReward {
  id          String            @id @default(cuid())
  gymId       String
  name        String
  description String            @default("")
  pointsCost  Int
  type        LoyaltyRewardType @default(other)
  active      Boolean           @default(true)
  /// @counter
  stock       Int?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  gym         Gym                 @relation(fields: [gymId], references: [id], onDelete: Cascade)
  redemptions LoyaltyRedemption[]

  @@index([gymId, createdAt])
  @@index([gymId, active])
  @@map("loyalty_rewards")
}

/// A member's redemption of a reward (T12.10). `rewardName` / `rewardType` are
/// snapshotted so redemption history — and the "by reward type" report — survive
/// a reward being renamed or deleted (the FK is `SetNull` on delete). Redeeming
/// writes a paired `redemption` ledger entry for `-pointsSpent`.
model LoyaltyRedemption {
  id          String                  @id @default(cuid())
  gymId       String
  memberId    String
  rewardId    String?
  rewardName  String
  rewardType  LoyaltyRewardType
  pointsSpent Int
  status      LoyaltyRedemptionStatus @default(fulfilled)
  redeemedAt  DateTime                @default(now())

  gym    Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member GymMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward LoyaltyReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([gymId, redeemedAt])
  @@index([gymId, memberId, redeemedAt])
  @@index([gymId, rewardType])
  @@index([rewardId])
  @@map("loyalty_redemptions")
}

/// One widget a gym has chosen to show in one dashboard segment. Gym-scoped and
/// SHARED: unlike the per-user `DashboardPin` it replaces, every staff member at
/// the gym sees the same dashboard, so a manager arranging it arranges it for the
/// team.
///
/// `segment` and `widgetKey` are plain strings, not Prisma enums: the catalogue in
/// `@fit/types` (`DASHBOARD_WIDGET_CATALOG`) is the source of truth, and a row
/// naming a key the catalogue no longer defines is dropped at read time rather
/// than migrated. That keeps adding a segment or a widget a code-only change.
///
/// No rows for a `(gym, segment)` means "never configured", which reads as the
/// catalogue default — so the API refuses to store an empty selection, otherwise
/// "the owner removed everything" would be indistinguishable from it.
model DashboardWidget {
  id        String   @id @default(cuid())
  gymId     String
  /// The dashboard segment this widget sits in; validated against
  /// `configurableDashboardSegmentSchema` in `@fit/types`.
  segment   String
  /// Catalogue key, `<segment>.<name>` (e.g. `revenue.over-time`).
  widgetKey String
  /// Display order within the segment, 0-based and dense.
  position  Int
  createdAt DateTime @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@unique([gymId, segment, widgetKey])
  @@index([gymId, segment, position])
  @@map("dashboard_widgets")
}

/// A time-off request's lifecycle (T12.14). Starts `pending`; a manager
/// transitions it to `approved` or `denied`. Mirrors `timeOffStatusSchema` in
/// `@fit/types`.
enum TimeOffStatus {
  pending
  approved
  denied
}

/// An internal note logged against a staff member (T12.14) — the Staff detail
/// "Notes" tab. Distinct from {@link MemberNote} (which is about customers): this
/// is HR-style commentary about a colleague. Tenant-scoped by `gymId`; `staffId`
/// is the {@link GymMember} the note is about. `authorName` is snapshotted so the
/// attribution survives the author later changing their name or leaving;
/// `authorId` links back to the writing `User` when known.
model StaffNote {
  id         String   @id @default(cuid())
  gymId      String
  staffId    String
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime @default(now())

  gym   Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff GymMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([gymId, staffId, createdAt])
  @@map("staff_notes")
}

/// A task assigned to a staff member (T12.14) — the Staff detail "Tasks" tab.
/// `dueDate` is optional; `completed` toggles and stamps `completedAt`.
/// `assignedByName` is snapshotted like {@link StaffNote}'s author.
model StaffTask {
  id             String    @id @default(cuid())
  gymId          String
  staffId        String
  title          String
  description    String?
  dueDate        DateTime?
  completed      Boolean   @default(false)
  completedAt    DateTime?
  assignedById   String?
  assignedByName String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  gym   Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff GymMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([gymId, staffId, completed])
  @@index([gymId, dueDate])
  @@map("staff_tasks")
}

/// A staff member's time-off request (T12.14) — the Staff detail "Calendar" tab
/// and the gym-wide approval queue. `status` starts `pending`; approving/denying
/// snapshots the deciding `User` (`decidedBy*`) and `decidedAt`. `reason` is
/// optional (defaults empty).
model TimeOffRequest {
  id            String        @id @default(cuid())
  gymId         String
  staffId       String
  startDate     DateTime
  endDate       DateTime
  reason        String        @default("")
  status        TimeOffStatus @default(pending)
  decidedById   String?
  decidedByName String?
  decidedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  gym   Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff GymMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([gymId, status])
  @@index([gymId, staffId, startDate])
  @@map("time_off_requests")
}

/// One shift in a staff member's weekly schedule (T12.14) — the Staff detail
/// "Calendar" tab's weekly grid. A member's full schedule is their set of
/// `ShiftSlot` rows. `dayOfWeek` is 0 (Monday) … 6 (Sunday); `startTime` /
/// `endTime` are "HH:mm" 24-hour strings.
///
/// A shift takes ONE branch — see {@link ShiftSlot.locationId}. It is the one place
/// in this schema where a person's many-to-many work assignment
/// ({@link LocationStaff}) narrows to a single answer, and it is the reason both
/// shapes have to exist: "Nino can work at either site" and "Nino is at Saburtalo
/// on Tuesday morning" are different statements, and only the second one staffs a
/// door.
model ShiftSlot {
  id           String   @id @default(cuid())
  gymId        String
  staffId      String
  dayOfWeek    Int
  startTime    String
  endTime      String
  /// @deprecated The branch this shift used to be recorded at, as free text —
  /// **a column that looked like a branch and was not one.** Staff typed a name
  /// into it; nothing constrained it to a real {@link Location}, nothing kept it in
  /// step when a branch was renamed, nothing stopped two spellings of one site, and
  /// no query could join it back to anything. Stage 6 of multi-branch replaced it
  /// with {@link locationId}.
  ///
  /// **What survives here after the migration is EXACTLY the residual class**, and
  /// that is deliberate rather than leftover. Where the typed string resolved to
  /// one live branch of the SAME gym, `locationId` now carries the answer and this
  /// was set to NULL — keeping both would let a rename leave a stale name sitting
  /// beside a correct id, which is the drift the free text is being removed for.
  /// Where it resolved to nothing, `locationId` stayed NULL and the string was
  /// KEPT: it is the only surviving evidence of where that shift was, and deleting
  /// it to tidy the column would destroy information no backfill can reconstruct.
  ///
  /// So after Stage 6 `location IS NOT NULL` means precisely: *this string named no
  /// branch of this gym* — a typo, a room, a closed site, or a name belonging to
  /// ANOTHER GYM, which the migration refused to adopt for the same reason Stage 3
  /// refused it on `CheckIn.locationId`: a plain foreign key would have accepted
  /// it, because that location really does exist. The console can surface such a
  /// row as an unresolved label and ask someone to pick a branch. When none are
  /// left, the column goes.
  ///
  /// **Renamed in the Prisma schema and NOT in the database** (`@map("location")`,
  /// so the migration moves no data). `location` now has to mean "the branch" on
  /// this model as it does on every other one; leaving the free text holding that
  /// name while the real relation went by some decorated variant would preserve the
  /// exact ambiguity being removed. The new name also states what the value now is:
  /// a name, unresolved, and nothing more.
  ///
  /// **This does not reopen the deploy window `assignedLocationIds` is being kept
  /// open to avoid, and the difference is worth being precise about.** Dropping
  /// that column changes the DATABASE, so an old API image serving against a
  /// migrated database breaks whatever ships next. This changes only the generated
  /// CLIENT: the SQL column is untouched, an old image with an old client keeps
  /// working, and the new client ships in the same build as the call sites it
  /// renames. One is a cross-deploy hazard; this is a compile-time chore.
  ///
  /// Note for whoever does that chore: TypeScript catches only some of it.
  /// A `select: { location: true }` still compiles — it now selects the RELATION —
  /// and a `location:` key inside a `createMany` array literal escapes
  /// excess-property checking entirely, then throws `Unknown argument \`location\``
  /// at runtime. Grep for the field; do not trust a green type-check alone.
  locationName String?  @map("location")
  /// **The branch this shift is worked at.** A single FK, because a shift staffs one
  /// door — the shape argument at the top of {@link LocationStaff}, and the reason
  /// the join table is not enough on its own.
  ///
  /// This is what "who is working now, per branch" was waiting on, and why the
  /// roadmap's exemption register lists the dashboard's Staff tab as gym-wide: not
  /// because the query was slow but because the answer was a string nobody could
  /// join on.
  ///
  /// Nullable, and it will STAY nullable longer than the other Stage 6 columns: a
  /// row whose free-text name matched no branch has nothing honest to point at, and
  /// backfilling it to the gym's default would assert someone stood at a door they
  /// were never at. Unlike a check-in — which really happened, so the default is a
  /// lossy but defensible attribution — a shift is a PLAN, and a wrong plan staffs
  /// the wrong site. `SetNull` on delete, so closing a branch un-places its rota
  /// rather than deleting the record of who was rostered.
  locationId   String?
  createdAt    DateTime @default(now())

  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  staff    GymMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  /// The branch this shift is worked at — see {@link ShiftSlot.locationId}.
  location Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([gymId, staffId, dayOfWeek])
  /// "Who is working at branch X on day D" — the per-branch rota read. `dayOfWeek`
  /// trails because the rota is recurring and carries no dates, so the day is the
  /// only time key there is. ADDS to `(gymId, staffId, dayOfWeek)`, which answers
  /// one person's weekly grid and whose second column is `staffId`; neither is a
  /// prefix of the other.
  @@index([gymId, locationId, dayOfWeek])
  @@map("shift_slots")
}

/// A saved AI-agent chat session for the admin console (T12.22) — previously kept
/// in the browser's `localStorage`, now persisted server-side and scoped per gym
/// per user, so a staff member's chat history follows them across devices and
/// stays private to their own account. `id` is client-generated (a short string
/// minted by the admin UI, e.g. `s-abc-123`), not a server `cuid()` — the client
/// upserts by that id, so it is a plain `String @id` with no default. `messages`
/// is the opaque chat transcript (an array of role/content turns); the API stores
/// it as-is without validating its inner shape, leaving that to the admin client.
model AgentChatSession {
  id        String   @id
  gymId     String
  userId    String
  title     String   @db.VarChar(200)
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gym  Gym  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([gymId, userId, updatedAt])
  @@map("agent_chat_sessions")
}
