// Prisma schema for @fit/db.
//
// T2.1 — the auth / multi-tenancy core. A `User` is a single auth identity
// (email/password + OAuth). Gym-scoped roles live on `GymMember`, the join
// between `User` and `Gym`, so one user can belong to many gyms with a
// different role in each. `RefreshToken` backs rotating session refresh.
// Domain models (workouts, billing, …) hang off these and land in later tasks.
//
// Connection strings come from the environment (see packages/db/.env.example):
//   DATABASE_URL — Postgres (Railway in prod, docker-compose for local dev)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Roles a user can hold. SUPER_ADMIN is the only platform-wide role (not tied
/// to a single gym); the rest gate permissions within one GymMember.
enum Role {
  SUPER_ADMIN
  OWNER
  MANAGER
  RECEPTIONIST
  TRAINER
  MEMBER
}

/// Lifecycle of a user's membership in a gym.
enum GymMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

/// Platform-level lifecycle of a whole gym (tenant). A `SUSPENDED` gym is gated
/// at login/refresh so its staff + members can no longer obtain a session, and
/// is toggled from the SuperAdmin console (T2.12). Distinct from
/// {@link GymMemberStatus}, which is a single user's standing within one gym.
enum GymStatus {
  ACTIVE
  SUSPENDED
}

/// Lifecycle of a trainer profile within a gym (T4.4). `ACTIVE` trainers are the
/// gym's current roster (and the ones the public trainers index surfaces);
/// `INACTIVE` is the soft-deactivated state — hidden from the roster but retained
/// so the record and any links to it survive. Toggled from the staff console,
/// mirroring {@link GymMemberStatus} for members.
enum TrainerStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a location (branch) within a gym (T4.5). `ACTIVE` locations are
/// the gym's bookable branches (and the ones the public locations listing the
/// purchase wizard browses surfaces); `INACTIVE` is the soft-deactivated state —
/// hidden but retained so the record and any links to it survive. Toggled from
/// the staff console, mirroring {@link TrainerStatus} for trainers.
enum LocationStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a retail product within a gym (T4.6). `ACTIVE` products are the
/// ones the gym currently sells (and the only state a storefront would surface);
/// `INACTIVE` is the soft-deactivated state — hidden but retained so the record
/// and any links to it survive. Toggled from the staff console, mirroring
/// {@link LocationStatus} for locations.
enum ProductStatus {
  ACTIVE
  INACTIVE
}

/// Lifecycle of a personal-training package plan within a gym (T4.11). `ACTIVE`
/// plans are the ones the gym currently sells (the only state a storefront would
/// surface); `INACTIVE` is the soft-deactivated state — hidden but retained so
/// the record and any links to it survive. Toggled from the staff console,
/// mirroring {@link ProductStatus} for products.
enum PackagePlanStatus {
  ACTIVE
  INACTIVE
}

/// How a personal-training package plan is billed (T4.11). `MONTH`/`YEAR` are
/// recurring memberships; `ONE_TIME` is a single charge (a session pack or a day
/// pass). The admin form and the storefront card surface a per-interval suffix
/// for recurring plans and none for one-off purchases.
enum PackageBillingInterval {
  MONTH
  YEAR
  ONE_TIME
}

/// Lifecycle of a recurring class template (T5.1). `ACTIVE` templates are the
/// ones the instance-generation job (T5.3) materialises occurrences from;
/// `PAUSED` keeps the definition but stops generating new instances (existing
/// instances are untouched). Toggled from the class-scheduling console (T5.2).
/// Distinct from {@link InstanceStatus}, the per-occurrence lifecycle.
enum ClassTemplateStatus {
  ACTIVE
  PAUSED
}

/// Lifecycle of a single materialised class occurrence (T5.1). `SCHEDULED` is a
/// bookable future occurrence; `CANCELED` was called off (its seats released);
/// `COMPLETED` is in the past and attendance-tracked. The instance-generation
/// job only ever creates `SCHEDULED` rows; the other states are transitions
/// applied later by the scheduling / attendance flows.
enum InstanceStatus {
  SCHEDULED
  CANCELED
  COMPLETED
}

/// Lifecycle of a member's booking against a class occurrence (T5.1). `BOOKED`
/// holds a confirmed seat; `WAITLIST` is queued (ordered by `waitlistPosition`)
/// for a freed seat; `ATTENDED`/`NO_SHOW` are post-class attendance outcomes;
/// `CANCELED` released the seat. The partial unique index on
/// (classInstanceId, memberId) excludes `CANCELED`, so a member holds at most
/// one live booking per occurrence yet can re-book after cancelling.
enum BookingStatus {
  BOOKED
  WAITLIST
  ATTENDED
  NO_SHOW
  CANCELED
}

/// Moderation state of a member {@link Review} (T5.12). A review is `VISIBLE` the
/// moment it is posted; a manager can soft-moderate an abusive one to `HIDDEN`
/// (never editing its content). Only `VISIBLE` reviews count toward a trainer's
/// public aggregate rating, so hiding one recomputes (and lowers) that average.
enum ReviewStatus {
  VISIBLE
  HIDDEN
}

/// The OS of a registered push-notification device (T6.10). Mirrors the wire
/// `DevicePlatformValue` (`ios` / `android`) in `@fit/types`; the API maps the
/// lowercase wire value to this enum on the way in.
enum DevicePlatform {
  IOS
  ANDROID
}

/// Lifecycle of a storefront {@link Order} (T7.1). `PENDING` is the freshly
/// created, not-yet-paid order the purchase wizard opens; `PAID` is the terminal
/// "payment captured" state the success page confirms; `CANCELLED` is an
/// abandoned / failed attempt. Mirrors the lowercase wire `orderStatusSchema`
/// (`pending` / `paid` / `cancelled`) in `@fit/types`; the API maps between the
/// two on the boundary, the same way {@link DevicePlatform} mirrors its wire enum.
enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

/// Lifecycle of a {@link Payment} attempt against an order (T7.1). `PENDING` is a
/// freshly created charge awaiting capture; `CAPTURED` is settled money (the
/// transition that flips its order to `PAID`); `FAILED` is a declined / errored
/// attempt; `REFUNDED` is a previously captured charge reversed. The MVP only
/// ever creates `CAPTURED` rows via the payment stub (see `@fit/types` orders);
/// the other states exist for the real provider integration (T8.8).
enum PaymentStatus {
  PENDING
  CAPTURED
  FAILED
  REFUNDED
}

/// How a sale was settled (T7.3 / T7.5) — the staff-facing settlement channel the
/// POS operator chose. `CASH` is tendered at the desk, `CARD` a terminal / online
/// card charge, `MEMBER_ACCOUNT` a charge to the member's house account. This is
/// deliberately separate from a {@link Payment} `provider` (the gateway key, e.g.
/// `"pos"` / `"stub"`): a `CARD` sale may flow through any provider, and `CASH` /
/// `MEMBER_ACCOUNT` never touch one. It is the dimension the end-of-day cash
/// reconciliation (T7.5) groups the day's takings by. Mirrors the `paymentMethod`
/// wire enum in `@fit/types` (lower-snake there, UPPER here as Prisma enums are).
enum PaymentMethod {
  CASH
  CARD
  MEMBER_ACCOUNT
}

/// A physical gym / tenant. The top-level entity most other records hang off.
/// `ownerId` references the owning User (set during provisioning, T2.11); kept
/// as a plain scalar to avoid a second User↔Gym relation alongside GymMember.
model Gym {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  ownerId         String?
  /// The user who provisioned the gym (T2.11). Equals `ownerId` for owner
  /// self-signup, but distinct when a SUPER_ADMIN creates a gym on an owner's
  /// behalf. Nullable for rows that predate the column (seed/legacy).
  createdByUserId String?
  status          GymStatus @default(ACTIVE)
  /// Gym settings (T4.8): brand (logo + colours), locale (language, currency,
  /// timezone), default business hours, and notification sender. Stored as a
  /// single JSON blob validated by `gymSettingsStoredSchema` in `@fit/types`;
  /// the gym's display name stays on `name` (the single source of truth) and is
  /// surfaced as `brand.name`. Null until the owner first saves settings.
  settings        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  members        GymMember[]
  trainers       Trainer[]
  locations      Location[]
  products       Product[]
  packagePlans   PackagePlan[]
  staffInvites   StaffInvite[]
  classTemplates ClassTemplate[]
  classInstances ClassInstance[]
  bookings       Booking[]
  reviews        Review[]
  orders         Order[]
  payments       Payment[]

  @@index([ownerId])
  @@map("gyms")
}

/// An application user. Holds the auth identity (password hash + OAuth subject
/// ids). Gym-scoped roles live on GymMember, not here, so a user can belong to
/// N gyms with a different role in each.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String?
  /// Optional contact phone, captured/edited from the staff console member
  /// management (T4.3). A user attribute (alongside name/email) rather than a
  /// per-gym one, so it travels with the person across the gyms they belong to.
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  googleId        String?   @unique
  appleId         String?   @unique
  /// Platform-wide SUPER_ADMIN flag. SUPER_ADMIN is *not* a gym-scoped role, so
  /// it lives on the user rather than as a GymMember row: a flagged user's
  /// session resolves to `role = SUPER_ADMIN` with no gym (`gymId = null`).
  /// Bootstrapped via `fit admin grant` (and the dev seed); never set by signup.
  isSuperAdmin    Boolean   @default(false)
  /// Monotonic session-invalidation counter. Stamped into every access token's
  /// `tokenVersion` claim at issuance; bumping it (e.g. on a forced global
  /// logout / credential change) lets all outstanding sessions be invalidated
  /// at the next refresh without tracking each access token individually.
  tokenVersion    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships   GymMember[]
  refreshTokens RefreshToken[]
  pushTokens    PushToken[]

  @@map("users")
}

/// A registered device for Expo push delivery (T6.10). One row per
/// (user, device): the member app registers its Expo push `token` on login and
/// re-registers when the token rotates (app upgrade), keyed by a stable
/// `deviceId` so a rotation updates in place rather than accumulating rows. Not
/// gym-scoped — a push token belongs to the *person*, independent of which gyms
/// they are a member of — so it hangs off User (cascade-deleted with the user)
/// rather than GymMember, and the registration endpoints resolve the owner from
/// the session. Logout (and an unregister) deletes the row.
model PushToken {
  id        String         @id @default(cuid())
  userId    String
  /// Stable per-install device id minted on the client and persisted there; the
  /// `(userId, deviceId)` upsert key.
  deviceId  String
  /// The Expo push token (`ExponentPushToken[…]`) delivery targets.
  token     String
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
  @@map("push_tokens")
}

/// Join table between User and Gym carrying the user's role and status within
/// that gym. The composite unique on (userId, gymId) enforces one membership
/// per user per gym while still allowing N gyms per user.
model GymMember {
  id       String          @id @default(cuid())
  userId   String
  gymId    String
  role     Role            @default(MEMBER)
  status   GymMemberStatus @default(ACTIVE)
  joinedAt DateTime        @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gym      Gym       @relation(fields: [gymId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]
  orders   Order[]

  @@unique([userId, gymId])
  @@index([gymId])
  @@map("gym_members")
}

/// A trainer profile a gym curates from the staff console (T4.4). A gym-scoped
/// content record — name, headline, bio, photo, specialties — the gym manages
/// for its public trainers index (T3.6), deliberately distinct from a
/// `TRAINER`-role {@link GymMember} (which is an auth identity / login). One gym
/// can have many trainers; `gymId` is the isolating tenant key the scoped Prisma
/// client constrains every query to. `photoUrl` is the public URL of the headshot
/// uploaded to R2 (see the storage signed-upload service), or `null` when the
/// trainer has no photo (the card renders an initials placeholder).
model Trainer {
  id           String        @id @default(cuid())
  gymId        String
  name         String
  headline     String        @default("")
  bio          String        @default("")
  photoUrl     String?
  specialties  String[]      @default([])
  /// The trainer's weekly recurring availability (T5.11): a JSON map keyed by
  /// lowercase weekday (`mon`…`sun`) to `{ available, windows: [{ start, close }] }`,
  /// where `windows` is an ordered, non-overlapping list of `HH:MM` time ranges the
  /// trainer can teach/coach that day (split shifts allowed). Managed from the staff
  /// console via the dedicated `/admin/trainers/:id/availability` endpoint and
  /// validated by `weeklyAvailabilitySchema` in `@fit/types`. Defaults to `{}`, which
  /// the schema fills to a fully-unavailable seven-day week until staff set hours.
  availability Json          @default("{}")
  status       TrainerStatus @default(ACTIVE)
  /// Denormalised aggregate of the trainer's `VISIBLE` reviews (T5.12), kept in
  /// step by {@link Review} writes: `rating` is the average star rating (0 when
  /// the trainer has no visible reviews) and `reviewCount` the number of them. The
  /// reviews service recomputes both inside the transaction that posts or hides a
  /// review, so trainer cards / the detail page can render the live rating without
  /// a COUNT/AVG join — the same denormalisation `ClassInstance.bookedCount` uses.
  rating       Float         @default(0)
  reviewCount  Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  reviews        Review[]

  @@index([gymId])
  @@map("trainers")
}

/// A physical location (branch) a gym curates from the staff console (T4.5). A
/// gym-scoped content record — name, address, phone, photo, amenities, and weekly
/// opening hours — the gym manages for its public locations listing (the purchase
/// wizard's first step, T3.8). One gym can have many locations; `gymId` is the
/// isolating tenant key the scoped Prisma client constrains every query to.
/// `photoUrl` is the public URL of a photo uploaded to R2 (see the storage
/// signed-upload service), or `null` when the branch has no photo. `amenities` is
/// a flat list of short labels (rendered as chips); `hours` is a JSON map keyed by
/// lowercase weekday (`mon`…`sun`) to `{ closed, open, close }`, the editable
/// source the public denormalised `hours` display string is projected from.
model Location {
  id        String         @id @default(cuid())
  gymId     String
  name      String
  address   String         @default("")
  phone     String?
  photoUrl  String?
  amenities String[]       @default([])
  hours     Json           @default("{}")
  status    LocationStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  gym            Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classTemplates ClassTemplate[]
  orders         Order[]

  @@index([gymId])
  @@map("locations")
}

/// A retail product a gym curates and sells from the staff console (T4.6). A
/// gym-scoped content record — name, description, base price, an ordered image
/// gallery, and a set of purchasable variants — the gym manages for its store.
/// One gym can have many products; `gymId` is the isolating tenant key the scoped
/// Prisma client constrains every query to. `priceAmount` is the base price in the
/// currency's MINOR units (e.g. cents/tetri) so no float rounding crosses the wire,
/// with `currency` an ISO-4217 code; a variant may override it. `images` is a flat,
/// ordered list of public R2 URLs (the first is the primary/thumbnail), each
/// uploaded via the storage signed-upload service. `variants` is a JSON array of
/// `{ name, sku, priceAmount, stock }` objects — the editable source for the
/// product's purchasable options, validated by `productVariantsSchema`.
model Product {
  id          String        @id @default(cuid())
  gymId       String
  name        String
  description String        @default("")
  priceAmount Int           @default(0)
  currency    String        @default("USD")
  images      String[]      @default([])
  variants    Json          @default("[]")
  status      ProductStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("products")
}

/// A personal-training package plan a gym curates from the staff console (T4.11).
/// A gym-scoped catalogue record — the purchasable PT offerings (e.g. "10
/// sessions", "Monthly unlimited") the gym sells, deliberately distinct from a
/// retail {@link Product}. One gym can have many plans; `gymId` is the isolating
/// tenant key the scoped Prisma client constrains every query to.
///
/// `priceAmount` is the price in the currency's MINOR units (cents/tetri), with
/// `currency` an ISO-4217 code. `billingInterval` is the billing cadence
/// (`MONTH`/`YEAR` recurring, `ONE_TIME` one-off). `sessionCount` is the number of
/// PT sessions the plan grants, or `null` for unlimited access. `features` is a
/// flat, ordered list of short perk labels rendered as bullets. `popular` flags
/// the one plan that gets the brand emphasis / "Most popular" badge.
model PackagePlan {
  id              String                 @id @default(cuid())
  gymId           String
  name            String
  description     String                 @default("")
  priceAmount     Int                    @default(0)
  currency        String                 @default("USD")
  billingInterval PackageBillingInterval @default(MONTH)
  sessionCount    Int?
  features        String[]               @default([])
  popular         Boolean                @default(false)
  status          PackagePlanStatus      @default(ACTIVE)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  gym    Gym     @relation(fields: [gymId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([gymId])
  @@map("package_plans")
}

/// A recurring class definition a gym curates from the scheduling console (T5.2).
/// The template is the *rule*, not the occurrences: `rrule` is an RFC-5545 RRULE
/// string (e.g. `FREQ=WEEKLY;BYDAY=MO,WE,FR`) the instance-generation job (T5.3)
/// expands into concrete {@link ClassInstance} rows between `validFrom` and an
/// optional `validUntil` (null = open-ended). `capacity` is the default seat
/// count per occurrence (an instance may override it via `capacityOverride`);
/// `durationMinutes` fixes each occurrence's length, so an instance's `endsAt`
/// is `startsAt + durationMinutes`. `trainerId`/`locationId` are the default
/// trainer/branch — nullable, and set to null if the referenced trainer/location
/// is removed, so the template survives; `room` is free-text sub-location within
/// the branch. `color` is the calendar display colour. One gym can have many
/// templates; `gymId` is the isolating tenant key the scoped Prisma client
/// constrains every query to. The 500-char ceiling on `rrule` is enforced at the
/// DB level (see the migration's `rrule_max_len` check constraint), not in this
/// schema — Prisma cannot express a check constraint.
model ClassTemplate {
  id              String              @id @default(cuid())
  gymId           String
  title           String
  description     String              @default("")
  category        String              @default("")
  trainerId       String?
  locationId      String?
  room            String?
  capacity        Int
  durationMinutes Int
  rrule           String
  color           String              @default("#2563eb")
  status          ClassTemplateStatus @default(ACTIVE)
  validFrom       DateTime
  validUntil      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  gym       Gym             @relation(fields: [gymId], references: [id], onDelete: Cascade)
  trainer   Trainer?        @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  instances ClassInstance[]

  @@index([gymId])
  @@index([trainerId])
  @@index([locationId])
  @@map("class_templates")
}

/// A single materialised occurrence of a {@link ClassTemplate} (T5.1). The
/// instance-generation job (T5.3) expands a template's `rrule` into these rows,
/// one per occurrence in the valid window. `startsAt`/`endsAt` are the resolved
/// instants; `capacityOverride` (nullable) overrides the template's `capacity`
/// for this occurrence only; `bookedCount` is a denormalised counter the booking
/// flow (T5.4) bumps atomically alongside each {@link Booking} write — never
/// derived via COUNT(*) at query time — so a card can render remaining spots
/// without a join. `detachedAt` marks an occurrence that was edited away from its
/// template (T5.8) so a later regeneration leaves it untouched. `gymId` is
/// duplicated from the template for direct tenant-scoped, time-ranged calendar
/// queries served by the `(gymId, startsAt)` index.
model ClassInstance {
  id               String         @id @default(cuid())
  gymId            String
  templateId       String
  startsAt         DateTime
  endsAt           DateTime
  capacityOverride Int?
  bookedCount      Int            @default(0)
  status           InstanceStatus @default(SCHEDULED)
  detachedAt       DateTime?
  createdAt        DateTime       @default(now())

  gym      Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  template ClassTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@index([gymId, startsAt])
  @@index([templateId])
  @@map("class_instances")
}

/// A member's reservation against a {@link ClassInstance} (T5.1). `status` tracks
/// the lifecycle (booked → attended/no-show, waitlisted → booked when a seat
/// frees, or canceled); `waitlistPosition` orders the queue while `WAITLIST`.
/// `idempotencyKey` is unique so a retried booking request can't create a second
/// row. A member holds at most one non-canceled booking per occurrence: the
/// partial unique index `(classInstanceId, memberId) WHERE status != 'CANCELED'`
/// — added in the migration SQL, as Prisma can't express a partial index —
/// enforces it while still allowing a re-book after cancelling. `memberId`
/// references the gym-scoped {@link GymMember}, matching this row's `gymId`. The
/// booking *logic* (and the atomic `bookedCount` bump on insert) lands in T5.4;
/// this is schema only.
model Booking {
  id               String        @id @default(cuid())
  gymId            String
  classInstanceId  String
  memberId         String
  status           BookingStatus @default(BOOKED)
  waitlistPosition Int?
  idempotencyKey   String        @unique
  createdAt        DateTime      @default(now())

  gym           Gym           @relation(fields: [gymId], references: [id], onDelete: Cascade)
  classInstance ClassInstance @relation(fields: [classInstanceId], references: [id], onDelete: Cascade)
  member        GymMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([classInstanceId, status])
  @@index([gymId])
  @@index([memberId])
  @@map("bookings")
}

/// A member's star rating (1–5) + optional written review of a class occurrence
/// and the trainer who led it (T5.12). A review may only be posted by a member
/// who *attended* the occurrence — the service asserts an `ATTENDED`
/// {@link Booking} for the same `(memberId, classInstanceId)` before accepting —
/// and at most once per occurrence: the unique `(memberId, classInstanceId)`
/// makes a second submission a `409`. `trainerId` is denormalised from the
/// occurrence's template at write time so a trainer's reviews can be listed
/// without walking instance→template, and is `SetNull` (the review survives the
/// trainer / occurrence being deleted, like the audit trail). `status` is the
/// soft-moderation flag a manager flips to `HIDDEN`; only `VISIBLE` rows feed the
/// trainer's aggregate `rating`. `gymId` is the isolating tenant key the scoped
/// Prisma client constrains every query to.
model Review {
  id              String       @id @default(cuid())
  gymId           String
  memberId        String
  trainerId       String?
  classInstanceId String?
  rating          Int
  comment         String?
  status          ReviewStatus @default(VISIBLE)
  createdAt       DateTime     @default(now())

  gym           Gym            @relation(fields: [gymId], references: [id], onDelete: Cascade)
  member        GymMember      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  trainer       Trainer?       @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  classInstance ClassInstance? @relation(fields: [classInstanceId], references: [id], onDelete: SetNull)

  @@unique([memberId, classInstanceId])
  @@index([gymId])
  @@index([trainerId, status])
  @@map("reviews")
}

/// Rotating refresh-token record for session management. Tokens are persisted
/// hashed (never plaintext); `familyId` groups a rotation lineage so a reused
/// (already-rotated) token can be detected and the whole family revoked.
model RefreshToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  deviceFingerprint String?
  familyId          String
  revokedAt         DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A pending invitation for someone to join a gym's staff (T4.7). Created from the
/// staff console (`POST /staff/invite`), it carries the address invited, the
/// {@link Role} they will hold once they accept, and a single-use `token` the
/// emailed accept link (`GET /auth/accept-invite`) resolves. `expiresAt` bounds
/// the link's life (7 days); `usedAt` is stamped when the invite is redeemed —
/// after which it can never be redeemed again (single-use). A revoked invite is
/// simply deleted. `email` is stored normalised (lower-case) so an invite matches
/// the address regardless of the casing it was typed in. Distinct from a
/// {@link GymMember}, which is the membership the redemption actually creates.
model StaffInvite {
  id        String    @id @default(cuid())
  gymId     String
  email     String
  role      Role
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  gym Gym @relation(fields: [gymId], references: [id], onDelete: Cascade)

  @@index([gymId])
  @@map("staff_invites")
}

/// A storefront purchase (T7.1) — the order the public purchase wizard's final
/// step (T3.10) creates and the success page reads back. `gymId` is the isolating
/// tenant key the scoped Prisma client constrains every query to. An order is
/// raised for the package chosen in the wizard: `packageId` references the
/// {@link PackagePlan} and `locationId` the {@link Location} branch (both nullable
/// and `SetNull` so the order — an accounting record — survives the catalogue
/// entry being deleted). The buyer is either a signed-in {@link GymMember}
/// (`memberId`, `SetNull` so the order outlives the membership) or a guest, whose
/// contact details land in `customerName` / `customerEmail` (email normalised
/// lower-case, matching auth) — exactly one identifies who the order is for.
/// `total` is the order total in the currency's MINOR units (cents/tetri) so no
/// float rounding crosses the wire, with `currency` an ISO-4217 code; it is a
/// denormalised sum of the {@link OrderItem} lines, kept in step at write time so
/// the confirmation renders without re-aggregating. `status` tracks the lifecycle
/// (see {@link OrderStatus}); payment is captured via the related {@link Payment}.
model Order {
  id            String      @id @default(cuid())
  gymId         String
  packageId     String?
  locationId    String?
  memberId      String?
  /// Guest buyer's name (step 3 of the wizard); null for a signed-in member.
  customerName  String?
  /// Guest buyer's email, normalised lower-case so guest checkout and a later
  /// sign-in resolve to the same identity; null for a signed-in member.
  customerEmail String?
  total         Int         @default(0)
  currency      String      @default("USD")
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  gym      Gym          @relation(fields: [gymId], references: [id], onDelete: Cascade)
  package  PackagePlan? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  location Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  member   GymMember?   @relation(fields: [memberId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payment  Payment?

  @@index([gymId])
  @@index([memberId])
  @@index([packageId])
  @@map("orders")
}

/// One priced line on an {@link Order} (T7.1) — the purchased package, plus any
/// discount / fee adjustments the API itemises. `label` is the human-readable
/// description and `amount` the line value in the order currency's MINOR units
/// (negative for a discount) so the success page can render a breakdown that sums
/// to the order's `total` without re-deriving it. Lines cascade-delete with their
/// order; this row carries no `gymId` of its own — it is reached only through the
/// already tenant-scoped order.
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  label     String
  amount    Int
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

/// A payment attempt against an {@link Order} (T7.1). One payment per order (the
/// unique `orderId` makes it a one-to-one), capturing the money for the purchase.
/// `amount` is in the currency's MINOR units (cents/tetri) with `currency` an
/// ISO-4217 code, mirroring the order's total at capture time. `provider` is the
/// payment provider key — `"stub"` for the MVP, whose stubbed flow returns a
/// redirect the wizard treats as "captured" (see `@fit/types` orders); the real
/// provider integration (T8.8) sets a concrete key and a `providerRef` (the
/// external charge / transaction id used for reconciliation and refunds).
/// `status` tracks the charge lifecycle (see {@link PaymentStatus}). `gymId` is
/// duplicated from the order for direct tenant-scoped revenue queries.
model Payment {
  id          String        @id @default(cuid())
  gymId       String
  orderId     String        @unique
  amount      Int
  currency    String        @default("USD")
  status      PaymentStatus @default(PENDING)
  /// How the sale was settled — the staff-facing channel the end-of-day cash
  /// reconciliation (T7.5) groups by. Defaults to `CARD` so the online purchase
  /// wizard's stub charge (T3.10) lands as a card sale without passing it; the POS
  /// (T7.3) sets it explicitly to the operator's choice.
  method      PaymentMethod @default(CARD)
  /// Payment provider key — `"stub"` for the MVP, a concrete provider once T8.8
  /// lands the real integration.
  provider    String        @default("stub")
  /// External charge / transaction id from the provider, for reconciliation and
  /// refunds; null for the stub (no upstream record).
  providerRef String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  gym   Gym   @relation(fields: [gymId], references: [id], onDelete: Cascade)
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([gymId])
  /// Backs the end-of-day reconciliation (T7.5): a tenant's captured payments
  /// scanned by `createdAt` window, then grouped by `method`.
  @@index([gymId, createdAt])
  @@map("payments")
}

/// Append-only record of privileged platform actions, written by the SuperAdmin
/// console (T2.12). The first use is owner impersonation: every impersonation
/// must leave exactly one row naming the actor (the SUPER_ADMIN) and the target
/// gym + impersonated user, so support access is always accountable after the
/// fact. Deliberately denormalised scalar ids (no FKs) so an audit entry
/// survives the deletion of whatever it references — the trail must outlive the
/// records it describes. `metadata` carries action-specific context as JSON.
model AuditLog {
  id        String   @id @default(cuid())
  /// Action key, e.g. `gym.impersonate` or `gym.status.update`.
  action    String
  /// The user who performed the action (the SUPER_ADMIN operator).
  actorId   String
  /// The gym the action targeted, when applicable.
  gymId     String?
  /// The user the action targeted (e.g. the impersonated owner), when applicable.
  targetId  String?
  /// Action-specific context (previous/next status, issued-token TTL, …).
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([gymId])
  @@index([createdAt])
  @@map("audit_logs")
}
