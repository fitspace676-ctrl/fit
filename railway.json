{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "corepack pnpm --filter @fit/db exec prisma generate"
  },
  "deploy": {
    "startCommand": "corepack pnpm --filter @fit/db exec prisma migrate deploy && corepack pnpm --filter @fit/api exec tsx src/main.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
