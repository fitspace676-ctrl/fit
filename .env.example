# Repo-level environment — copy to `.env.local` and fill in. Both are gitignored.
#
# These mirror the values consumed by individual packages/apps. Each package
# also ships its own `.env.example` for package-scoped tooling (e.g. Prisma in
# packages/db). Keep this file as the single source of truth for shared infra.

# ── Database (Postgres) ──────────────────────────────────────────────────────
# Production: Railway Postgres public proxy URL (DATABASE_PUBLIC_URL).
# Local dev:  the docker-compose Postgres service (see README → Local dev).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit?schema=public"

# ── Cache / queue (Redis) ────────────────────────────────────────────────────
# Production: Railway Redis public proxy URL (REDIS_PUBLIC_URL).
# Local dev:  the docker-compose Redis service.
REDIS_URL="redis://localhost:6379"

# ── CORS (allowed browser origins for the API) ───────────────────────────────
# WEB_URL and ADMIN_URL are echoed into the API's CORS allow-list; CORS_ORIGINS
# is an optional comma-separated list of extra origins. Expo dev (localhost:8081)
# is always allowed.
# WEB_URL="http://localhost:3000"
# ADMIN_URL="http://localhost:3001"
# CORS_ORIGINS=""                    # extra origins, comma-separated

# ── Public origins (deep links) ──────────────────────────────────────────────
# The API's own public base URL, used to build the staff-invite accept link
# (`<API_PUBLIC_URL>/auth/accept-invite?token=…`). Default: the local dev API.
# API_PUBLIC_URL="http://localhost:3000"

# ── Multi-tenancy (subdomain resolution) ─────────────────────────────────────
# Root domain that gym subdomains (`<slug>.fit.ge`) are served on. The subdomain
# tenant middleware strips this suffix off the request Host to recover the slug.
# Use "localhost" in dev (`downtown.localhost:3001` resolves automatically in
# Chrome). See docs/subdomain-routing.md for DNS / Vercel setup.
# PLATFORM_ROOT_DOMAIN="fit.ge"
#
# The Next.js apps (web/admin/platform) need the same root domain client-side to
# derive the active gym from the browser Host and to scope a credentials sign-in
# to the subdomain's gym. Mirror PLATFORM_ROOT_DOMAIN here.
# NEXT_PUBLIC_ROOT_DOMAIN="fit.ge"

# ── Auth / sessions ──────────────────────────────────────────────────────────
# HS256 secret the API signs session JWTs with. The `fit` CLI reuses it so its
# test tokens authenticate against the API. Unset → token issuance returns 503.
# JWT_SECRET=""                      # generate with: openssl rand -hex 32
# JWT_ISSUER="fit"                   # `iss` claim stamped on issued tokens
# JWT_ACCESS_TTL="900"               # access-token lifetime in seconds (default 15m)
# JWT_REFRESH_TTL="2592000"          # refresh-token lifetime in seconds (default 30d)
# JWT_IMPERSONATION_TTL="600"        # SuperAdmin owner-impersonation token lifetime (default 10m)

# ── Google OAuth (Sign in with Google) ───────────────────────────────────────
# Comma-separated list of accepted Google OAuth client IDs — an inbound ID
# token's `aud` claim must match one. Typically the web, iOS, and Android client
# IDs from the Google Cloud console. Unset → POST /auth/google returns 503.
# GOOGLE_CLIENT_IDS=""               # e.g. "WEB_ID.apps.googleusercontent.com,IOS_ID.apps.googleusercontent.com"

# ── Apple OAuth (Sign in with Apple) ─────────────────────────────────────────
# Comma-separated list of accepted Apple client IDs — an inbound ID token's
# `aud` claim must match one. Holds the web Services ID and the native app's
# bundle ID. Unset → POST /auth/apple returns 503.
# APPLE_CLIENT_IDS=""                # e.g. "com.fit.app.web,com.fit.app"

# ── Email verification + delivery (Resend) ───────────────────────────────────
# EMAIL_VERIFICATION_TTL="86400"     # verification-token TTL in seconds (default 24h)
# EMAIL_VERIFICATION_URL=""          # deep-link base; unset → <WEB_URL>/auth/verify
# RESEND_API_KEY=""                  # unset → verification link is logged, not sent
# EMAIL_FROM="Fit <no-reply@fit.app>"  # verified Resend sender for transactional mail
# PLATFORM_LEADS_EMAIL=""            # sales inbox for marketing trial/demo leads; unset → notification skipped (lead still stored)

# ── Push delivery (Expo — optional) ──────────────────────────────────────────
# EXPO_PUSH_ENABLED="false"          # master switch; unless "true" push is a logged no-op (dev/CI/preview) — set true in production
# EXPO_ACCESS_TOKEN=""               # only needed for Expo accounts with enhanced security; sent as Authorization: Bearer

# ── Scheduled report digests (T4.10) ─────────────────────────────────────────
# Weekly/monthly operational report emails to each gym's owner/manager. Off by
# default so the cron never fires in dev / CI / preview; set true in production.
# A Redis lock guards each send, so it is safe to enable on every replica.
# REPORT_DIGEST_ENABLED="false"      # "true" enables the weekly/monthly digest cron

# ── Recurring subscription billing + dunning (T5.4 / T5.5) ───────────────────
# Daily cron that charges due subscriptions and advances their billing period.
# Off by default so it never charges in dev / CI / preview; set true in
# production. A Redis lock guards each daily window, so it is safe on every replica.
# SUBSCRIPTION_BILLING_ENABLED="false"          # "true" enables the daily renewal cron
# Dunning retry ladder: ascending whole-day offsets from the elapsed period end at
# which a failed renewal charge is retried; after the last rung fails the sub expires
# (so the final offset is the grace window). Empty disables retries (expire on first fail).
# SUBSCRIPTION_BILLING_RETRY_OFFSET_DAYS="2,5,7"  # retry on day +2, +5, +7 then expire
# Trial-ending heads-up (T8.7): whole days before a free trial converts that the
# member is warned their first charge is coming. The daily sweep warns each trial
# once (per-subscription dedupe key). Bounded to 30.
# SUBSCRIPTION_TRIAL_ENDING_LEAD_DAYS="3"        # warn 3 days before a trial converts

# ── Class booking reminders (T8.6) ───────────────────────────────────────────
# Cron that reminds members ahead of a class they hold a confirmed seat for,
# over their preferred channels. Off by default so it never notifies in dev / CI
# / preview; set true in production. A Redis lock guards each tick, so it is safe
# on every replica; a per-booking dedupe key is the at-most-once backstop.
# BOOKING_REMINDERS_ENABLED="false"      # "true" enables the booking-reminder cron
# BOOKING_REMINDER_LEAD_MINUTES="120"    # how long before class the reminder fires (default 2h)

# ── Ops notifications (T8.8) ─────────────────────────────────────────────────
# Owner/manager alerts: a daily low-stock reorder digest and an end-of-day
# summary email (takings, orders, check-ins, new members). Both off by default so
# the crons never mail in dev / CI / preview; set true in production. A Redis lock
# guards each daily window, so both are safe to enable on every replica.
# OPS_LOW_STOCK_DIGEST_ENABLED="false"   # "true" enables the daily low-stock digest cron
# OPS_LOW_STOCK_THRESHOLD="5"            # on-hand ceiling a variant must be at/below to alert (0–1000)
# OPS_DAILY_SUMMARY_ENABLED="false"      # "true" enables the end-of-day summary cron

# ── Password reset ───────────────────────────────────────────────────────────
# PASSWORD_RESET_TTL="3600"          # reset-token TTL in seconds (default 1h)
# PASSWORD_RESET_URL=""              # deep-link base; unset → <WEB_URL>/auth/reset-password

# ── Staff invitations (T4.7) ─────────────────────────────────────────────────
# STAFF_INVITE_TTL="604800"          # staff-invite token TTL in seconds (default 7d)

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL="info"                   # trace | debug | info | warn | error | fatal

# ── Sentry (optional — unset disables Sentry entirely) ───────────────────────
# SENTRY_DSN=""                      # project DSN; unset → Sentry disabled
# SENTRY_ENVIRONMENT=""              # e.g. production | staging | development
# SENTRY_RELEASE=""                  # release identifier (e.g. git SHA)
# SENTRY_TRACES_SAMPLE_RATE="0.1"    # 0..1 performance trace sample rate

# ── Object storage (Cloudflare R2 — S3-compatible) ───────────────────────────
# Create a bucket + an R2 API token (Object Read & Write) in the Cloudflare
# dashboard. The API uses these to mint short-lived presigned upload URLs.
# Leave unset to disable uploads — POST /uploads then returns 503.
# R2_ACCOUNT_ID=""                 # Cloudflare account id (R2 endpoint host)
# R2_ACCESS_KEY_ID=""              # R2 API token access key id
# R2_SECRET_ACCESS_KEY=""          # R2 API token secret access key
# R2_BUCKET=""                     # bucket name
# R2_PUBLIC_URL=""                 # public base URL (custom domain or *.r2.dev)
# R2_SIGNED_URL_TTL="300"          # presigned URL lifetime in seconds (default 300, max 604800)
# R2_MAX_UPLOAD_BYTES="26214400"   # max presigned upload size in bytes (default 25 MiB)
# Object key convention: {gymId}/{entity}/{uuid}{ext} — gymId isolates tenants.
