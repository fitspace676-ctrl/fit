# @fit/web — copy to `.env.local` (gitignored) for local development.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle; never put secrets here.

# Base URL of the @fit/api backend.
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Platform root domain — the member site is served at `<slug>.<root>`. Used to
# derive the active gym from the request Host and to scope a credentials sign-in
# to the subdomain's gym. Use "localhost" in dev (`downtown.localhost:3001`).
# Unset → no tenant in scope (apex / preview URL renders generically).
# NEXT_PUBLIC_ROOT_DOMAIN="fit.ge"

# Shared HS256 signing secret — MUST match the @fit/api `JWT_SECRET`. Used by the
# Next.js middleware + getServerSession() to verify the `accessToken` cookie.
# Server-only (NOT NEXT_PUBLIC) — never exposed to the browser. Unset → the auth
# gate fails closed and only public routes (/, /login) render.
# JWT_SECRET="change-me-in-prod"

# Optional parent domain for the auth cookie so the session is shared across and
# cleared from every tenant subdomain (e.g. ".fit.ge"). Unset → host-only cookie
# (correct for localhost). NEXT_PUBLIC_* because the cookie is written client-side.
# NEXT_PUBLIC_COOKIE_DOMAIN=".fit.ge"
# Server-only override the /api/session route uses when writing the httpOnly
# session cookies (falls back to NEXT_PUBLIC_COOKIE_DOMAIN when unset).
# COOKIE_DOMAIN=".fit.ge"

# Google OAuth web client id (Sign in with Google). Unset → the login page shows
# a "not configured" notice instead of the Google button. Must be one of the
# API's GOOGLE_CLIENT_IDS so the ID token's audience is accepted.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="WEB_ID.apps.googleusercontent.com"

# Sign in with Apple (web). The Services ID and its configured Return URL. Both
# must be set for the Apple button to render (otherwise a "not configured" notice
# shows). The Services ID must be one of the API's APPLE_CLIENT_IDS.
# NEXT_PUBLIC_APPLE_CLIENT_ID="com.fit.app.web"
# NEXT_PUBLIC_APPLE_REDIRECT_URI="https://app.fit.app/login"

# Sentry (optional — unset disables error reporting).
# NEXT_PUBLIC_SENTRY_DSN=""          # browser DSN (client errors); inlined into the bundle
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""  # e.g. production | preview | development
# SENTRY_DSN=""                      # server/edge DSN (SSR + route handlers)
# SENTRY_ENVIRONMENT=""              # server-side environment label
