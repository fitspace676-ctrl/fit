# @fit/platform — copy to `.env.local` (gitignored) for local development.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle; never put secrets here.

# Base URL of the @fit/api backend (powers the owner-signup / register-gym flow).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Platform root domain — used to build the `<slug>.<root>/admin` URL a new owner
# is redirected to after signup. Use "localhost" in dev. Unset → the signup flow
# shows an in-app confirmation instead of linking to the tenant console.
# NEXT_PUBLIC_ROOT_DOMAIN="fit.ge"

# Sentry (optional — unset disables error reporting).
# NEXT_PUBLIC_SENTRY_DSN=""          # browser DSN (client errors); inlined into the bundle
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""  # e.g. production | preview | development
# SENTRY_DSN=""                      # server/edge DSN (SSR + route handlers)
# SENTRY_ENVIRONMENT=""              # server-side environment label
