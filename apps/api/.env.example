# @fit/api — copy to `.env.local` (gitignored) for local development.
#
# Shared infra vars (DATABASE_URL, REDIS_URL) are documented at the repo root
# `.env.example`; the API reads them from the process environment.

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT="3000"

# ── Datastores ───────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fit?schema=public"
REDIS_URL="redis://localhost:6379"

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed browser origins. http://localhost:8081 (Expo) is always allowed.
WEB_URL="http://localhost:3001"
ADMIN_URL="http://localhost:3002"
# Optional extra comma-separated origins.
# CORS_ORIGINS=""

# ── Auth / sessions ──────────────────────────────────────────────────────────
# HS256 secret used to sign session JWTs. Unset → GET /auth/verify returns 503.
# JWT_SECRET=""                      # generate with: openssl rand -hex 32
# JWT_ISSUER="fit"
# JWT_ACCESS_TTL="900"               # access-token lifetime in seconds (default 15m)
# JWT_REFRESH_TTL="2592000"          # refresh-token lifetime in seconds (default 30d)

# ── Email verification + delivery (Resend — optional) ────────────────────────
# EMAIL_VERIFICATION_TTL="86400"     # verification-token TTL in seconds (default 24h)
# EMAIL_VERIFICATION_URL=""          # deep-link base; unset → <WEB_URL>/member/verify
# RESEND_API_KEY=""                  # unset → verification link is logged, not sent
# EMAIL_FROM="Fit <no-reply@fit.app>"
# PLATFORM_LEADS_EMAIL=""            # sales inbox for marketing trial/demo leads; unset → notification skipped (lead still stored)

# ── Push delivery (Expo — optional) ──────────────────────────────────────────
# EXPO_PUSH_ENABLED="false"          # master switch; unless "true" push is a logged no-op (dev/CI/preview) — set true in production
# EXPO_ACCESS_TOKEN=""               # only needed for Expo accounts with enhanced security; sent as Authorization: Bearer

# ── Object storage (Cloudflare R2 — optional; unset disables POST /uploads) ──
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# R2_PUBLIC_URL=""
# R2_SIGNED_URL_TTL="900"
# Local dev: use the `fit-media-dev` bucket, and make sure the API token is
# scoped to it — a token for another bucket fails the PUT with a bare
# AccessDenied. See root .env.example for the full setup.

# ── Media sweep (nightly cleanup of unreferenced R2 objects — see root .env.example) ──
# MEDIA_SWEEP_ENABLED="false"        # "true" enables the 03:30 job (production only)
# MEDIA_SWEEP_DRY_RUN="true"         # default true — reports orphans without deleting
# MEDIA_SWEEP_GRACE_HOURS="24"       # spare objects younger than this

# ── Logging ──────────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal (defaults: debug in dev, info in prod)
# LOG_LEVEL="info"

# ── Sentry (optional — left unset disables Sentry entirely) ──────────────────
# SENTRY_DSN=""
# SENTRY_ENVIRONMENT="development"
# SENTRY_RELEASE=""
# SENTRY_TRACES_SAMPLE_RATE="0.1"
