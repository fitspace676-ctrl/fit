# @fit/superadmin — copy to `.env.local` (gitignored) for local development.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle; never put secrets here.

# Base URL of the @fit/api backend (SuperAdmin endpoints use @AllowCrossTenant).
NEXT_PUBLIC_API_URL="http://localhost:3000"

# Shared HS256 signing secret — MUST match the @fit/api `JWT_SECRET`. Used by the
# Next.js middleware + getServerSession() to verify the `accessToken` cookie and
# assert the SUPER_ADMIN role. Server-only (NOT NEXT_PUBLIC). Unset → the auth
# gate fails closed and every route redirects to /403.
# JWT_SECRET="change-me-in-prod"

# Optional parent domain for the auth cookie so a SUPER_ADMIN session set on the
# main app is readable on the operator host (e.g. ".fit.ge"). Unset → host-only.
# NEXT_PUBLIC_COOKIE_DOMAIN=".fit.ge"

# Sentry (optional — unset disables error reporting).
# NEXT_PUBLIC_SENTRY_DSN=""          # browser DSN (client errors); inlined into the bundle
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=""  # e.g. production | preview | development
# SENTRY_DSN=""                      # server/edge DSN (SSR + route handlers)
# SENTRY_ENVIRONMENT=""              # server-side environment label
