# @fit/mobile — copy to `.env.local` (gitignored) for local development.
#
# EXPO_PUBLIC_* vars are inlined into the app bundle; never put secrets here.

# Base URL of the @fit/api backend. Use your machine's LAN IP (not localhost)
# when testing on a physical device so the device can reach the API.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Sentry (optional — unset disables error reporting). Full native capture needs
# an EAS build with the @sentry/react-native Expo plugin (configured in app.json).
# EXPO_PUBLIC_SENTRY_DSN=""          # mobile DSN; inlined into the app bundle
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=""  # e.g. production | preview | development
