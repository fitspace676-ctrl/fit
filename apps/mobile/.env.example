# @fit/mobile — copy to `.env.local` (gitignored) for local development.
#
# EXPO_PUBLIC_* vars are inlined into the app bundle; never put secrets here.

# Base URL of the @fit/api backend. Use your machine's LAN IP (not localhost)
# when testing on a physical device so the device can reach the API.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Google OAuth client ids (Sign in with Google). Create per-platform OAuth
# clients in the Google Cloud console; each id must also be listed in the API's
# GOOGLE_CLIENT_IDS so the ID token's audience is accepted. Unset → the login
# screen shows a "not configured" notice.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="WEB_ID.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="IOS_ID.apps.googleusercontent.com"
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID="ANDROID_ID.apps.googleusercontent.com"

# Sign in with Apple needs no EXPO_PUBLIC_* config: the native flow
# (expo-apple-authentication) uses the app's own bundle id as the audience, which
# must be listed in the API's APPLE_CLIENT_IDS. The button only renders on iOS
# 13+ (AppleAuthentication.isAvailableAsync); requires the expo-apple-authentication
# plugin + `usesAppleSignIn` entitlement in an EAS build.

# Sentry (optional — unset disables error reporting). Full native capture needs
# an EAS build with the @sentry/react-native Expo plugin (configured in app.json).
# EXPO_PUBLIC_SENTRY_DSN=""          # mobile DSN; inlined into the app bundle
# EXPO_PUBLIC_SENTRY_ENVIRONMENT=""  # e.g. production | preview | development
