{
  "name": "@fit/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo '[@fit/mobile] build: native artifacts are produced by EAS, not turbo — see eas.json'",
    "build:preview": "eas build --profile preview --platform all",
    "prebuild": "expo prebuild",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests",
    "test:rn": "jest --passWithNoTests",
    "test:watch": "vitest",
    "test:smoke": "maestro test .maestro",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fit/env": "workspace:*",
    "@fit/i18n": "workspace:*",
    "@fit/types": "workspace:*",
    "@fit/ui-mobile": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "^8.13.0",
    "@tanstack/react-query": "^5.101.0",
    "expo": "^56.0.0",
    "expo-apple-authentication": "~56.0.4",
    "expo-auth-session": "~56.0.13",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-font": "~56.0.5",
    "expo-linking": "~56.0.13",
    "expo-notifications": "~56.0.16",
    "expo-router": "~56.2.8",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.15",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-css-interop": "0.2.4",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-sse": "^1.2.1",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@fit/config": "workspace:*",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.14",
    "babel-preset-expo": "~56.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
