{
  // Expo's base provides the React Native lib/jsx/module-resolution settings the
  // app needs, so we can't extend the bundler-targeted `@fit/config` base
  // directly — instead we mirror its *strictness* flags here so mobile gets the
  // same type-safety guarantees as every other workspace (T1.2).
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "dist", "build", ".expo", ".turbo", "coverage"]
}
