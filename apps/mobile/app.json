{
  "expo": {
    "name": "Fit",
    "slug": "fit",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#122357"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fit.app"
    },
    "android": {
      "package": "com.fit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#122357"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      [
        "@sentry/react-native/expo",
        { "organization": "forma-0r", "project": "fit-mobile", "url": "https://de.sentry.io/" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d425affe-3cbe-46fc-82f6-6cf3beed154a"
      }
    },
    "owner": "formacore"
  }
}
