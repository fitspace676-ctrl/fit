{
  "expo": {
    "name": "FormaCore",
    "slug": "fit",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fit",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#131312",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fit.app",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.fit.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131312"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-apple-authentication",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#131312"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "FormaCore uses the camera to scan QR codes at the gym. The code stays on your phone.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@sentry/react-native/expo",
        { "organization": "forma-0r", "project": "fit-mobile", "url": "https://de.sentry.io/" }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d425affe-3cbe-46fc-82f6-6cf3beed154a"
      }
    },
    "owner": "formacore"
  }
}
