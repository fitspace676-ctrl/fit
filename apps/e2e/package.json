{
  "name": "@fit/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "echo '[@fit/e2e] test: e2e runs via `test:e2e` (needs the stack + a browser) — skipped in the default pipeline'",
    "test:e2e": "playwright test",
    "test:e2e:web": "playwright test --config playwright.web.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@fit/config": "workspace:*",
    "@fit/db": "workspace:*",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.10.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2"
  }
}
